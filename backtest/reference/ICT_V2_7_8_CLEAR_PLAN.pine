contFvgBreakOnly   = input.bool(true, "FVG uniquement sur la bougie de cassure", group = gCont, tooltip = "Activé : la troisième bougie qui confirme le FVG doit être la même bougie M5 que celle qui clôture au-delà du pivot. Désactivé : le FVG peut aussi être confirmé sur la bougie suivante, comme dans la V2.5.8.")
contMinStopAtr     = input.float(1.00, "Distance SL minimale (ATR)", minval = 0.0, step = 0.05, group = gCont)
contTp1R           = input.float(1.50, "TP1 Continuation (R)", minval = 0.50, step = 0.25, group = gCont)
contMinRR          = input.float(2.50, "RR minimum vers prochaine liquidité", minval = 1.0, step = 0.25, group = gCont, tooltip = "Filtre : la liquidité fraîche LA PLUS PROCHE doit offrir au moins ce RR. Ne sert plus de cible — voir « Sortie complète ».")
contExitR          = input.float(2.50, "Sortie complète Continuation (R)", minval = 0.5, step = 0.25, group = gCont, tooltip = "[V2.5.8-FIX] TP2 était figé sur « RR minimum », ce qui mélangeait deux rôles : le filtre de sélection et la cible de sortie. Les deux sont maintenant réglables séparément. Mettre la même valeur reproduit exactement le comportement précédent.")
contRequirePD      = input.bool(false, "Exiger Discount (Long) / Premium (Short)", group = gCont, tooltip = "[V2.5.8-FIX] Ce filtre était codé en dur, sans possibilité de le désactiver.\n\nMESURÉ sur NAS100 M5 2005-2020 : il rejette 304 des 328 setups valides, soit 93 %, et ramène le moteur à 4 trades en quinze ans.\n\nLa cause est structurelle, pas un mauvais réglage : une continuation entre APRÈS une impulsion haussière, à l\'intérieur d\'une jambe H1 haussière dont le sommet suit le plus haut courant. L\'entrée se situe donc mécaniquement en Premium — position médiane 0,93 sur une range normalisée de 0 à 1, contre les 0,50 maximum exigés. Symétriquement 0,10 pour les Shorts.\n\nDÉSACTIVÉ par défaut. Le compteur du tableau de bord indique combien de setups ce filtre a rejetés dans la journée : active-le et regarde ce compteur avant de décider.")
contRequireLiq     = input.bool(false, "Exiger une liquidité fraîche au RR minimum", group = gCont, tooltip = "[V2.5.8-FIX] Cette règle était obligatoire. MESURÉ : elle écarte 693 des 764 setups valides, soit 91 % — bien plus que le filtre Premium/Discount.\n\nLa cause est structurelle : une journée de continuation a déjà consommé les niveaux situés devant elle. C'est précisément ce qui en fait une journée de tendance. Exiger une liquidité intacte à 2,5 R devant le prix revient à exclure le contexte que le moteur cherche.\n\nDÉSACTIVÉ par défaut. La cible devient alors « Sortie complète (R) », et le RR minimum ne sert plus qu'à filtrer quand cette option est réactivée.\n\nMESURÉ sans cette exigence, session étendue à 16:00 : 836 trades sur quinze ans au lieu de 41, PF 1,10 frais compris, et positif sur les deux moitiés de l'échantillon. L'intervalle de confiance contient encore zéro : c'est une piste à tester, pas un résultat acquis.")
contRequireFresh   = input.bool(true, "Cible : liquidité non encore traversée", group = gCont, tooltip = "[V2.5.8-FIX] La fraîcheur des cibles était codée en dur. Désactivée, le moteur accepte un niveau déjà traversé dans la journée.\n\nMESURÉ : contre-intuitivement, exiger la fraîcheur AUGMENTE le nombre de plans. Sans elle, la liquidité la plus proche est souvent trop près pour offrir le RR minimum, et le plan est refusé.")
contMaxTrades      = input.int(1, "Maximum Continuation par jour", minval = 1, maxval = 3, group = gCont)
contShowLabels     = input.bool(true, "Afficher étapes Continuation", group = gCont)

gDash = "11 · Tableau de bord"
showDash  = input.bool(true, "Afficher le tableau de bord", group = gDash)
dashPos   = input.string("Haut droite", "Position", options = ["Haut droite", "Haut gauche", "Bas droite", "Bas gauche"], group = gDash)
dashSize  = input.string("Petit", "Taille du texte", options = ["Minuscule", "Petit", "Normal"], group = gDash)
useOptionalGate = input.bool(false, "Rendre les confluences optionnelles bloquantes", group = gDash)
minOptionalConf = input.int(0, "Minimum optionnel (EMA/SMT/volume/HTF POI)", minval = 0, maxval = 4, group = gDash)
showStageLabels = input.bool(true, "Afficher les étapes Sweep/CISD/POI/GO", group = gDash)
keepStageHistory = input.bool(false, "Conserver l'historique des anciens setups", group = gDash, tooltip = "Désactivé : seules les étapes du setup le plus récent restent sur le graphique.")
stageMaxLabels = input.int(12, "Maximum d'étapes conservées", minval = 4, maxval = 100, group = gDash)
showTrade = input.bool(true, "Tracer Entrée / SL / TP", group = gDash)
lineExt   = input.int(30, "Extension lignes trade (bougies)", minval = 0, group = gDash)
cleanDisplay = input.bool(true, "Mode épuré / anti-chevauchement", group = gDash, tooltip = "Masque les textes redondants lorsqu'une autre annotation indique déjà la même information. La logique de détection et les signaux ne changent pas.")
tradeLabelGap = input.int(8, "Espacement des textes à droite (bougies)", minval = 2, maxval = 30, group = gDash, tooltip = "Décale les textes Entrée, SL et objectifs vers la droite du cours, en gardant leurs prix sur les lignes correspondantes.")
showEntryBar = input.bool(true, "Marquer la bougie exacte d'entrée", group = gDash, tooltip = "Ajoute un trait vertical sur la bougie qui déclenche l'entrée et un texte sans bulle au prix exécuté.")
entryMarkerMax = input.int(1, "Nombre de marqueurs d'entrée conservés", minval = 1, maxval = 100, group = gDash)
dashBg    = input.color(color.new(#0b1220, 8), "Fond du tableau", group = gDash, inline = "dc")
dashTxt   = input.color(color.white, "Texte du tableau", group = gDash, inline = "dc")
dashHdr   = input.color(color.new(#2962ff, 15), "Fond de l'en-tête", group = gDash)

// =============================================================================
//  FONCTION — ligne horizontale gérée (Entrée / SL / TP)
// =============================================================================
f_hline(_show, _price, _col, _txt, _style, _slot) =>
    var line  ln = na
    var label lb = na
    keep = _show and _price > 0
    int labelX = bar_index + 2 + _slot * tradeLabelGap
    int rightX = math.max(bar_index + lineExt, labelX + 2)
    if barstate.islast
        if keep
            if na(ln)
                ln := line.new(bar_index, _price, rightX, _price, xloc = xloc.bar_index, color = _col, style = _style, width = 1)
                lb := label.new(labelX, _price, _txt, style = label.style_none, color = color.new(_col, 100), textcolor = _col, size = size.small, textalign = text.align_left)
            line.set_xy1(ln, bar_index, _price)
            line.set_xy2(ln, rightX, _price)
            label.set_xy(lb, labelX, _price)
            label.set_text(lb, _txt + "  " + f_px(_price))
        else if not na(ln)
            line.delete(ln)
            label.delete(lb)
            ln := na
            lb := na
    int(na)

// Marqueur persistant de la bougie qui a réellement touché/déclenché l'entrée.
// Le trait vertical désigne la bougie ; le texte est ancré au prix d'exécution.
var array<line> entryBarLines = array.new<line>()
var array<label> entryBarLabels = array.new<label>()

f_markEntry(float _price, bool _isLong, string _route) =>
    color markerCol = _isLong ? #00a884 : #e53935
    string directionTxt = _isLong ? "LONG" : "SHORT"
    string markerTxt = (_isLong ? "▲ " : "▼ ") + directionTxt + " " + _route + " · " + f_px(_price) + " · " + str.format_time(time, "HH:mm", "America/New_York") + " NY"
    float labelY = _isLong ? low - (high - low) * 0.35 - syminfo.mintick * 3 : high + (high - low) * 0.35 + syminfo.mintick * 3
    line markerLine = line.new(bar_index, low, bar_index, high, xloc = xloc.bar_index, color = color.new(markerCol, 10), style = line.style_dotted, width = 2)
    label markerLabel = label.new(bar_index + 1, labelY, markerTxt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, color = color.new(markerCol, 100), textcolor = markerCol, size = size.small, textalign = text.align_left)
    array.push(entryBarLines, markerLine)
    array.push(entryBarLabels, markerLabel)
    while array.size(entryBarLines) > entryMarkerMax
        line.delete(array.shift(entryBarLines))
    while array.size(entryBarLabels) > entryMarkerMax
        label.delete(array.shift(entryBarLabels))
    int(na)

// Marqueur de structure (BOS / MSS) : ligne au niveau cassé + label, plafonné
var array<line>  bosLines = array.new<line>()
var array<label> bosLabs  = array.new<label>()
var array<line>  mssLines = array.new<line>()
var array<label> mssLabs  = array.new<label>()

f_structMark(_lines, _labs, _lvl, _col, _txt, _up, _max) =>
    ln = line.new(bar_index - svExt, _lvl, bar_index + svExt, _lvl, xloc = xloc.bar_index, color = _col, style = f_lineStyle(svStyle), width = svWidth)
    array.push(_lines, ln)
    if array.size(_lines) > _max
        line.delete(array.shift(_lines))
    if svLabels
        lb = label.new(bar_index + svExt, _lvl, _txt, style = label.style_none, textcolor = _col, size = f_size(svLblSize), textalign = text.align_left)
        array.push(_labs, lb)
        if array.size(_labs) > _max
            label.delete(array.shift(_labs))
    int(na)

// =============================================================================
//  HELPERS DU MOTEUR STRICT
// =============================================================================
f_coreStructure(int len) =>
    float phCore = ta.pivothigh(len, len)
    float plCore = ta.pivotlow(len, len)
    var float lastPhCore = na
    var float prevPhCore = na
    var float lastPlCore = na
    var float prevPlCore = na
    var int persistentBiasCore = 0
    var int lastPhIdCore = na
    var int lastPlIdCore = na
    var int lastPhTimeCore = na
    var int lastPlTimeCore = na
    var int brokenPhIdCore = na
    var int brokenPlIdCore = na
    var float dealingLowCore = na
    var float dealingHighCore = na
    var int dealingDirCore = 0
    var int bosSerialCore = 0
    var int rangeSourceCore = 0
    var int dealingStartTimeCore = na
    var int dealingExtremeTimeCore = na
    var float highSincePlCore = na
    var float lowSincePhCore = na
    // Inclure toutes les mèches entre l'origine et la cassure, pas uniquement
    // l'extrême de la bougie de cassure. Ces calculs s'exécutent à chaque barre.
    float pivotLegHighCore = ta.highest(high, len + 1)
    float pivotLegLowCore = ta.lowest(low, len + 1)
    highSincePlCore := not na(plCore) ? pivotLegHighCore : not na(highSincePlCore) ? math.max(highSincePlCore, high) : na
    lowSincePhCore := not na(phCore) ? pivotLegLowCore : not na(lowSincePhCore) ? math.min(lowSincePhCore, low) : na
    // Un pivot opposé peut se confirmer sur la bougie qui casse l'ancien
    // niveau : il constitue alors l'origine la plus récente, déjà confirmée.
    float bullOriginCore = not na(plCore) ? plCore : lastPlCore
    float bearOriginCore = not na(phCore) ? phCore : lastPhCore
    int bullOriginTimeCore = not na(plCore) ? time[len] : lastPlTimeCore
    int bearOriginTimeCore = not na(phCore) ? time[len] : lastPhTimeCore
    // IMPORTANT : le BOS est testé contre les swings déjà connus AVANT
    // d'enregistrer un pivot nouvellement confirmé. Sinon, un nouveau pivot
    // peut remplacer le niveau qui vient d'être cassé et masquer définitivement
    // la jambe de déplacement — cause du range H1 resté « provisoire ».
    // En Pine, id != na ne vaut pas true : tester explicitement na() pour
    // autoriser la PREMIÈRE cassure puis une seule cassure par pivot.
    bool highUnbrokenCore = not na(lastPhIdCore) and (na(brokenPhIdCore) or lastPhIdCore != brokenPhIdCore)
    bool lowUnbrokenCore = not na(lastPlIdCore) and (na(brokenPlIdCore) or lastPlIdCore != brokenPlIdCore)
    bool bullBosCore = highUnbrokenCore and not na(bullOriginCore) and not na(bullOriginTimeCore) and close > lastPhCore
    bool bearBosCore = lowUnbrokenCore and not na(bearOriginCore) and not na(bearOriginTimeCore) and close < lastPlCore
    if bullBosCore
        dealingLowCore := bullOriginCore
        dealingHighCore := nz(highSincePlCore, high)
        dealingDirCore := 1
        brokenPhIdCore := lastPhIdCore
        bosSerialCore += 1
        rangeSourceCore := 1
        dealingStartTimeCore := bullOriginTimeCore
        dealingExtremeTimeCore := time
    else if bearBosCore
        dealingLowCore := nz(lowSincePhCore, low)
        dealingHighCore := bearOriginCore
        dealingDirCore := -1
        brokenPlIdCore := lastPlIdCore
        bosSerialCore += 1
        rangeSourceCore := 1
        dealingStartTimeCore := bearOriginTimeCore
        dealingExtremeTimeCore := time

    // Les nouveaux pivots servent ensuite à confirmer HH/HL ou LH/LL.
    if not na(phCore)
        prevPhCore := lastPhCore
        lastPhCore := phCore
        lastPhIdCore := bar_index - len
        lastPhTimeCore := time[len]
    if not na(plCore)
        prevPlCore := lastPlCore
        lastPlCore := plCore
        lastPlIdCore := bar_index - len
        lastPlTimeCore := time[len]
    bool enoughCore = not na(prevPhCore) and not na(prevPlCore)
    if enoughCore and lastPhCore > prevPhCore and lastPlCore > prevPlCore
        persistentBiasCore := 1
    else if enoughCore and lastPhCore < prevPhCore and lastPlCore < prevPlCore
        persistentBiasCore := -1

    bool swingPairReadyCore = not na(lastPhCore) and not na(lastPlCore)
    bool bootstrapRangeCore = persistentBiasCore != 0 and swingPairReadyCore and (rangeSourceCore == 0 or (rangeSourceCore == 2 and dealingDirCore != persistentBiasCore))
    if not bullBosCore and not bearBosCore and bootstrapRangeCore
        dealingLowCore := math.min(lastPlCore, lastPhCore)
        dealingHighCore := math.max(lastPlCore, lastPhCore)
        dealingDirCore := persistentBiasCore
        rangeSourceCore := 2
        dealingStartTimeCore := math.min(lastPlTimeCore, lastPhTimeCore)
        dealingExtremeTimeCore := math.max(lastPlTimeCore, lastPhTimeCore)
    else if not bullBosCore and not bearBosCore and rangeSourceCore == 2 and dealingDirCore == 1 and not na(plCore)
        dealingLowCore := lastPlCore
        dealingHighCore := math.max(lastPhCore, high)
        dealingStartTimeCore := lastPlTimeCore
        dealingExtremeTimeCore := time
    else if not bullBosCore and not bearBosCore and rangeSourceCore == 2 and dealingDirCore == -1 and not na(phCore)
        dealingLowCore := math.min(lastPlCore, low)
        dealingHighCore := lastPhCore
        dealingStartTimeCore := lastPhTimeCore
        dealingExtremeTimeCore := time
    else if not bullBosCore and not bearBosCore and dealingDirCore == 1 and not na(dealingHighCore)
        if high > dealingHighCore
            dealingHighCore := high
            dealingExtremeTimeCore := time
    else if not bullBosCore and not bearBosCore and dealingDirCore == -1 and not na(dealingLowCore)
        if low < dealingLowCore
            dealingLowCore := low
            dealingExtremeTimeCore := time
    [persistentBiasCore, dealingLowCore, dealingHighCore, dealingDirCore, bosSerialCore, rangeSourceCore, dealingStartTimeCore, dealingExtremeTimeCore]

// Le décalage s'applique à CHAQUE membre du tuple dans le contexte demandé.
// Avec lookahead_on, seule la dernière bougie HTF clôturée est alors diffusée
// dès l'ouverture de la suivante, de façon identique en historique et en direct.
f_coreStructureConfirmed(int len) =>
    [b, lo, hi, d, serial, source, startTime, extremeTime] = f_coreStructure(len)
    [b[1], lo[1], hi[1], d[1], serial[1], source[1], startTime[1], extremeTime[1]]

f_coreLastSwings(int len) =>
    float phCore = ta.pivothigh(len, len)
    float plCore = ta.pivotlow(len, len)
    var float lastPhCore = na
    var float lastPlCore = na
    var int lastPhTimeCore = na
    var int lastPlTimeCore = na
    if not na(phCore)
        lastPhCore := phCore
        lastPhTimeCore := time[len]
    if not na(plCore)
        lastPlCore := plCore
        lastPlTimeCore := time[len]
    [lastPhCore, lastPlCore, lastPhTimeCore, lastPlTimeCore]

f_coreLastSwingsConfirmed(int len) =>
    [hi, lo, hiTime, loTime] = f_coreLastSwings(len)
    [hi[1], lo[1], hiTime[1], loTime[1]]

f_closestAbove(float entry, float stop, float minimumR, float a, float b, float c, float d, float e, float f, float g) =>
    float risk = entry - stop
    float threshold = entry + minimumR * risk
    float result = na
    if risk > 0
        if not na(a) and a >= threshold
            result := a
        if not na(b) and b >= threshold and (na(result) or b < result)
            result := b
        if not na(c) and c >= threshold and (na(result) or c < result)
            result := c
        if not na(d) and d >= threshold and (na(result) or d < result)
            result := d
        if not na(e) and e >= threshold and (na(result) or e < result)
            result := e
        if not na(f) and f >= threshold and (na(result) or f < result)
            result := f
        if not na(g) and g >= threshold and (na(result) or g < result)
            result := g
    result

f_closestBelow(float entry, float stop, float minimumR, float a, float b, float c, float d, float e, float f, float g) =>
    float risk = stop - entry
    float threshold = entry - minimumR * risk
    float result = na
    if risk > 0
        if not na(a) and a <= threshold
            result := a
        if not na(b) and b <= threshold and (na(result) or b > result)
            result := b
        if not na(c) and c <= threshold and (na(result) or c > result)
            result := c
        if not na(d) and d <= threshold and (na(result) or d > result)
            result := d
        if not na(e) and e <= threshold and (na(result) or e > result)
            result := e
        if not na(f) and f <= threshold and (na(result) or f > result)
            result := f
        if not na(g) and g <= threshold and (na(result) or g > result)
            result := g
    result

// Prochaine liquidité réellement rencontrée. Contrairement aux helpers du
// moteur Reversal, on ne saute pas un obstacle trop proche pour sélectionner
// artificiellement un niveau plus éloigné qui offrirait le RR demandé.
f_nearestAbove(float entry, float a, float b, float c, float d, float e, float f, float g) =>
    float result = na
    if not na(a) and a > entry
        result := a
    if not na(b) and b > entry and (na(result) or b < result)
        result := b
    if not na(c) and c > entry and (na(result) or c < result)
        result := c
    if not na(d) and d > entry and (na(result) or d < result)
        result := d
    if not na(e) and e > entry and (na(result) or e < result)
        result := e
    if not na(f) and f > entry and (na(result) or f < result)
        result := f
    if not na(g) and g > entry and (na(result) or g < result)
        result := g
    result

f_nearestBelow(float entry, float a, float b, float c, float d, float e, float f, float g) =>
    float result = na
    if not na(a) and a < entry
        result := a
    if not na(b) and b < entry and (na(result) or b > result)
        result := b
    if not na(c) and c < entry and (na(result) or c > result)
        result := c
    if not na(d) and d < entry and (na(result) or d > result)
        result := d
    if not na(e) and e < entry and (na(result) or e > result)
        result := e
    if not na(f) and f < entry and (na(result) or f > result)
        result := f
    if not na(g) and g < entry and (na(result) or g > result)
        result := g
    result

// =============================================================================
//  1 · BIAIS H1 PERSISTANT + JAMBE DU DERNIER BOS
// =============================================================================
htfEmaNow  = request.security(syminfo.tickerid, biasTf, ta.ema(close, biasEmaLen),    lookahead = barmerge.lookahead_off)
htfEmaPrev = request.security(syminfo.tickerid, biasTf, ta.ema(close, biasEmaLen)[1], lookahead = barmerge.lookahead_off)
htfClose   = request.security(syminfo.tickerid, biasTf, close,                        lookahead = barmerge.lookahead_off)

[h1Bias, h1DealingLowRaw, h1DealingHighRaw, h1DealingDir, h1BosSerial, h1RangeSource, h1RangeStartTime, h1RangeExtremeTime] = request.security(syminfo.tickerid, h1Tf, f_coreStructureConfirmed(h1PivotLen), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[h4Bias, _h4DealingLow, _h4DealingHigh, _h4DealingDir, _h4BosSerial, _h4RangeSource, _h4RangeStartTime, _h4RangeExtremeTime] = request.security(syminfo.tickerid, h4Tf, f_coreStructureConfirmed(h4PivotLen), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[m15SwingHigh, m15SwingLow, m15SwingHighTime, m15SwingLowTime] = request.security(syminfo.tickerid, "15", f_coreLastSwingsConfirmed(m15PivotLen), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[h1LiquidityHigh, h1LiquidityLow, h1LiquidityHighTime, h1LiquidityLowTime] = request.security(syminfo.tickerid, "60", f_coreLastSwingsConfirmed(h1LiqPivotLen), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

h1RangeLow  = math.min(h1DealingLowRaw, h1DealingHighRaw)
h1RangeHigh = math.max(h1DealingLowRaw, h1DealingHighRaw)
bool h1RangeReady = not na(h1RangeLow) and not na(h1RangeHigh) and h1RangeHigh > h1RangeLow
h1MidDisplay = h1RangeReady ? (h1RangeLow + h1RangeHigh) / 2.0 : na
bool h1BosRangeReady = h1RangeReady and h1RangeSource == 1
bool h1RangeAligned = h1BosRangeReady and h1Bias != 0 and h1DealingDir == h1Bias
// Le moteur GO utilise uniquement une jambe BOS alignée au biais. La range
// provisoire reste visible mais ne peut plus autoriser une entrée.
h1Mid = h1RangeAligned ? h1MidDisplay : na
string h1RangeDirStr = h1DealingDir == 1 ? "Haussière" : h1DealingDir == -1 ? "Baissière" : "–"
string h1RangeSourceStr = h1RangeSource == 1 ? "Jambe BOS " + h1RangeDirStr : h1RangeSource == 2 ? "Structure H1 de secours" : "En attente"
// Valeurs auditables sans ajouter de tracés ni modifier l'échelle du graphique.
plot(h1RangeLow, "H1 · Range basse clôturée", display = display.data_window)
plot(h1RangeHigh, "H1 · Range haute clôturée", display = display.data_window)
plot(h1MidDisplay, "H1 · EQ 50%", display = display.data_window)
plot(h1Bias, "H1 · Biais (+1 / -1)", display = display.data_window)
plot(h1DealingDir, "H1 · Direction cassure (+1 / -1)", display = display.data_window)
plot(h1RangeSource, "H1 · Source (1=BOS, 2=secours)", display = display.data_window)
plot(h1RangeAligned ? 1 : 0, "H1 · Alignement autorisé (1=oui)", display = display.data_window)

emaBias  = htfClose > htfEmaNow and htfEmaNow >= htfEmaPrev ? 1 : htfClose < htfEmaNow and htfEmaNow <= htfEmaPrev ? -1 : 0
biasAuto = biasMode == "Structure H1 (V4)" ? h1Bias : emaBias
bias     = biasAuto
allowLongDir  = dirMode != "Short"
allowShortDir = dirMode != "Long"
biasStr  = bias == 1 ? "Long HH/HL" : bias == -1 ? "Short LH/LL" : "Neutre"
// [CORRECTIF C5] Le moteur d'entrée utilise `h4Bias != -1` / `h4Bias != 1`.
// L'ancien `: false` faisait afficher « Veto H4 » comme blocage dès que le biais
// H1 était neutre, alors que le vrai blocage est le biais. Le biais neutre reste
// bloquant via h1ContextOK, mais le diagnostic désigne maintenant la bonne cause.
h4VetoOK = not useH4Veto or (bias == 1 ? h4Bias != -1 : bias == -1 ? h4Bias != 1 : true)

bosDir = h1DealingDir
bool bosBullEvt = confirmed and ta.change(h1BosSerial) != 0 and h1DealingDir == 1
bool bosBearEvt = confirmed and ta.change(h1BosSerial) != 0 and h1DealingDir == -1
if showBOS and bosBullEvt
    f_structMark(bosLines, bosLabs, h1RangeHigh, bosBullCol, "BOS H1", true, svMax)
if showBOS and bosBearEvt
    f_structMark(bosLines, bosLabs, h1RangeLow, bosBearCol, "BOS H1", false, svMax)
bosStr = bosDir == 1 ? "Bull" : bosDir == -1 ? "Bear" : "–"

// =============================================================================
//  PIVOTS STRUCTURE (MSS / EQH-EQL)  — longueur pivLen
// =============================================================================
ph = ta.pivothigh(pivLen, pivLen)
pl = ta.pivotlow(pivLen, pivLen)
var float lastPH = na
var float lastPL = na
var float ph1 = na
var float ph2 = na
var float pl1 = na
var float pl2 = na
if not na(ph)
    lastPH := ph
    ph2 := ph1
    ph1 := ph
if not na(pl)
    lastPL := pl
    pl2 := pl1
    pl1 := pl
eqh = not na(ph1) and not na(ph2) and math.abs(ph1 - ph2) <= eqTolTicks * syminfo.mintick
eql = not na(pl1) and not na(pl2) and math.abs(pl1 - pl2) <= eqTolTicks * syminfo.mintick
eqStr = (eqh ? "EQH " : "") + (eql ? "EQL" : "")

// =============================================================================
//  SMT · PIVOTS SYNCHRONISÉS — module indépendant de la structure / du GO
// =============================================================================
// Deux sommets : HH/LH ou LH/HH -> SMT−. Deux creux : LL/HL ou HL/LL -> SMT+.
// L'égalité ne valide pas une divergence. Le second pivot doit être CONFIRMÉ :
// aucune promesse d'un SMT définitif sur un extrême encore en formation.
// Seuls le module SMT et ses diagnostics utilisent ces types / fonctions.
type SmtPivot
    float price
    int stamp

type SmtPair
    float chartPrice
    int chartTime
    float cmpPrice
    int cmpTime

// Appariement un-à-un au plus faible décalage parmi les pivots disponibles.
// Les pivots trop anciens sont écartés, jamais remplacés par un prix quelconque.
f_smtPair(array<SmtPivot> _chart, array<SmtPivot> _cmp, int _tolerance, int _oldest) =>
    while array.size(_chart) > 0
        if array.get(_chart, 0).stamp < _oldest
            array.shift(_chart)
        else
            break
    while array.size(_cmp) > 0
        if array.get(_cmp, 0).stamp < _oldest
            array.shift(_cmp)
        else
            break
    SmtPair matched = na
    int bestChart = na
    int bestCmp = na
    int bestDelta = na
    if array.size(_chart) > 0 and array.size(_cmp) > 0
        for i = 0 to array.size(_chart) - 1
            for j = 0 to array.size(_cmp) - 1
                int delta = math.abs(array.get(_chart, i).stamp - array.get(_cmp, j).stamp)
                if delta <= _tolerance and (na(bestDelta) or delta < bestDelta)
                    bestChart := i
                    bestCmp := j
                    bestDelta := delta
    if not na(bestChart)
        SmtPivot a = array.remove(_chart, bestChart)
        SmtPivot b = array.remove(_cmp, bestCmp)
        matched := SmtPair.new(a.price, a.stamp, b.price, b.stamp)
    matched

f_smtDiverges(SmtPair _previous, SmtPair _current, int _maxSpan) =>
    bool diverges = false
    if not na(_previous) and not na(_current)
        bool ordered = _current.chartTime > _previous.chartTime and _current.cmpTime > _previous.cmpTime
        bool recent = _current.chartTime - _previous.chartTime <= _maxSpan and _current.cmpTime - _previous.cmpTime <= _maxSpan
        diverges := ordered and recent and ((_current.chartPrice > _previous.chartPrice and _current.cmpPrice < _previous.cmpPrice) or (_current.chartPrice < _previous.chartPrice and _current.cmpPrice > _previous.cmpPrice))
    diverges

var array<line> smtLines = array.new<line>()
var array<label> smtLabels = array.new<label>()
f_smtDraw(SmtPair _previous, SmtPair _current, bool _bear, float _padding) =>
    color tint = _bear ? smtBearCol : smtBullCol
    string tag = _bear ? "SMT−" : "SMT+"
    string chartSwing = _bear ? (_current.chartPrice > _previous.chartPrice ? "HH" : "LH") : (_current.chartPrice < _previous.chartPrice ? "LL" : "HL")
    string cmpSwing = _bear ? (_current.cmpPrice > _previous.cmpPrice ? "HH" : "LH") : (_current.cmpPrice < _previous.cmpPrice ? "LL" : "HL")
    string details = syminfo.ticker + " " + chartSwing + " / " + smtSym + " " + cmpSwing
    details += "\nPivot 1 : " + str.format_time(_previous.chartTime, "dd/MM HH:mm", sessTz) + " · " + f_px(_previous.chartPrice)
    details += "\nPivot 2 : " + str.format_time(_current.chartTime, "dd/MM HH:mm", sessTz) + " · " + f_px(_current.chartPrice)
    details += "\nComparateur : " + str.tostring(_previous.cmpPrice) + " → " + str.tostring(_current.cmpPrice)
    details += "\nDétecté à la clôture : " + str.format_time(time_close, "dd/MM HH:mm", sessTz)
    line ln = line.new(_previous.chartTime, _previous.chartPrice, _current.chartTime, _current.chartPrice, xloc = xloc.bar_time, extend = extend.none, color = tint, width = 2)
    int middleTime = _previous.chartTime + int((_current.chartTime - _previous.chartTime) / 2)
    float middlePrice = (_previous.chartPrice + _current.chartPrice) / 2.0 + (_bear ? _padding : -_padding)
    label lb = label.new(middleTime, middlePrice, tag, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, textcolor = tint, size = size.small, textalign = text.align_center, tooltip = details)
    array.push(smtLines, ln)
    array.push(smtLabels, lb)
    if array.size(smtLines) > smtMaxDraw
        line.delete(array.shift(smtLines))
        label.delete(array.shift(smtLabels))
    int(na)

// Les pivots du comparateur sont calculés DANS son propre contexte.
// gaps_on et les deux horodatages empêchent toute réutilisation d'un cours fermé
// (par exemple SP:SPX après 16 h NY). Une donnée absente désactive uniquement SMT.
smtTicker = smtAuto ? smtSym : syminfo.tickerid
[smtCmpTime, smtCmpCloseTime, smtCmpHigh, smtCmpLow, smtCmpPH, smtCmpPL, smtCmpPivotTime] = request.security(smtTicker, timeframe.period, [time, time_close, high, low, ta.pivothigh(smtLeft, smtRight), ta.pivotlow(smtLeft, smtRight), time[smtRight]], gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
float smtPH = ta.pivothigh(smtLeft, smtRight)
float smtPL = ta.pivotlow(smtLeft, smtRight)
int smtBarMs = int(timeframe.in_seconds() * 1000)
bool smtDataReady = smtAuto and timeframe.isintraday and not na(smtCmpTime) and smtCmpTime == time and smtCmpCloseTime == time_close and not na(smtCmpHigh) and not na(smtCmpLow)
float smtPadding = math.max(nz(ta.atr(14), high - low) * 0.12, syminfo.mintick * 5)

var array<SmtPivot> smtChartHighs = array.new<SmtPivot>()
var array<SmtPivot> smtOtherHighs = array.new<SmtPivot>()
var array<SmtPivot> smtChartLows = array.new<SmtPivot>()
var array<SmtPivot> smtOtherLows = array.new<SmtPivot>()
var SmtPair smtHighReference = na
var SmtPair smtLowReference = na
var int smtCommonBars = 0
var int smtLastSyncClose = na
var int lastSmtBar = na
var int lastSmtDir = 0
var bool smtValid = false
var bool smtInvalidOnChart = false
var float smtInvalidLevel = na
var SmtPair smtLastFirst = na
var SmtPair smtLastSecond = na
var int smtLastDelay = na
bool smtBearEvt = false
bool smtBullEvt = false

if confirmed
    bool smtGap = not na(time[1]) and time - time[1] > smtBarMs
    if not smtDataReady or smtGap
        array.clear(smtChartHighs)
        array.clear(smtOtherHighs)
        array.clear(smtChartLows)
        array.clear(smtOtherLows)
        smtHighReference := na
        smtLowReference := na
        smtCommonBars := 0
        smtValid := false
    if smtDataReady
        smtLastSyncClose := time_close
        smtCommonBars += 1
        // Invalidation prospective : si l'actif qui n'avait pas pris le niveau
        // le prend ensuite, l'ancien SMT ne compte plus comme confluence active.
        if smtValid
            float checkPrice = lastSmtDir == -1 ? (smtInvalidOnChart ? high : smtCmpHigh) : (smtInvalidOnChart ? low : smtCmpLow)
            if (lastSmtDir == -1 and checkPrice > smtInvalidLevel) or (lastSmtDir == 1 and checkPrice < smtInvalidLevel)
                smtValid := false
        // Le contexte complet des pivots doit appartenir à une plage commune
        // continue. Aucun appariement artificiel entre fermeture et réouverture.
        if smtCommonBars > smtLeft + smtRight
            if not na(smtPH)
                array.push(smtChartHighs, SmtPivot.new(smtPH, time[smtRight]))
            if not na(smtCmpPH)
                array.push(smtOtherHighs, SmtPivot.new(smtCmpPH, smtCmpPivotTime))
            if not na(smtPL)
                array.push(smtChartLows, SmtPivot.new(smtPL, time[smtRight]))
            if not na(smtCmpPL)
                array.push(smtOtherLows, SmtPivot.new(smtCmpPL, smtCmpPivotTime))
        int oldestPending = time - (smtRight + smtSyncBars) * smtBarMs
        SmtPair highPair = f_smtPair(smtChartHighs, smtOtherHighs, smtSyncBars * smtBarMs, oldestPending)
        SmtPair lowPair = f_smtPair(smtChartLows, smtOtherLows, smtSyncBars * smtBarMs, oldestPending)
        bool bearCandidate = f_smtDiverges(smtHighReference, highPair, smtMaxAge * smtBarMs)
        bool bullCandidate = f_smtDiverges(smtLowReference, lowPair, smtMaxAge * smtBarMs)
        // Deux divergences opposées confirmées ensemble = contexte ambigu,
        // aucune n'est comptée dans la checklist.
        if bearCandidate and bullCandidate
            smtValid := false
        else if bearCandidate or bullCandidate
            bool isBear = bearCandidate
            SmtPair firstPair = isBear ? smtHighReference : smtLowReference
            SmtPair secondPair = isBear ? highPair : lowPair
            bool invalidOnChart = isBear ? secondPair.chartPrice < firstPair.chartPrice : secondPair.chartPrice > firstPair.chartPrice
            float invalidLevel = invalidOnChart ? firstPair.chartPrice : firstPair.cmpPrice
            float currentCheck = isBear ? (invalidOnChart ? high : smtCmpHigh) : (invalidOnChart ? low : smtCmpLow)
            bool stillDivergent = isBear ? currentCheck <= invalidLevel : currentCheck >= invalidLevel
            if stillDivergent
                smtBearEvt := isBear
                smtBullEvt := not isBear
                lastSmtBar := bar_index
                lastSmtDir := isBear ? -1 : 1
                smtValid := true
                smtInvalidOnChart := invalidOnChart
                smtInvalidLevel := invalidLevel
                smtLastFirst := firstPair
                smtLastSecond := secondPair
                smtLastDelay := int((time - secondPair.chartTime) / smtBarMs)
                if smtShow
                    f_smtDraw(firstPair, secondPair, isBear, smtPadding)
        if not na(highPair)
            if na(smtHighReference)
                smtHighReference := highPair
            else if highPair.chartTime > smtHighReference.chartTime and highPair.cmpTime > smtHighReference.cmpTime
                smtHighReference := highPair
        if not na(lowPair)
            if na(smtLowReference)
                smtLowReference := lowPair
            else if lowPair.chartTime > smtLowReference.chartTime and lowPair.cmpTime > smtLowReference.cmpTime
                smtLowReference := lowPair

// Pendant la bougie ouverte, conserver seulement le dernier état clôturé.
// Les décisions nouvelles restent soumises à smtDataReady ET confirmed.
bool smtFeedReady = smtDataReady or (smtAuto and not confirmed and not na(smtLastSyncClose) and smtLastSyncClose == time)
smtRecent = smtFeedReady and smtValid and not na(lastSmtBar) and (bar_index - lastSmtBar) <= recencyBars
string smtStatus = not smtAuto ? "Non requis" : not timeframe.isintraday ? "SMT · TF intraday" : not smtFeedReady ? "SMT · données absentes" : smtRecent ? (lastSmtDir == 1 ? "SMT+" : "SMT−") : "SMT —"
// Diagnostics exacts, uniquement dans la fenêtre de données : aucun encombrement.
plot(smtBearEvt ? -1 : smtBullEvt ? 1 : 0, "SMT · Signal clôturé (+1/−1)", display = display.data_window)
plot(smtDataReady ? 1 : 0, "SMT · Données synchronisées", display = display.data_window)
plot(smtAuto ? smtLastDelay : na, "SMT · Délai dernier signal (bougies)", display = display.data_window)
plot(smtAuto and not na(smtLastFirst) ? smtLastFirst.chartPrice : na, "SMT · Dernier pivot 1", display = display.data_window)
plot(smtAuto and not na(smtLastSecond) ? smtLastSecond.chartPrice : na, "SMT · Dernier pivot 2", display = display.data_window)
plot(smtAuto and not na(smtLastFirst) ? smtLastFirst.cmpPrice : na, "SMT · Comparateur pivot 1", display = display.data_window)
plot(smtAuto and not na(smtLastSecond) ? smtLastSecond.cmpPrice : na, "SMT · Comparateur pivot 2", display = display.data_window)


// =============================================================================
//  MODULE · SWEEP OF LIQUIDITY  (pivots swingLen)
// =============================================================================
var array<float> hLvl = array.new_float()
// [C10] On mémorise l'HORODATAGE du pivot, pas son index de bougie : un niveau
// peut rester non balayé pendant des milliers de bougies, et `xloc.bar_index`
// refuse alors un x1 trop éloigné de la bougie courante (Runtime error RE10026,
// visible surtout en M1). `xloc.bar_time` n'a pas cette limite.
var array<int>   hTime = array.new_int()
var array<float> lLvl = array.new_float()
var array<int>   lTime = array.new_int()
var int  lastSweepBar = na
var int  sweepSide     = 0
var bool sweepBuyEvt   = false
var bool sweepSellEvt  = false
sweepBuyEvt  := false
sweepSellEvt := false
var array<line>  swLines = array.new<line>()
var array<label> swLabs  = array.new<label>()

// [C10] `_t1` est un temps (ms), plus un index de bougie.
f_drawSweep(int _t1, float _lvl, color _col, bool _down) =>
    ln = line.new(_t1, _lvl, time, _lvl, xloc = xloc.bar_time, color = _col, style = f_lineStyle(sweepStyle), width = sweepWidth)
    array.push(swLines, ln)
    if array.size(swLines) > sweepMaxDraw
        line.delete(array.shift(swLines))
    if sweepLabels and not (cleanDisplay and showStageLabels)
        lb = label.new(bar_index, _lvl, "SWEEP", style = _down ? label.style_label_down : label.style_label_up, color = color.new(_col, 82), textcolor = _col, size = f_size(sweepLblSize))
        array.push(swLabs, lb)
        if array.size(swLabs) > sweepMaxDraw
            label.delete(array.shift(swLabs))
    int(na)

// Ligne de liquidité active : texte seul sur la ligne, sans bulle.
f_manageLiquidity(line _ln, label _lb, bool _enabled, bool _replace, int _originTime, int _lineRightTime, int _labelTime, float _level, color _col, string _tag, string _style, int _width, bool _showPrice, string _size) =>
    line nextLn = _ln
    label nextLb = _lb
    if not _enabled
        if not na(nextLn)
            line.delete(nextLn)
            nextLn := na
        if not na(nextLb)
            label.delete(nextLb)
            nextLb := na
    else
        bool mustBuild = (_replace or na(nextLn) or na(nextLb)) and not na(_originTime) and not na(_level)
        if mustBuild
            if not na(nextLn)
                line.delete(nextLn)
            if not na(nextLb)
                label.delete(nextLb)
            string liqText = _tag + (_showPrice ? "  " + f_px(_level) : "")
            nextLn := line.new(_originTime, _level, _lineRightTime, _level, xloc = xloc.bar_time, color = _col, style = f_lineStyle(_style), width = _width)
            nextLb := label.new(_labelTime, _level, liqText, xloc = xloc.bar_time, style = label.style_none, textcolor = _col, size = f_size(_size), textalign = text.align_left)
        if not na(nextLn)
            line.set_xy1(nextLn, _originTime, _level)
            line.set_xy2(nextLn, _lineRightTime, _level)
            line.set_color(nextLn, _col)
            line.set_style(nextLn, f_lineStyle(_style))
            line.set_width(nextLn, _width)
        if not na(nextLb)
            label.set_x(nextLb, _labelTime)
            label.set_y(nextLb, _level)
            label.set_text(nextLb, _tag + (_showPrice ? "  " + f_px(_level) : ""))
            label.set_textcolor(nextLb, _col)
            label.set_size(nextLb, f_size(_size))
    [nextLn, nextLb]

f_nearLiquidity(float _a, float _b, float _tol) =>
    not na(_a) and not na(_b) and math.abs(_a - _b) <= _tol

sph = ta.pivothigh(swingLen, swingLen)
spl = ta.pivotlow(swingLen, swingLen)
// [C2] Pine ne restaure PAS le contenu d'un tableau entre les ticks d'une bougie
// en cours. Sans le garde `confirmed`, chaque tick réempilait le même pivot et
// le tableau se remplissait de doublons en direct (invisible en historique).
if confirmed and not na(sph)
    array.push(hLvl, sph)
    array.push(hTime, time[swingLen])
    if array.size(hLvl) > sweepMaxLevels
        array.shift(hLvl), array.shift(hTime)
if confirmed and not na(spl)
    array.push(lLvl, spl)
    array.push(lTime, time[swingLen])
    if array.size(lLvl) > sweepMaxLevels
        array.shift(lLvl), array.shift(lTime)

// [C7] Le module tourne toujours : masquer les sweeps pivots ne doit changer ni
// l'état des tableaux, ni les alertes. Seul le tracé dépend des cases d'affichage.
if confirmed
    i = 0
    while i < array.size(hLvl)
        lvl = array.get(hLvl, i)
        if high > lvl and close < lvl
            if showSweep and showPivotSweeps
                f_drawSweep(array.get(hTime, i), lvl, sweepBuyCol, true)
            array.remove(hLvl, i), array.remove(hTime, i)
            sweepBuyEvt := true
            lastSweepBar := bar_index
            sweepSide := 1
        else
            i += 1
    j = 0
    while j < array.size(lLvl)
        lvl = array.get(lLvl, j)
        if low < lvl and close > lvl
            if showSweep and showPivotSweeps
                f_drawSweep(array.get(lTime, j), lvl, sweepSellCol, false)
            array.remove(lLvl, j), array.remove(lTime, j)
            sweepSellEvt := true
            lastSweepBar := bar_index
            sweepSide := -1
        else
            j += 1

// =============================================================================
//  LIGNES DE LIQUIDITÉ ACTIVES — TF COURANT / M15 / H1
//  BSL = liquidité au-dessus d'un swing high confirmé.
//  SSL = liquidité sous un swing low confirmé.
// =============================================================================
int liqBarMs = int(timeframe.in_seconds(timeframe.period) * 1000)
int liqLineRightTime = time + liqBarMs * liqExtend
int liqLabelTimeCurrent = time + liqBarMs
int liqLabelTimeM15 = time + liqBarMs * (1 + liqTfOffset)
int liqLabelTimeH1 = time + liqBarMs * (1 + 2 * liqTfOffset)
string liqCurrentTfTag = timeframe.isminutes ? "M" + str.tostring(timeframe.multiplier) : timeframe.period

var float curBslLevel = na
var float curSslLevel = na
var int curBslOriginTime = na
var int curSslOriginTime = na
var int curBslCreatedBar = na
var int curSslCreatedBar = na
var line curBslLine = na
var line curSslLine = na
var label curBslLabel = na
var label curSslLabel = na

bool newCurBsl = not na(sph)
bool newCurSsl = not na(spl)
if newCurBsl
    curBslLevel := sph
    curBslOriginTime := time[swingLen]
    curBslCreatedBar := bar_index
if newCurSsl
    curSslLevel := spl
    curSslOriginTime := time[swingLen]
    curSslCreatedBar := bar_index

var float m15BslLevel = na
var float m15SslLevel = na
var int m15BslSeenTime = na
var int m15SslSeenTime = na
var int m15BslCreatedBar = na
var int m15SslCreatedBar = na
var line m15BslLine = na
var line m15SslLine = na
var label m15BslLabel = na
var label m15SslLabel = na

bool newM15Bsl = not na(m15SwingHighTime) and (na(m15BslSeenTime) or m15SwingHighTime != m15BslSeenTime)
bool newM15Ssl = not na(m15SwingLowTime) and (na(m15SslSeenTime) or m15SwingLowTime != m15SslSeenTime)
if newM15Bsl
    m15BslLevel := m15SwingHigh
    m15BslSeenTime := m15SwingHighTime
    m15BslCreatedBar := bar_index
if newM15Ssl
    m15SslLevel := m15SwingLow
    m15SslSeenTime := m15SwingLowTime
    m15SslCreatedBar := bar_index

var float h1BslLevel = na
var float h1SslLevel = na
var int h1BslSeenTime = na
var int h1SslSeenTime = na
var int h1BslCreatedBar = na
var int h1SslCreatedBar = na
var line h1BslLine = na
var line h1SslLine = na
var label h1BslLabel = na
var label h1SslLabel = na

bool newH1Bsl = not na(h1LiquidityHighTime) and (na(h1BslSeenTime) or h1LiquidityHighTime != h1BslSeenTime)
bool newH1Ssl = not na(h1LiquidityLowTime) and (na(h1SslSeenTime) or h1LiquidityLowTime != h1SslSeenTime)
if newH1Bsl
    h1BslLevel := h1LiquidityHigh
    h1BslSeenTime := h1LiquidityHighTime
    h1BslCreatedBar := bar_index
if newH1Ssl
    h1SslLevel := h1LiquidityLow
    h1SslSeenTime := h1LiquidityLowTime
    h1SslCreatedBar := bar_index

// Déduplication multi-timeframe déterministe : H1 a priorité sur M15, puis M15
// sur le TF courant. Chaque timeframe ne peut être rattaché qu'à UNE ligne,
// même dans le cas non transitif A proche de B, B proche de C, A loin de C.
float liqMergeTol = syminfo.mintick * liqMergeTicks
bool dupCurM15Bsl = showLiqCurrent and showLiqM15 and f_nearLiquidity(curBslLevel, m15BslLevel, liqMergeTol)
bool dupCurM15Ssl = showLiqCurrent and showLiqM15 and f_nearLiquidity(curSslLevel, m15SslLevel, liqMergeTol)
bool dupCurH1Bsl = showLiqCurrent and showLiqH1 and f_nearLiquidity(curBslLevel, h1BslLevel, liqMergeTol)
bool dupCurH1Ssl = showLiqCurrent and showLiqH1 and f_nearLiquidity(curSslLevel, h1SslLevel, liqMergeTol)
bool dupM15H1Bsl = showLiqM15 and showLiqH1 and f_nearLiquidity(m15BslLevel, h1BslLevel, liqMergeTol)
bool dupM15H1Ssl = showLiqM15 and showLiqH1 and f_nearLiquidity(m15SslLevel, h1SslLevel, liqMergeTol)

bool mergeM15IntoH1Bsl = dupM15H1Bsl
bool mergeM15IntoH1Ssl = dupM15H1Ssl
bool mergeCurIntoH1Bsl = dupCurH1Bsl
bool mergeCurIntoH1Ssl = dupCurH1Ssl
bool mergeCurIntoM15Bsl = not mergeCurIntoH1Bsl and not mergeM15IntoH1Bsl and dupCurM15Bsl
bool mergeCurIntoM15Ssl = not mergeCurIntoH1Ssl and not mergeM15IntoH1Ssl and dupCurM15Ssl

bool drawH1Bsl = showLiqH1 and not na(h1BslLevel)
bool drawH1Ssl = showLiqH1 and not na(h1SslLevel)
bool drawM15Bsl = showLiqM15 and not na(m15BslLevel) and not mergeM15IntoH1Bsl
bool drawM15Ssl = showLiqM15 and not na(m15SslLevel) and not mergeM15IntoH1Ssl
bool drawCurBsl = showLiqCurrent and not na(curBslLevel) and not mergeCurIntoH1Bsl and not mergeCurIntoM15Bsl
bool drawCurSsl = showLiqCurrent and not na(curSslLevel) and not mergeCurIntoH1Ssl and not mergeCurIntoM15Ssl

string h1BslTag = (mergeCurIntoH1Bsl and liqCurrentTfTag != "H1" and liqCurrentTfTag != "M15" ? liqCurrentTfTag + "/" : "") + (mergeM15IntoH1Bsl ? "M15/" : "") + "H1 BSL"
string h1SslTag = (mergeCurIntoH1Ssl and liqCurrentTfTag != "H1" and liqCurrentTfTag != "M15" ? liqCurrentTfTag + "/" : "") + (mergeM15IntoH1Ssl ? "M15/" : "") + "H1 SSL"
string m15BslTag = mergeCurIntoM15Bsl and liqCurrentTfTag != "M15" ? liqCurrentTfTag + "/M15 BSL" : "M15 BSL"
string m15SslTag = mergeCurIntoM15Ssl and liqCurrentTfTag != "M15" ? liqCurrentTfTag + "/M15 SSL" : "M15 SSL"

[curBslLineNext, curBslLabelNext] = f_manageLiquidity(curBslLine, curBslLabel, drawCurBsl, newCurBsl, curBslOriginTime, liqLineRightTime, liqLabelTimeCurrent, curBslLevel, liqBslCol, liqCurrentTfTag + " BSL", liqCurrentStyle, liqCurrentWidth, liqShowPrice, liqLblSize)
curBslLine := curBslLineNext
curBslLabel := curBslLabelNext
[curSslLineNext, curSslLabelNext] = f_manageLiquidity(curSslLine, curSslLabel, drawCurSsl, newCurSsl, curSslOriginTime, liqLineRightTime, liqLabelTimeCurrent, curSslLevel, liqSslCol, liqCurrentTfTag + " SSL", liqCurrentStyle, liqCurrentWidth, liqShowPrice, liqLblSize)
curSslLine := curSslLineNext
curSslLabel := curSslLabelNext

[m15BslLineNext, m15BslLabelNext] = f_manageLiquidity(m15BslLine, m15BslLabel, drawM15Bsl, newM15Bsl, m15BslSeenTime, liqLineRightTime, liqLabelTimeM15, m15BslLevel, liqBslCol, m15BslTag, liqM15Style, liqM15Width, liqShowPrice, liqLblSize)
m15BslLine := m15BslLineNext
m15BslLabel := m15BslLabelNext
[m15SslLineNext, m15SslLabelNext] = f_manageLiquidity(m15SslLine, m15SslLabel, drawM15Ssl, newM15Ssl, m15SslSeenTime, liqLineRightTime, liqLabelTimeM15, m15SslLevel, liqSslCol, m15SslTag, liqM15Style, liqM15Width, liqShowPrice, liqLblSize)
m15SslLine := m15SslLineNext
m15SslLabel := m15SslLabelNext

[h1BslLineNext, h1BslLabelNext] = f_manageLiquidity(h1BslLine, h1BslLabel, drawH1Bsl, newH1Bsl, h1BslSeenTime, liqLineRightTime, liqLabelTimeH1, h1BslLevel, liqBslCol, h1BslTag, liqH1Style, liqH1Width, liqShowPrice, liqLblSize)
h1BslLine := h1BslLineNext
h1BslLabel := h1BslLabelNext
[h1SslLineNext, h1SslLabelNext] = f_manageLiquidity(h1SslLine, h1SslLabel, drawH1Ssl, newH1Ssl, h1SslSeenTime, liqLineRightTime, liqLabelTimeH1, h1SslLevel, liqSslCol, h1SslTag, liqH1Style, liqH1Width, liqShowPrice, liqLblSize)
h1SslLine := h1SslLineNext
h1SslLabel := h1SslLabelNext

// Une liquidité est considérée consommée dès qu'une bougie clôturée trade au-delà.
if liqDeleteOnTake and confirmed and not na(curBslLevel) and bar_index > curBslCreatedBar and high > curBslLevel
    if not na(curBslLine)
        line.delete(curBslLine)
        curBslLine := na
    if not na(curBslLabel)
        label.delete(curBslLabel)
        curBslLabel := na
    curBslLevel := na
if liqDeleteOnTake and confirmed and not na(curSslLevel) and bar_index > curSslCreatedBar and low < curSslLevel
    if not na(curSslLine)
        line.delete(curSslLine)
        curSslLine := na
    if not na(curSslLabel)
        label.delete(curSslLabel)
        curSslLabel := na
    curSslLevel := na
if liqDeleteOnTake and confirmed and not na(m15BslLevel) and bar_index > m15BslCreatedBar and high > m15BslLevel
    if not na(m15BslLine)
        line.delete(m15BslLine)
        m15BslLine := na
    if not na(m15BslLabel)
        label.delete(m15BslLabel)
        m15BslLabel := na
    m15BslLevel := na
if liqDeleteOnTake and confirmed and not na(m15SslLevel) and bar_index > m15SslCreatedBar and low < m15SslLevel
    if not na(m15SslLine)
        line.delete(m15SslLine)
        m15SslLine := na
    if not na(m15SslLabel)
        label.delete(m15SslLabel)
        m15SslLabel := na
    m15SslLevel := na
if liqDeleteOnTake and confirmed and not na(h1BslLevel) and bar_index > h1BslCreatedBar and high > h1BslLevel
    if not na(h1BslLine)
        line.delete(h1BslLine)
        h1BslLine := na
    if not na(h1BslLabel)
        label.delete(h1BslLabel)
        h1BslLabel := na
    h1BslLevel := na
if liqDeleteOnTake and confirmed and not na(h1SslLevel) and bar_index > h1SslCreatedBar and low < h1SslLevel
    if not na(h1SslLine)
        line.delete(h1SslLine)
        h1SslLine := na
    if not na(h1SslLabel)
        label.delete(h1SslLabel)
        h1SslLabel := na
    h1SslLevel := na

// =============================================================================
//  MODULE · HTF POI (Order Blocks + FVG)
// =============================================================================
f_htf() =>
    bfvg = low[1]  > high[3]
    sfvg = high[1] < low[3]
    fTop = bfvg ? low[1]  : sfvg ? low[3]  : na
    fBot = bfvg ? high[3] : sfvg ? high[1] : na
    fDir = bfvg ? 1 : sfvg ? -1 : 0
    fAnc = time[3]
    bob = close[1] > open[1] and close[1] > high[2] and close[2] < open[2]
    sob = close[1] < open[1] and close[1] < low[2]  and close[2] > open[2]
    oTop = (bob or sob) ? high[2] : na
    oBot = (bob or sob) ? low[2]  : na
    oDir = bob ? 1 : sob ? -1 : 0
    oAnc = time[2]
    [fTop, fBot, fDir, bfvg or sfvg, fAnc, oTop, oBot, oDir, bob or sob, oAnc]

[hfTop, hfBot, hfDir, hfNew, hfAnc, hoTop, hoBot, hoDir, hoNew, hoAnc] = request.security(syminfo.tickerid, htf, f_htf(), lookahead = barmerge.lookahead_off)
htfNewBar = ta.change(time(htf)) != 0
var array<box> poiBoxes = array.new<box>()
var float lastHtfFvgTop = na
var float lastHtfFvgBot = na
var float lastHtfObTop = na
var float lastHtfObBot = na
if htfNewBar
    if hfNew and hfDir != 0
        lastHtfFvgTop := hfTop
        lastHtfFvgBot := hfBot
    if hoNew and hoDir != 0
        lastHtfObTop := hoTop
        lastHtfObBot := hoBot

f_pushPOI(_top, _bot, _anchor, _col, _txt) =>
    b = box.new(left = _anchor, top = _top, right = time, bottom = _bot, xloc = xloc.bar_time, border_color = color.new(_col, poiFill ? 20 : 0), border_style = f_boxStyle(poiBorder), bgcolor = poiFill ? _col : color.new(_col, 100))
    if poiLabels
        box.set_text(b, _txt)
        box.set_text_halign(b, text.align_left)
        box.set_text_valign(b, text.align_top)
        box.set_text_color(b, color.new(_col, 0))
        box.set_text_size(b, size.small)
    array.push(poiBoxes, b)
    if array.size(poiBoxes) > poiMax
        box.delete(array.shift(poiBoxes))

// [C2] `htfNewBar` reste vrai pendant tous les ticks de la première bougie du
// nouveau HTF : sans `confirmed`, une boîte était empilée à chaque tick en direct.
if showPOI and htfNewBar and confirmed
    if showHtfFVG and hfNew and hfDir != 0
        f_pushPOI(hfTop, hfBot, hfAnc, hfDir == 1 ? fvgBullCol : fvgBearCol, hfDir == 1 ? "HTF FVG +" : "HTF FVG −")
    if showHtfOB and hoNew and hoDir != 0
        f_pushPOI(hoTop, hoBot, hoAnc, hoDir == 1 ? obBullCol : obBearCol, hoDir == 1 ? "HTF OB +" : "HTF OB −")

if showPOI and barstate.islast and array.size(poiBoxes) > 0
    for bi = 0 to array.size(poiBoxes) - 1
        box.set_right(array.get(poiBoxes, bi), time)

// `htfPoiActive` (boucle sur toutes les boîtes à chaque bougie) était calculé
// puis jamais lu : supprimé. La confluence HTF utilise `htfPoiContext` ci-dessous,
// qui ne dépend pas des cases d'affichage.
htfPoiContext = (not na(lastHtfFvgTop) and close <= math.max(lastHtfFvgTop, lastHtfFvgBot) and close >= math.min(lastHtfFvgTop, lastHtfFvgBot)) or (not na(lastHtfObTop) and close <= math.max(lastHtfObTop, lastHtfObBot) and close >= math.min(lastHtfObTop, lastHtfObBot))

// =============================================================================
//  MODULE · IFVG (TF courant)  — alimente aussi POI(#6), IFVG(#9), OB-align(#10)
// =============================================================================
var array<box>   fBoxes = array.new<box>()
var array<label> fLabs  = array.new<label>()
var array<int>   fState = array.new_int()
var bool  ifvgEvt = false
ifvgEvt := false
var float lastIfvgTop = na
var float lastIfvgBot = na
var int   lastIfvgDir = 0

f_addFVG(_top, _bot, _dir) =>
    col = _dir == 1 ? baseBullCol : baseBearCol
    b = box.new(bar_index - 2, _top, bar_index, _bot, xloc = xloc.bar_index, border_color = color.new(col, 40), border_style = line.style_dotted, bgcolor = col)
    lb = label.new(bar_index - 1, (_top + _bot) / 2.0, _dir == 1 ? "FVG +" : "FVG −", style = label.style_none, textcolor = color.new(_dir == 1 ? baseBullCol : baseBearCol, 0), size = size.tiny, textalign = text.align_center)
    array.push(fBoxes, b), array.push(fLabs, lb), array.push(fState, _dir)
    if array.size(fBoxes) > ifvgMax
        box.delete(array.shift(fBoxes)), label.delete(array.shift(fLabs)), array.shift(fState)

if (showIFVG or showBaseFVG) and confirmed
    bull = low > high[2]
    bear = high < low[2]
    gap  = bull ? low - high[2] : bear ? low[2] - high : 0.0
    if (bull or bear) and gap >= fvgMinTicks
        f_addFVG(bull ? low : low[2], bull ? high[2] : high, bull ? 1 : -1)
    k = 0
    while k < array.size(fBoxes)
        st = array.get(fState, k)
        b  = array.get(fBoxes, k)
        lb = array.get(fLabs, k)
        top = box.get_top(b)
        bot = box.get_bottom(b)
        if st == 1 and close < bot
            box.set_bgcolor(b, invBearCol)
            box.set_border_color(b, color.new(invBearCol, 10))
            box.set_border_style(b, line.style_solid)
            label.set_text(lb, "IFVG")
            label.set_textcolor(lb, color.new(invBearCol, 0))
            label.set_style(lb, label.style_none)
            label.set_y(lb, (top + bot) / 2.0)
            array.set(fState, k, 2)
            ifvgEvt := true
            lastIfvgTop := top
            lastIfvgBot := bot
            lastIfvgDir := -1
        else if st == -1 and close > top
            box.set_bgcolor(b, invBullCol)
            box.set_border_color(b, color.new(invBullCol, 10))
            box.set_border_style(b, line.style_solid)
            label.set_text(lb, "IFVG")
            label.set_textcolor(lb, color.new(invBullCol, 0))
            label.set_style(lb, label.style_none)
            label.set_y(lb, (top + bot) / 2.0)
            array.set(fState, k, 2)
            ifvgEvt := true
            lastIfvgTop := top
            lastIfvgBot := bot
            lastIfvgDir := 1
        if not showBaseFVG and (st == 1 or st == -1)
            box.set_bgcolor(b, color.new(color.gray, 100))
            box.set_border_color(b, color.new(color.gray, 100))
            label.set_color(lb, color.new(color.gray, 100))
            label.set_textcolor(lb, color.new(color.gray, 100))
        k += 1

if (showIFVG or showBaseFVG) and barstate.islast and array.size(fBoxes) > 0
    for bi = 0 to array.size(fBoxes) - 1
        box activeFvgBox = array.get(fBoxes, bi)
        box.set_right(activeFvgBox, bar_index)
        label.set_x(array.get(fLabs, bi), int(math.round((box.get_left(activeFvgBox) + bar_index) / 2.0)))

fvgActive  = false
ifvgActive = false
if array.size(fBoxes) > 0
    for bi = 0 to array.size(fBoxes) - 1
        st2 = array.get(fState, bi)
        bb  = array.get(fBoxes, bi)
        inside = close <= box.get_top(bb) and close >= box.get_bottom(bb)
        if inside and (st2 == 1 or st2 == -1)
            fvgActive := true
        if inside and st2 == 2
            ifvgActive := true

ifMid  = lastIfvgDir != 0 ? (lastIfvgTop + lastIfvgBot) / 2.0 : na
ifvgOK = ifvgActive

// =============================================================================
//  MODULE · CISD  — alimente Structure(#8)
// =============================================================================
// La détection a été déplacée dans la section « CISD — MOTEUR DE DÉTECTION »
// plus bas, pour que la ligne tracée soit exactement celle qui déclenche
// l'étape 2 de la séquence. Ce bloc ne conserve que l'état d'affichage.
var int   runStartBar  = na
var int   lastCisdBar  = na
var int   lastCisdDir  = 0
var array<line>  cisdLines = array.new<line>()
var array<label> cisdLabs  = array.new<label>()
var bool cisdBullEvt = false
var bool cisdBearEvt = false
cisdBullEvt := false
cisdBearEvt := false

f_pushCISD(_lvl, _x1, _bull) =>
    col = _bull ? cisdBullCol : cisdBearCol
    ln = line.new(_x1, _lvl, bar_index + cisdExtend, _lvl, xloc = xloc.bar_index, color = col, style = f_lineStyle(cisdStyle), width = cisdWidth)
    lb = label.new(bar_index + cisdExtend, _lvl, "CISD", style = label.style_none, textcolor = col, size = f_size(cisdLblSize), textalign = text.align_left)
    array.push(cisdLines, ln), array.push(cisdLabs, lb)
    if array.size(cisdLines) > cisdMax
        line.delete(array.shift(cisdLines)), label.delete(array.shift(cisdLabs))

// cisdRecent lit ici la valeur de la bougie précédente, puisque la détection a
// été déplacée plus bas. Sans conséquence : cette variable n'alimente que
// structOK / structStr, qui ne sont affichés nulle part dans le script.
cisdRecent = not na(lastCisdBar) and (bar_index - lastCisdBar) <= recencyBars

// =============================================================================
//  MSS / CHOCH  +  STRUCTURE
// =============================================================================
var int mssDir = 0
var int mssBar = na
var float mssBrokenHigh = na
var float mssBrokenLow  = na
bool mssBullEvt = false
bool mssBearEvt = false
if confirmed and not na(lastPH) and close > lastPH and (na(mssBrokenHigh) or lastPH != mssBrokenHigh)
    mssDir := 1
    mssBar := bar_index
    mssBullEvt := true
    mssBrokenHigh := lastPH
if confirmed and not na(lastPL) and close < lastPL and (na(mssBrokenLow) or lastPL != mssBrokenLow)
    mssDir := -1
    mssBar := bar_index
    mssBearEvt := true
    mssBrokenLow := lastPL
if showMSS and mssBullEvt
    f_structMark(mssLines, mssLabs, lastPH, mssBullCol, "MSS", true, svMax)
if showMSS and mssBearEvt
    f_structMark(mssLines, mssLabs, lastPL, mssBearCol, "MSS", false, svMax)
mssRecent = not na(mssBar) and (bar_index - mssBar) <= recencyBars
structOK  = bias != 0 ? ((mssRecent and mssDir == bias) or (cisdRecent and lastCisdDir == bias)) : (mssRecent or cisdRecent)
structStr = structOK ? (cisdRecent ? "CISD" : "MSS") : "–"

// =============================================================================
//  ORDER BLOCK (TF courant, léger) + EMA POI + VOLUME
// =============================================================================
var float obTop = na
var float obBot = na
var int   obDir = 0
if confirmed
    if close > open and close > high[1] and close[1] < open[1]
        obTop := high[1]
        obBot := low[1]
        obDir := 1
    else if close < open and close < low[1] and close[1] > open[1]
        obTop := high[1]
        obBot := low[1]
        obDir := -1

emaPoi = ta.ema(close, emaLen)
plot(showEma ? emaPoi : na, "EMA POI", color = color.new(color.orange, 0), linewidth = 2)

nearEma = math.abs(close - emaPoi) <= emaPoi * emaTolPct / 100.0
inOb    = obDir != 0 and close <= math.max(obTop, obBot) and close >= math.min(obTop, obBot)
poiOK   = nearEma or fvgActive or inOb
poiStr  = fvgActive ? "FVG" : inOb ? "OB" : nearEma ? "EMA" : "–"
obAlign = obDir != 0 and lastIfvgDir != 0 and math.max(obBot, lastIfvgBot) <= math.min(obTop, lastIfvgTop)
item10OK = obAlign or smtManual or (smtAuto and smtRecent)

volMa = ta.sma(volume, volLen)
var int lastVolBar = na
if confirmed and volume > volMa * volMult
    lastVolBar := bar_index
volOK = not na(lastVolBar) and (bar_index - lastVolBar) <= recencyBars

// =============================================================================
//  DISCOUNT / PREMIUM — JAMBE DU DERNIER BOS H1
// =============================================================================
legH = h1RangeHigh
legL = h1RangeLow
mid  = h1MidDisplay
favFib  = not na(h1Mid) and (bias == 1 ? close <= h1Mid : bias == -1 ? close >= h1Mid : false)
string pdLocationStr = na(mid) ? "Range H1 indisponible" : close < legL ? "Sous la range H1" : close > legH ? "Au-dessus de la range H1" : close <= mid ? "Discount H1" : "Premium H1"
zoneStr = na(mid) ? pdLocationStr : not h1BosRangeReady ? pdLocationStr + " · secours / GO bloqué" : not h1RangeAligned ? pdLocationStr + " · attente biais" : pdLocationStr

showFibZones = fibMode == "Zones + 50%"
showFibLine  = fibMode != "Off"
var box   discBox = na
var box   premBox = na
var line  midLine = na
var label eqLab   = na
int pdBarMs = int(timeframe.in_seconds(timeframe.period) * 1000)
int pdLeftTime = not na(h1RangeStartTime) ? h1RangeStartTime : time - pdBarMs * legLen
int pdRightTime = time + pdBarMs * lineExt
string eqText = (h1RangeSource == 1 ? "EQ H1 50% · BOS " + (h1DealingDir == 1 ? "↑" : "↓") : "EQ H1 50% · STRUCT.") + " · " + f_px(mid)
if barstate.islast
    if showFibLine and not na(mid) and not na(legH) and not na(legL) and not na(pdLeftTime)
        if na(midLine)
            midLine := line.new(pdLeftTime, mid, pdRightTime, mid, xloc = xloc.bar_time, color = color.new(color.gray, 0), style = line.style_dashed)
            eqLab   := label.new(pdRightTime, mid, eqText, xloc = xloc.bar_time, style = label.style_none, textcolor = color.new(color.gray, 0), size = size.small, textalign = text.align_left)
        line.set_xy1(midLine, pdLeftTime, mid)
        line.set_xy2(midLine, pdRightTime, mid)
        label.set_xy(eqLab, pdRightTime, mid)
        label.set_text(eqLab, eqText)
        if showFibZones
            if na(discBox)
                discBox := box.new(pdLeftTime, mid, pdRightTime, legL, xloc = xloc.bar_time, bgcolor = discCol, border_color = color.new(discCol, 40))
                premBox := box.new(pdLeftTime, legH, pdRightTime, mid, xloc = xloc.bar_time, bgcolor = premCol, border_color = color.new(premCol, 40))
            box.set_left(discBox, pdLeftTime), box.set_right(discBox, pdRightTime), box.set_top(discBox, mid), box.set_bottom(discBox, legL)
            box.set_left(premBox, pdLeftTime), box.set_right(premBox, pdRightTime), box.set_top(premBox, legH), box.set_bottom(premBox, mid)
        else if not na(discBox)
            box.delete(discBox)
            box.delete(premBox)
            discBox := na
            premBox := na
    else
        if not na(midLine)
            line.delete(midLine)
            label.delete(eqLab)
            midLine := na
            eqLab := na
        if not na(discBox)
            box.delete(discBox)
            box.delete(premBox)
            discBox := na
            premBox := na

// =============================================================================
//  NIVEAUX DE SESSION (ORH/ORL · Asie · Londres) + PDH/PDL
// =============================================================================
f_sess(_show, _sess, _tz, _col, _tag, _style, _width, _lsize, _ext) =>
    var float hi  = na
    var float lo  = na
    var int   x0  = na
    var line  lnH = na
    var line  lnL = na
    var label lbH = na
    var label lbL = na
    inS  = _show and not na(time(timeframe.period, _sess, _tz))
    strt = inS and not inS[1]
    endS = (not inS) and inS[1]
    if strt
        hi := high
        lo := low
        x0 := bar_index
    else if inS
        hi := math.max(hi, high)
        lo := math.min(lo, low)
    if endS and not na(hi)
        if not na(lnH)
            line.delete(lnH)
            line.delete(lnL)
            label.delete(lbH)
            label.delete(lbL)
        lnH := line.new(x0, hi, bar_index + _ext, hi, xloc = xloc.bar_index, color = _col, style = _style, width = _width)
        lnL := line.new(x0, lo, bar_index + _ext, lo, xloc = xloc.bar_index, color = _col, style = _style, width = _width)
        lbH := label.new(bar_index + _ext, hi, _tag + " H", style = label.style_label_left, color = color.new(_col, 88), textcolor = _col, size = _lsize)
        lbL := label.new(bar_index + _ext, lo, _tag + " L", style = label.style_label_left, color = color.new(_col, 88), textcolor = _col, size = _lsize)
    if not na(lnH)
        line.set_x2(lnH, bar_index + _ext)
        line.set_x2(lnL, bar_index + _ext)
        label.set_x(lbH, bar_index + _ext)
        label.set_x(lbL, bar_index + _ext)
    int(na)

f_sess(showOR,   orSess,   sessTz, orCol,   "OR",   f_lineStyle(lvlStyle), lvlWidth, f_size(lvlLblSize), lvlExtend)
f_sess(showAsia, asiaSess, sessTz, asiaCol, "ASIA", f_lineStyle(lvlStyle), lvlWidth, f_size(lvlLblSize), lvlExtend)
f_sess(showLon,  lonSess,  sessTz, lonCol,  "LON",  f_lineStyle(lvlStyle), lvlWidth, f_size(lvlLblSize), lvlExtend)

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
newDay = ta.change(time("D")) != 0
var int dayStart = na
if newDay or na(dayStart)
    dayStart := bar_index
var line  pdhLine = na
var line  pdlLine = na
var label pdhLab  = na
var label pdlLab  = na
if showPD and not na(pdh)
    if na(pdhLine)
        pdhLine := line.new(dayStart, pdh, bar_index + lvlExtend, pdh, xloc = xloc.bar_index, color = pdhCol, style = f_lineStyle(lvlStyle), width = lvlWidth)
        pdlLine := line.new(dayStart, pdl, bar_index + lvlExtend, pdl, xloc = xloc.bar_index, color = pdlCol, style = f_lineStyle(lvlStyle), width = lvlWidth)
        pdhLab  := label.new(bar_index + lvlExtend, pdh, "PDH", style = label.style_label_left, color = color.new(pdhCol, 88), textcolor = pdhCol, size = f_size(lvlLblSize))
        pdlLab  := label.new(bar_index + lvlExtend, pdl, "PDL", style = label.style_label_left, color = color.new(pdlCol, 88), textcolor = pdlCol, size = f_size(lvlLblSize))
    line.set_xy1(pdhLine, dayStart, pdh)
    line.set_xy2(pdhLine, bar_index + lvlExtend, pdh)
    line.set_xy1(pdlLine, dayStart, pdl)
    line.set_xy2(pdlLine, bar_index + lvlExtend, pdl)
    label.set_xy(pdhLab, bar_index + lvlExtend, pdh)
    label.set_xy(pdlLab, bar_index + lvlExtend, pdl)
levelsOK = not na(pdh) and not na(pdl)

// =============================================================================
//  MOTEUR STRICT — SESSIONS ET LIQUIDITÉS EXTERNES
// =============================================================================
inAsiaCore      = not na(time(timeframe.period, asiaSess, sessTz))
inLonCore       = not na(time(timeframe.period, lonSess, sessTz))
inOrCore        = not na(time(timeframe.period, orSess, sessTz))
inSweepCapture  = not na(time(timeframe.period, sweepCaptureSess, sessTz))
inSequence      = not na(time(timeframe.period, seqSess, sessTz))
inNY            = not na(time(timeframe.period, nyTradeSess, sessTz))
inFlatCore      = not na(time(timeframe.period, flatSess, sessTz))
inLonG          = useLonGate and not na(time(timeframe.period, lonTradeSess, sessTz))
sessOK          = (inNY and not inFlatCore) or inLonG
sessStr         = inFlatCore ? "Clôture forcée" : inNY ? "NY" : inLonG ? "Londres" : "Hors entrée"
tfOK            = not enforceM5 or (timeframe.isminutes and timeframe.multiplier == 5)
// [CORRECTIF C6] Avant : `not sessOK and sessOK[1]`. Avec « Accepter aussi
// Londres », sessOK retombait à 05:00 NY et détruisait tout plan de la session
// NY encore en attente. On n'annule plus que sur la vraie fin de fenêtre NY
// ou au début de la plage de clôture forcée. Comportement identique quand la
// porte Londres est désactivée.
entryWindowEnded = (inNY[1] and not inNY) or (inFlatCore and not inFlatCore[1])

bool newCalendarDayCore = bar_index == 0 or year(time, sessTz) != year(time[1], sessTz) or month(time, sessTz) != month(time[1], sessTz) or dayofmonth(time, sessTz) != dayofmonth(time[1], sessTz)
bool asiaStartCore = inAsiaCore and not inAsiaCore[1]
bool asiaEndCore = not inAsiaCore and inAsiaCore[1]
bool lonStartCore = inLonCore and not inLonCore[1]
bool lonEndCore = not inLonCore and inLonCore[1]
bool orStartCore = inOrCore and not inOrCore[1]
bool orEndCore = not inOrCore and inOrCore[1]

var float coreAsiaHigh = na
var float coreAsiaLow = na
var bool coreAsiaReady = false
var float coreLonHigh = na
var float coreLonLow = na
var bool coreLonReady = false
var float coreOrHigh = na
var float coreOrLow = na
var bool coreOrReady = false
var string lastSweepDiagnostic = ""
var int lastSweepDiagnosticBar = na
// [C8] Extrêmes de la journée, pour savoir si une liquidité cible a déjà été prise.
var float dayHighSoFar = na
var float dayLowSoFar = na
if newCalendarDayCore
    dayHighSoFar := high
    dayLowSoFar := low
else
    dayHighSoFar := na(dayHighSoFar) ? high : math.max(dayHighSoFar, high)
    dayLowSoFar := na(dayLowSoFar) ? low : math.min(dayLowSoFar, low)

if newCalendarDayCore
    // [C11] Les extrêmes d'Asie ne sont PLUS remis à zéro ici. Avec une plage
    // nocturne (18:00-00:00), la fin de session tombe sur la même bougie que le
    // changement de jour NY ; ce reset s'exécutant en premier, il effaçait les
    // extrêmes juste avant que « asiaEndCore » ne les valide, et coreAsiaReady
    // ne passait jamais à true. Le sweep Asie ne se déclenchait donc jamais, et
    // les extrêmes d'Asie disparaissaient aussi de la liste des cibles de
    // liquidité. asiaStartCore réécrit les extrêmes à chaque début de session :
    // ce reset était redondant. Londres et l'OR gardent le leur, ils sont dans
    // la journée NY.
    coreLonHigh := na
    coreLonLow := na
    coreLonReady := false
    coreOrHigh := na
    coreOrLow := na
    coreOrReady := false
    lastSweepDiagnostic := ""
    lastSweepDiagnosticBar := na
if asiaStartCore
    coreAsiaHigh := high
    coreAsiaLow := low
    coreAsiaReady := false
else if inAsiaCore
    coreAsiaHigh := na(coreAsiaHigh) ? high : math.max(coreAsiaHigh, high)
    coreAsiaLow := na(coreAsiaLow) ? low : math.min(coreAsiaLow, low)
if asiaEndCore and not na(coreAsiaHigh)
    coreAsiaReady := true

if lonStartCore
    coreLonHigh := high
    coreLonLow := low
    coreLonReady := false
else if inLonCore
    coreLonHigh := na(coreLonHigh) ? high : math.max(coreLonHigh, high)
    coreLonLow := na(coreLonLow) ? low : math.min(coreLonLow, low)
if lonEndCore and not na(coreLonHigh)
    coreLonReady := true

if orStartCore
    coreOrHigh := high
    coreOrLow := low
    coreOrReady := false
else if inOrCore
    coreOrHigh := na(coreOrHigh) ? high : math.max(coreOrHigh, high)
    coreOrLow := na(coreOrLow) ? low : math.min(coreOrLow, low)
if orEndCore and not na(coreOrHigh)
    coreOrReady := true

// Pivots du timeframe courant : connus uniquement après confirmation.
// Tout dépassement consomme le niveau, même hors session ou sans réintégration.
// Plusieurs niveaux balayés sur une bougie produisent un seul événement par côté.
var array<float> oldHighs = array.new<float>()
var array<int> oldHighBars = array.new<int>()
var array<float> oldLows = array.new<float>()
var array<int> oldLowBars = array.new<int>()
float oldPh = ta.pivothigh(high, oldPivotLen, oldPivotLen)
float oldPl = ta.pivotlow(low, oldPivotLen, oldPivotLen)
float oldBuyLevel = na
float oldSellLevel = na
if confirmed and useOldPivots
    int oh = array.size(oldHighs) - 1
    while oh >= 0
        float level = array.get(oldHighs, oh)
        bool expired = bar_index - array.get(oldHighBars, oh) > oldPivotAge
        bool taken = high > level
        if not expired and taken and close < level and high[1] <= level
            oldBuyLevel := na(oldBuyLevel) ? level : math.max(oldBuyLevel, level)
        if expired or taken
            array.remove(oldHighs, oh)
            array.remove(oldHighBars, oh)
        oh -= 1
    int ol = array.size(oldLows) - 1
    while ol >= 0
        float level = array.get(oldLows, ol)
        bool expired = bar_index - array.get(oldLowBars, ol) > oldPivotAge
        bool taken = low < level
        if not expired and taken and close > level and low[1] >= level
            oldSellLevel := na(oldSellLevel) ? level : math.min(oldSellLevel, level)
        if expired or taken
            array.remove(oldLows, ol)
            array.remove(oldLowBars, ol)
        ol -= 1
    if not na(oldPh)
        array.push(oldHighs, oldPh)
        array.push(oldHighBars, bar_index - oldPivotLen)
    if not na(oldPl)
        array.push(oldLows, oldPl)
        array.push(oldLowBars, bar_index - oldPivotLen)
    if array.size(oldHighs) > oldPivotCap
        array.shift(oldHighs)
        array.shift(oldHighBars)
    if array.size(oldLows) > oldPivotCap
        array.shift(oldLows)
        array.shift(oldLowBars)
bool sweepOldHigh = useOldPivots and not na(oldBuyLevel)
bool sweepOldLow = useOldPivots and not na(oldSellLevel)
float h1SweepHigh = h1RangeHigh[1]
float h1SweepLow = h1RangeLow[1]

// Un emplacement par source : bas PWL/H1/PDL/LON/ASIA/OR/M15 (0-6), puis
// hauts PWH/H1/PDH/LON/ASIA/OR/M15 (7-13). Deux autres pour l'OR-FVG (14-15).
// La mémoire suit le PRIX du niveau, et non le nombre de sweeps par journée :
// une nouvelle source à un nouveau prix redevient fraîche ; le même prix déjà
// franchi reste consommé, y compris au changement de jour NY.
var array<float> sweepTrackedPrice = array.new_float(16, na)
var array<bool> sweepLevelTaken = array.new_bool(16, false)
f_firstCrossAvailable(int _slot, float _level, bool _highSide) =>
    bool wasFresh = false
    if confirmed and not na(_level)
        float previousPrice = array.get(sweepTrackedPrice, _slot)
        bool alreadyTaken = array.get(sweepLevelTaken, _slot)
        if na(previousPrice) or previousPrice != _level
            array.set(sweepTrackedPrice, _slot, _level)
            alreadyTaken := false
        wasFresh := not alreadyTaken
        if _highSide ? high > _level : low < _level
            array.set(sweepLevelTaken, _slot, true)
        else
            array.set(sweepLevelTaken, _slot, alreadyTaken)
    wasFresh

bool freshPwl = f_firstCrossAvailable(0, pwl, false)
bool freshH1Low = f_firstCrossAvailable(1, h1SweepLow, false)
bool freshPdl = f_firstCrossAvailable(2, pdl, false)
bool freshLonLow = f_firstCrossAvailable(3, coreLonReady ? coreLonLow : na, false)
bool freshAsiaLow = f_firstCrossAvailable(4, coreAsiaReady ? coreAsiaLow : na, false)
bool freshOrLow = f_firstCrossAvailable(5, coreOrReady ? coreOrLow : na, false)
bool freshM15Low = f_firstCrossAvailable(6, m15SwingLow, false)
bool freshPwh = f_firstCrossAvailable(7, pwh, true)
bool freshH1High = f_firstCrossAvailable(8, h1SweepHigh, true)
bool freshPdh = f_firstCrossAvailable(9, pdh, true)
bool freshLonHigh = f_firstCrossAvailable(10, coreLonReady ? coreLonHigh : na, true)
bool freshAsiaHigh = f_firstCrossAvailable(11, coreAsiaReady ? coreAsiaHigh : na, true)
bool freshOrHigh = f_firstCrossAvailable(12, coreOrReady ? coreOrHigh : na, true)
bool freshM15High = f_firstCrossAvailable(13, m15SwingHigh, true)

// Premier franchissement autorisé : mèche + réintégration = sweep valide.
// Une clôture au-delà du niveau consomme aussi la source, sans générer de sweep.
bool sweepPwlCore = useWeeklySweep and freshPwl and low < pwl and close > pwl and low[1] >= pwl
bool sweepH1LowCore = useH1Sweep and freshH1Low and low < h1SweepLow and close > h1SweepLow and low[1] >= h1SweepLow
bool sweepPdlCore = usePdSweep and freshPdl and low < pdl and close > pdl and low[1] >= pdl
bool sweepLonLowCore = useLonSweep and freshLonLow and low < coreLonLow and close > coreLonLow and low[1] >= coreLonLow
bool sweepAsiaLowCore = useAsiaSweep and freshAsiaLow and low < coreAsiaLow and close > coreAsiaLow and low[1] >= coreAsiaLow
bool sweepOrLowCore = useOrSweep and freshOrLow and low < coreOrLow and close > coreOrLow and low[1] >= coreOrLow
bool sweepM15LowCore = useM15Sweep and freshM15Low and low < m15SwingLow and close > m15SwingLow and low[1] >= m15SwingLow
bool sweepPwhCore = useWeeklySweep and freshPwh and high > pwh and close < pwh and high[1] <= pwh
bool sweepH1HighCore = useH1Sweep and freshH1High and high > h1SweepHigh and close < h1SweepHigh and high[1] <= h1SweepHigh
bool sweepPdhCore = usePdSweep and freshPdh and high > pdh and close < pdh and high[1] <= pdh
bool sweepLonHighCore = useLonSweep and freshLonHigh and high > coreLonHigh and close < coreLonHigh and high[1] <= coreLonHigh
bool sweepAsiaHighCore = useAsiaSweep and freshAsiaHigh and high > coreAsiaHigh and close < coreAsiaHigh and high[1] <= coreAsiaHigh
bool sweepOrHighCore = useOrSweep and freshOrHigh and high > coreOrHigh and close < coreOrHigh and high[1] <= coreOrHigh
bool sweepM15HighCore = useM15Sweep and freshM15High and high > m15SwingHigh and close < m15SwingHigh and high[1] <= m15SwingHigh

bool anySellSweepCore = sweepPwlCore or sweepH1LowCore or sweepPdlCore or sweepLonLowCore or sweepAsiaLowCore or sweepOrLowCore or sweepM15LowCore
bool anyBuySweepCore = sweepPwhCore or sweepH1HighCore or sweepPdhCore or sweepLonHighCore or sweepAsiaHighCore or sweepOrHighCore or sweepM15HighCore
bool rawSellSideSweep = confirmed and (anySellSweepCore or sweepOldLow)
bool rawBuySideSweep = confirmed and (anyBuySweepCore or sweepOldHigh)
bool strictSellSideSweep = rawSellSideSweep and inSweepCapture
bool strictBuySideSweep = rawBuySideSweep and inSweepCapture

string sellSweepTags = ""
sellSweepTags := f_joinTag(sellSweepTags, "PWL", sweepPwlCore)
sellSweepTags := f_joinTag(sellSweepTags, "H1 L", sweepH1LowCore)
sellSweepTags := f_joinTag(sellSweepTags, "PDL", sweepPdlCore)
sellSweepTags := f_joinTag(sellSweepTags, "LON L", sweepLonLowCore)
sellSweepTags := f_joinTag(sellSweepTags, "ASIA L", sweepAsiaLowCore)
sellSweepTags := f_joinTag(sellSweepTags, "ORL", sweepOrLowCore)
sellSweepTags := f_joinTag(sellSweepTags, "M15 L", sweepM15LowCore)
string buySweepTags = ""
buySweepTags := f_joinTag(buySweepTags, "PWH", sweepPwhCore)
buySweepTags := f_joinTag(buySweepTags, "H1 H", sweepH1HighCore)
buySweepTags := f_joinTag(buySweepTags, "PDH", sweepPdhCore)
buySweepTags := f_joinTag(buySweepTags, "LON H", sweepLonHighCore)
buySweepTags := f_joinTag(buySweepTags, "ASIA H", sweepAsiaHighCore)
buySweepTags := f_joinTag(buySweepTags, "ORH", sweepOrHighCore)
buySweepTags := f_joinTag(buySweepTags, "M15 H", sweepM15HighCore)

int sellSweepCount = (sweepPwlCore ? 1 : 0) + (sweepH1LowCore ? 1 : 0) + (sweepPdlCore ? 1 : 0) + (sweepLonLowCore ? 1 : 0) + (sweepAsiaLowCore ? 1 : 0) + (sweepOrLowCore ? 1 : 0) + (sweepM15LowCore ? 1 : 0)
int buySweepCount = (sweepPwhCore ? 1 : 0) + (sweepH1HighCore ? 1 : 0) + (sweepPdhCore ? 1 : 0) + (sweepLonHighCore ? 1 : 0) + (sweepAsiaHighCore ? 1 : 0) + (sweepOrHighCore ? 1 : 0) + (sweepM15HighCore ? 1 : 0)
string sellSweepPrimary = sweepPwlCore ? "PWL" : sweepH1LowCore ? "H1 L" : sweepPdlCore ? "PDL" : sweepLonLowCore ? "LON L" : sweepAsiaLowCore ? "ASIA L" : sweepOrLowCore ? "ORL" : sweepM15LowCore ? "M15 L" : "–"
string buySweepPrimary = sweepPwhCore ? "PWH" : sweepH1HighCore ? "H1 H" : sweepPdhCore ? "PDH" : sweepLonHighCore ? "LON H" : sweepAsiaHighCore ? "ASIA H" : sweepOrHighCore ? "ORH" : sweepM15HighCore ? "M15 H" : "–"
string sellSweepSource = groupSweepTags ? sellSweepTags : sellSweepPrimary
string buySweepSource = groupSweepTags ? buySweepTags : buySweepPrimary
sellSweepSource := sweepOldLow ? (anySellSweepCore ? sellSweepSource + " + OLD SSL" : "OLD SSL") : sellSweepSource
buySweepSource := sweepOldHigh ? (anyBuySweepCore ? buySweepSource + " + OLD BSL" : "OLD BSL") : buySweepSource
sellSweepSource := groupSweepTags and sellSweepCount > 1 ? sellSweepSource + " · cluster x" + str.tostring(sellSweepCount) : sellSweepSource
buySweepSource := groupSweepTags and buySweepCount > 1 ? buySweepSource + " · cluster x" + str.tostring(buySweepCount) : buySweepSource
float sellSweepLevel = sweepPwlCore ? pwl : sweepH1LowCore ? h1SweepLow : sweepPdlCore ? pdl : sweepLonLowCore ? coreLonLow : sweepAsiaLowCore ? coreAsiaLow : sweepOrLowCore ? coreOrLow : sweepM15LowCore ? m15SwingLow : na
float buySweepLevel = sweepPwhCore ? pwh : sweepH1HighCore ? h1SweepHigh : sweepPdhCore ? pdh : sweepLonHighCore ? coreLonHigh : sweepAsiaHighCore ? coreAsiaHigh : sweepOrHighCore ? coreOrHigh : sweepM15HighCore ? m15SwingHigh : na

string enabledSweepSources = ""
sellSweepLevel := na(sellSweepLevel) ? oldSellLevel : sellSweepLevel
buySweepLevel := na(buySweepLevel) ? oldBuyLevel : buySweepLevel
enabledSweepSources := f_joinTag(enabledSweepSources, "OLD BSL/SSL", useOldPivots)
enabledSweepSources := f_joinTag(enabledSweepSources, "PD", usePdSweep)
enabledSweepSources := f_joinTag(enabledSweepSources, "ASIA", useAsiaSweep)
enabledSweepSources := f_joinTag(enabledSweepSources, "LON", useLonSweep)
enabledSweepSources := f_joinTag(enabledSweepSources, "OR", useOrSweep)
enabledSweepSources := f_joinTag(enabledSweepSources, "M15", useM15Sweep)
enabledSweepSources := f_joinTag(enabledSweepSources, "PW", useWeeklySweep)
enabledSweepSources := f_joinTag(enabledSweepSources, "H1", useH1Sweep)
enabledSweepSources := enabledSweepSources == "" ? "Aucune source active" : enabledSweepSources

if rawSellSideSweep and not inSweepCapture
    lastSweepDiagnostic := "Ignoré hors capture · " + sellSweepSource
    lastSweepDiagnosticBar := bar_index
if rawBuySideSweep and not inSweepCapture
    lastSweepDiagnostic := "Ignoré hors capture · " + buySweepSource
    lastSweepDiagnosticBar := bar_index
if strictSellSideSweep
    lastSweepDiagnostic := "Détecté · " + sellSweepSource
    lastSweepDiagnosticBar := bar_index
if strictBuySideSweep
    lastSweepDiagnostic := "Détecté · " + buySweepSource
    lastSweepDiagnosticBar := bar_index

bool sweepDiagnosticRecent = not na(lastSweepDiagnosticBar) and bar_index - lastSweepDiagnosticBar <= sweepDiagAge
if showSweep and strictSellSideSweep
    f_drawSweep(time[1], sellSweepLevel, sweepSellCol, false)
if showSweep and strictBuySideSweep
    f_drawSweep(time[1], buySweepLevel, sweepBuyCol, true)

// =============================================================================
//  CISD — MOTEUR DE DÉTECTION  (strict + rendu)  [CORRECTIF]
//  Le niveau CISD est l'ouverture de la PREMIÈRE bougie de la série adverse.
//  Deux logiques, sélectionnées par l'input « Logique de détection » :
//
//   · Historique (v2.5.3) — comportement d'origine, conservé à l'identique.
//     Le test n'a lieu que sur la bougie qui inverse la couleur, et le niveau
//     est écrasé juste après, succès ou non. Une clôture au-delà du niveau
//     deux bougies plus tard n'est jamais vue.
//
//   · Persistant (corrigé) — le niveau reste armé et il est testé à CHAQUE
//     bougie clôturée, jusqu'à sa prise ou sa péremption (cisdKeepAge). Il est
//     remplacé dès qu'une nouvelle série adverse se forme.
//
//  Le reste du script n'est pas modifié : la séquence lit toujours
//  strictBullCisd / strictBearCisd, avec la même signification.
// =============================================================================

// --- Logique historique, conservée pour pouvoir comparer les deux en backtest
var int strictCurDir = 0
var float strictRunFirstOpen = na
bool  legacyBullCisd  = false
bool  legacyBearCisd  = false
float legacyBullLevel = na
float legacyBearLevel = na
int   legacyBullStart = na
int   legacyBearStart = na
int   legacyBullArm   = na
int   legacyBearArm   = na
if confirmed
    int strictThisDir = close > open ? 1 : close < open ? -1 : strictCurDir
    if strictThisDir != strictCurDir and strictThisDir != 0
        if strictThisDir == 1 and strictCurDir == -1 and not na(strictRunFirstOpen) and close > strictRunFirstOpen
            legacyBullCisd := true
            legacyBullLevel := strictRunFirstOpen
            legacyBullStart := runStartBar
            legacyBullArm := bar_index
        else if strictThisDir == -1 and strictCurDir == 1 and not na(strictRunFirstOpen) and close < strictRunFirstOpen
            legacyBearCisd := true
            legacyBearLevel := strictRunFirstOpen
            legacyBearStart := runStartBar
            legacyBearArm := bar_index
        strictCurDir := strictThisDir
        strictRunFirstOpen := open
        runStartBar := bar_index

// --- Logique persistante corrigée
// La fonction porte son propre état ; elle DOIT être appelée à chaque bougie.
f_cisdPersistent(int _keepAge, bool _obAtFire) =>
    var int   runDir        = 0
    // [C4] Dernière bougie opposée CLÔTURÉE, mise à jour en fin de bloc afin
    // qu'au moment du test elle désigne toujours une bougie antérieure.
    var float lastDownHi    = na
    var float lastDownLo    = na
    var float lastUpHi      = na
    var float lastUpLo      = na
    var float bearRunOpen   = na
    var float bullRunOpen   = na
    var float bearRunLow    = na
    var float bullRunHigh   = na
    var int   bearRunBar    = na
    var int   bullRunBar    = na
    var float pendBullLvl   = na
    var float pendBullLow   = na
    var int   pendBullBar   = na
    var int   pendBullArm   = na
    var float pendBullObHi  = na
    var float pendBullObLo  = na
    var float pendBearLvl   = na
    var float pendBearHigh  = na
    var int   pendBearBar   = na
    var int   pendBearArm   = na
    var float pendBearObHi  = na
    var float pendBearObLo  = na
    bool  bullEvt        = false
    bool  bearEvt        = false
    float bullLevel      = na
    float bearLevel      = na
    int   bullStart      = na
    int   bearStart      = na
    float outBullRunLow  = na
    float outBearRunHigh = na
    float outBullObHi    = na
    float outBullObLo    = na
    float outBearObHi    = na
    float outBearObLo    = na
    int   outBullArm     = na
    int   outBearArm     = na
    if barstate.isconfirmed
        int thisDir = close > open ? 1 : close < open ? -1 : runDir
        if thisDir != runDir and thisDir != 0
            if thisDir == -1
                // La série haussière qui s'achève arme le niveau du futur CISD baissier.
                // [C1] high[1]/low[1] est ici la DERNIÈRE bougie de cette série
                // haussière : c'est l'order block, et il est figé maintenant.
                if not na(bullRunOpen)
                    pendBearLvl  := bullRunOpen
                    pendBearHigh := bullRunHigh
                    pendBearBar  := bullRunBar
                    pendBearArm  := bar_index
                    pendBearObHi := high[1]
                    pendBearObLo := low[1]
                bearRunOpen := open
                bearRunLow  := low
                bearRunBar  := bar_index
            else
                // La série baissière qui s'achève arme le niveau du futur CISD haussier.
                if not na(bearRunOpen)
                    pendBullLvl := bearRunOpen
                    pendBullLow := bearRunLow
                    pendBullBar := bearRunBar
                    pendBullArm := bar_index
                    pendBullObHi := high[1]
                    pendBullObLo := low[1]
                bullRunOpen := open
                bullRunHigh := high
                bullRunBar  := bar_index
            runDir := thisDir
        else if runDir == -1
            bearRunLow := na(bearRunLow) ? low : math.min(bearRunLow, low)
        else if runDir == 1
            bullRunHigh := na(bullRunHigh) ? high : math.max(bullRunHigh, high)
        // Péremption, comptée depuis l'armement du niveau
        if not na(pendBullLvl) and not na(pendBullArm) and bar_index - pendBullArm > _keepAge
            pendBullLvl := na
        if not na(pendBearLvl) and not na(pendBearArm) and bar_index - pendBearArm > _keepAge
            pendBearLvl := na
        // [CORRECTIF C1] Le niveau est TOUJOURS testé, comme en V2.5.4 — mais il
        // n'est CONSOMMÉ que si la clôture qui le franchit est postérieure à sa
        // bougie d'armement.
        // Avant : le niveau était détruit dès le premier franchissement, y
        // compris sur sa propre bougie d'armement. Or la bougie du sweep est
        // très souvent celle qui retourne la série : l'événement y était donc
        // émis, refusé plus haut par cisdTimeOk (qui exige une bougie
        // postérieure au sweep), et le niveau disparaissait pour de bon. Le
        // setup attendait alors une nouvelle série adverse. Le correctif est
        // strictement additif : aucun CISD auparavant accepté n'est perdu.
        if not na(pendBullLvl) and close > pendBullLvl
            bullEvt       := true
            bullLevel     := pendBullLvl
            bullStart     := pendBullBar
            outBullRunLow := pendBullLow
            // [C4] OB = dernière bougie baissière avant le déplacement haussier.
            outBullObHi   := _obAtFire ? nz(lastDownHi, pendBullObHi) : pendBullObHi
            outBullObLo   := _obAtFire ? nz(lastDownLo, pendBullObLo) : pendBullObLo
            outBullArm    := pendBullArm
            if na(pendBullArm) or bar_index > pendBullArm
                pendBullLvl := na
        if not na(pendBearLvl) and close < pendBearLvl
            bearEvt        := true
            bearLevel      := pendBearLvl
            bearStart      := pendBearBar
            outBearRunHigh := pendBearHigh
            outBearObHi    := _obAtFire ? nz(lastUpHi, pendBearObHi) : pendBearObHi
            outBearObLo    := _obAtFire ? nz(lastUpLo, pendBearObLo) : pendBearObLo
            outBearArm     := pendBearArm
            if na(pendBearArm) or bar_index > pendBearArm
                pendBearLvl := na
        // Mise à jour APRÈS le test : la bougie courante ne peut pas être son
        // propre order block.
        if close < open
            lastDownHi := high
            lastDownLo := low
        else if close > open
            lastUpHi := high
            lastUpLo := low
    [bullEvt, bearEvt, bullLevel, bearLevel, bullStart, bearStart, outBullRunLow, outBearRunHigh, outBullObHi, outBullObLo, outBearObHi, outBearObLo, outBullArm, outBearArm]

[persBullCisd, persBearCisd, persBullLevel, persBearLevel, persBullStart, persBearStart, persBullRunLow, persBearRunHigh, persBullObHi, persBullObLo, persBearObHi, persBearObLo, persBullArm, persBearArm] = f_cisdPersistent(cisdKeepAge, obSource == "Dernière bougie opposée avant le déplacement")

// --- Sélection : c'est le seul endroit qui décide quelle logique s'applique
bool useLegacyCisd = cisdMode == "Historique (v2.5.3)"
bool rawBullCisd = useLegacyCisd ? legacyBullCisd : persBullCisd
bool rawBearCisd = useLegacyCisd ? legacyBearCisd : persBearCisd
// Deux niveaux opposés peuvent rester armés en mode persistant. Si une clôture
// les franchit simultanément, la lecture est ambiguë : aucun sens n'est retenu.
bool cisdAmbiguous = rawBullCisd and rawBearCisd
strictBullCisd = rawBullCisd and not cisdAmbiguous
strictBearCisd = rawBearCisd and not cisdAmbiguous
float cisdBullLevel   = useLegacyCisd ? legacyBullLevel : persBullLevel
float cisdBearLevel   = useLegacyCisd ? legacyBearLevel : persBearLevel
int   cisdBullStart   = useLegacyCisd ? legacyBullStart : persBullStart
int   cisdBearStart   = useLegacyCisd ? legacyBearStart : persBearStart
int   cisdBullArm     = useLegacyCisd ? legacyBullArm : persBullArm
int   cisdBearArm     = useLegacyCisd ? legacyBearArm : persBearArm
float cisdBullRunLow  = useLegacyCisd ? na : persBullRunLow
float cisdBearRunHigh = useLegacyCisd ? na : persBearRunHigh
// [CORRECTIF C1] Order block de déplacement : dernière bougie de la série adverse.
// En mode Historique le CISD tombe toujours sur la bougie de retournement, donc
// high[1]/low[1] y est déjà la bonne bougie et le comportement ne change pas.
float cisdBullObHigh = useLegacyCisd ? high[1] : nz(persBullObHi, high[1])
float cisdBullObLow  = useLegacyCisd ? low[1]  : nz(persBullObLo, low[1])
float cisdBearObHigh = useLegacyCisd ? high[1] : nz(persBearObHi, high[1])
float cisdBearObLow  = useLegacyCisd ? low[1]  : nz(persBearObLo, low[1])

// Diagnostics bruts dans la fenêtre de données uniquement. Le rendu et les
// alertes sont effectués plus bas, après validation par la séquence active.
plot(strictBullCisd ? 1 : strictBearCisd ? -1 : 0, "CISD · Signal brut non ambigu (+1/−1)", display = display.data_window)
plot(cisdAmbiguous ? 1 : 0, "CISD · Conflit brut", display = display.data_window)
plot(cisdBullLevel, "CISD · Niveau haussier repris", display = display.data_window)
plot(cisdBearLevel, "CISD · Niveau baissier cassé", display = display.data_window)

atrCore = ta.atr(14)
displacementCore = math.abs(close - open) >= bodyAtrMin * atrCore or high - low >= rangeAtrMin * atrCore

// =============================================================================
//  FVG RÉCENTS ET ÉVÉNEMENTS D'INVERSION IFVG
// =============================================================================
var array<float> coreFvgTops = array.new_float()
var array<float> coreFvgBots = array.new_float()
var array<int> coreFvgDirs = array.new_int()
var array<int> coreFvgBars = array.new_int()
// [C2] `var` et non `varip` : tout ce bloc ne tourne que sur bougie clôturée,
// et `varip` empêchait la restauration correcte de l'état après un rollback.
var int coreLastFvgBuildBar = na
bool coreFirstFvgCalc = na(coreLastFvgBuildBar) or coreLastFvgBuildBar != bar_index

// [R1] Événement ponctuel : FVG créé sur la bougie clôturée courante. Ces
// valeurs servent uniquement aux modes de recherche « FVG directionnel ».
// Un ancien FVG ne peut donc pas être recyclé après un CISD plus récent.
bool strictBullDirectionalFvg = false
bool strictBearDirectionalFvg = false
float strictBullDirectionalFvgTop = na
float strictBullDirectionalFvgBot = na
float strictBearDirectionalFvgTop = na
float strictBearDirectionalFvgBot = na

if confirmed and bar_index >= 2 and coreFirstFvgCalc
    float bullGapCore = low - high[2]
    float bearGapCore = low[2] - high
    if low > high[2] and bullGapCore >= fvgMinTicks
        array.push(coreFvgTops, low)
        array.push(coreFvgBots, high[2])
        array.push(coreFvgDirs, 1)
        array.push(coreFvgBars, bar_index)
        strictBullDirectionalFvg := true
        strictBullDirectionalFvgTop := low
        strictBullDirectionalFvgBot := high[2]
    if high < low[2] and bearGapCore >= fvgMinTicks
        array.push(coreFvgTops, low[2])
        array.push(coreFvgBots, high)
        array.push(coreFvgDirs, -1)
        array.push(coreFvgBars, bar_index)
        strictBearDirectionalFvg := true
        strictBearDirectionalFvgTop := low[2]
        strictBearDirectionalFvgBot := high
    coreLastFvgBuildBar := bar_index

strictBullIfvg = false
strictBearIfvg = false
float strictBullIfvgTop = na
float strictBullIfvgBot = na
float strictBearIfvgTop = na
float strictBearIfvgBot = na
// [C12] Bougie de création du FVG retenu, pour pouvoir exiger qu'il soit
// postérieur au sweep.
int strictBullIfvgBar = na
int strictBearIfvgBar = na
// [CORRECTIF C2] Tout ce bloc s'exécutait à CHAQUE tick de la bougie en cours.
// Pine restaure les variables scalaires `var` entre les ticks, mais PAS le
// contenu des tableaux : un FVG invalidé par une mèche intra-bougie était
// retiré du tableau pour de bon, même si la bougie clôturait finalement à
// l'intérieur du gap. Le signal IFVG (et donc l'étape 3) était alors perdu
// sans trace. Le moteur ne travaille plus que sur bougies clôturées, comme le
// module IFVG visuel qui, lui, était déjà correctement protégé.
if confirmed
    while array.size(coreFvgBars) > 200
        array.shift(coreFvgTops)
        array.shift(coreFvgBots)
        array.shift(coreFvgDirs)
        array.shift(coreFvgBars)
    int coreZ = array.size(coreFvgBars) - 1
    while coreZ >= 0
        int coreCreated = array.get(coreFvgBars, coreZ)
        float coreTop = array.get(coreFvgTops, coreZ)
        float coreBot = array.get(coreFvgBots, coreZ)
        int coreDir = array.get(coreFvgDirs, coreZ)
        bool coreTooOld = bar_index - coreCreated > fvgKeepAge
        bool coreBullInvert = not coreTooOld and bar_index > coreCreated and coreDir == -1 and close > coreTop
        bool coreBearInvert = not coreTooOld and bar_index > coreCreated and coreDir == 1 and close < coreBot
        if coreBullInvert and not strictBullIfvg
            strictBullIfvg := true
            strictBullIfvgTop := coreTop
            strictBullIfvgBot := coreBot
            strictBullIfvgBar := coreCreated
        if coreBearInvert and not strictBearIfvg
            strictBearIfvg := true
            strictBearIfvgTop := coreTop
            strictBearIfvgBot := coreBot
            strictBearIfvgBar := coreCreated
        if coreTooOld or coreBullInvert or coreBearInvert
            array.remove(coreFvgTops, coreZ)
            array.remove(coreFvgBots, coreZ)
            array.remove(coreFvgDirs, coreZ)
            array.remove(coreFvgBars, coreZ)
        coreZ -= 1

// Étapes du setup : un seul groupe actif par défaut, avec historique borné.
var array<label> stageLabels = array.new<label>()
f_clearStageLabels(array<label> _labels) =>
    while array.size(_labels) > 0
        label.delete(array.pop(_labels))
    int(na)

f_pushStageLabel(array<label> _labels, int _x, float _y, string _txt, string _style, color _bg, color _txtCol, string _size, bool _newSetup) =>
    if _newSetup and not keepStageHistory
        f_clearStageLabels(_labels)
    bool emphasizeGo = str.startswith(_txt, "GO")
    string renderedStyle = cleanDisplay ? label.style_none : emphasizeGo ? _style : label.style_none
    color renderedBg = cleanDisplay ? color.new(_bg, 100) : emphasizeGo ? _bg : color.new(_bg, 100)
    color renderedText = cleanDisplay and emphasizeGo ? color.new(_bg, 0) : _txtCol
    label lb = label.new(_x, _y, _txt, style = renderedStyle, color = renderedBg, textcolor = renderedText, size = _size)
    array.push(_labels, lb)
    while array.size(_labels) > stageMaxLabels
        label.delete(array.shift(_labels))
    int(na)

// =============================================================================
//  SÉQUENCES DIRECTIONNELLES
//  0 = aucune, 1 = sweep, 2 = CISD, 3 = plan prêt, 4 = niveau déclenché
// =============================================================================
// [V2.5.11] Éléments de notation du setup. Aucun n'intervient dans une
// décision : ils servent uniquement à attribuer la note A+ / A / B+ / B / C.
var bool lSweepPdAligned = false
var bool sSweepPdAligned = false
var bool lSmtAtSweep = false
var bool sSmtAtSweep = false
var bool lMssSeen = false
var bool sMssSeen = false
var string lGrade = "–"
var string sGrade = "–"
var int lStage = 0
var int lSweepBar = na
var float lSweepExtreme = na
var float lSweepLevel = na
var string lSweepSource = ""
var int lCisdBar = na
var int lPoiBar = na
var float lPoiTop = na
var float lPoiBot = na
var string lPoiName = ""
var float lLimit = na
var float lStop = na
var float lTp1 = na
var float lTp2 = na
var float lLiquidity = na

// [Entrée directe] état séparé : ne touche jamais lLimit/lStop/lTp1/lTp2/lLiquidity.
var float lDirectEntry = na
var float lDirectStop = na
var float lDirectTp1 = na
var float lDirectTp2 = na
var float lDirectLiquidity = na
var int lDirectBar = na

var int sStage = 0
var int sSweepBar = na
var float sSweepExtreme = na
var float sSweepLevel = na
var string sSweepSource = ""
var int sCisdBar = na
var int sPoiBar = na
var float sPoiTop = na
var float sPoiBot = na
var string sPoiName = ""
var float sLimit = na
var float sStop = na
var float sTp1 = na
var float sTp2 = na
var float sLiquidity = na

// [Entrée directe] état séparé, symétrique du bloc Long ci-dessus.
var float sDirectEntry = na
var float sDirectStop = na
var float sDirectTp1 = na
var float sDirectTp2 = na
var float sDirectLiquidity = na
var int sDirectBar = na

// Route additive : deux confirmations distinctes parmi SMT, CISD et MSS.
// 0 = collecte, 1 = confirmations acquises / attente POI,
// 2 = plan prêt / attente retour, 3 = GO déjà émis.
var int altLStage = 0
var int altSStage = 0
var int altLStartBar = na
var int altSStartBar = na
var int altLConfirmBar = na
var int altSConfirmBar = na
var bool altLSmt = false
var bool altLCisd = false
var bool altLMss = false
var bool altSSmt = false
var bool altSCisd = false
var bool altSMss = false
var float altLExtreme = na
var float altSExtreme = na
var int altLPoiBar = na
var int altSPoiBar = na
var float altLPoiTop = na
var float altLPoiBot = na
var float altSPoiTop = na
var float altSPoiBot = na
var string altLPoiName = ""
var string altSPoiName = ""
var float altLLimit = na
var float altSLimit = na
var float altLStop = na
var float altSStop = na
var float altLTp1 = na
var float altSTp1 = na
var float altLTp2 = na
var float altSTp2 = na
var float altLLiquidity = na
var float altSLiquidity = na
var int altLScore = 0
var int altSScore = 0
var string altLGrade = "–"
var string altSGrade = "–"

var int strictSignalsToday = 0
var string lastRejectReason = ""
if newCalendarDayCore
    strictSignalsToday := 0
    lStage := 0
    sStage := 0
    lLimit := na
    sLimit := na
    altLStage := 0
    altSStage := 0
    altLStartBar := na
    altSStartBar := na
    altLLimit := na
    altSLimit := na
    lastRejectReason := ""
    if not keepStageHistory
        f_clearStageLabels(stageLabels)

bool lExpired = (lStage == 1 and bar_index - lSweepBar > sweepMaxAge) or (lStage == 2 and (bar_index - lSweepBar > sweepMaxAge or bar_index - lCisdBar > cisdMaxAge)) or (lStage == 3 and bar_index - lPoiBar > poiMaxAge)
bool sExpired = (sStage == 1 and bar_index - sSweepBar > sweepMaxAge) or (sStage == 2 and (bar_index - sSweepBar > sweepMaxAge or bar_index - sCisdBar > cisdMaxAge)) or (sStage == 3 and bar_index - sPoiBar > poiMaxAge)
if lExpired
    lastSweepDiagnostic := "Expiré · " + lSweepSource
    lastSweepDiagnosticBar := bar_index
    lStage := 0
    lLimit := na
else if entryWindowEnded and lStage == 3
    lStage := 0
    lLimit := na
if sExpired
    lastSweepDiagnostic := "Expiré · " + sSweepSource
    lastSweepDiagnosticBar := bar_index
    sStage := 0
    sLimit := na
else if entryWindowEnded and sStage == 3
    sStage := 0
    sLimit := na

if strictSellSideSweep
    // [V2.5.11] Le sweep est-il pris dans la bonne moitié de la range H1 ?
    // C'est ce qui distingue un A+ d'un A.
    lSweepPdAligned := not na(h1MidDisplay) and low <= h1MidDisplay
    lSmtAtSweep := smtRecent and lastSmtDir == 1
    lMssSeen := false
    lStage := 1
    lSweepBar := bar_index
    lSweepExtreme := low
    lSweepLevel := sellSweepLevel
    lSweepSource := sellSweepSource
    lCisdBar := na
    lPoiBar := na
    lLimit := na
    lastRejectReason := ""
    if showStageLabels
        f_pushStageLabel(stageLabels, bar_index, low, "1 · SWEEP " + sellSweepSource, label.style_label_up, color.new(sweepSellCol, 72), sweepSellCol, size.tiny, true)
if strictBuySideSweep
    sSweepPdAligned := not na(h1MidDisplay) and high >= h1MidDisplay
    sSmtAtSweep := smtRecent and lastSmtDir == -1
    sMssSeen := false
    sStage := 1
    sSweepBar := bar_index
    sSweepExtreme := high
    sSweepLevel := buySweepLevel
    sSweepSource := buySweepSource
    sCisdBar := na
    sPoiBar := na
    sLimit := na
    lastRejectReason := ""
    if showStageLabels
        f_pushStageLabel(stageLabels, bar_index, high, "1 · SWEEP " + buySweepSource, label.style_label_down, color.new(sweepBuyCol, 72), sweepBuyCol, size.tiny, true)

// =============================================================================
//  [CORRECTIF C9] SWEEP RÉACCEPTÉ
//  Cas observé : sweep de l'ORH à 14:25, puis le prix repasse au-dessus du
//  niveau et y reste 30 minutes pour faire un sommet nettement plus haut, avant
//  le CISD. En V2.5.4, `sSweepExtreme` restait figé sur la bougie du sweep : le
//  stop structurel (`sSweepExtreme + buffer`) se plaçait donc SOUS un sommet
//  déjà coté, à l'intérieur d'une zone traversée. Le stop de volatilité pouvait
//  masquer le problème, mais dès que le POI se forme plus bas dans la jambe,
//  c'est le stop structurel qui l'emporte.
// =============================================================================
// Stop suiveur : l'extrême retenu ne peut que s'éloigner du prix.
if confirmed and trailSweepExtreme and lStage >= 1 and lStage <= 3 and not na(lSweepExtreme)
    lSweepExtreme := math.min(lSweepExtreme, low)
if confirmed and trailSweepExtreme and sStage >= 1 and sStage <= 3 and not na(sSweepExtreme)
    sSweepExtreme := math.max(sSweepExtreme, high)

// [C14] Une seule clôture légèrement du mauvais côté est tolérée. La séquence
// est annulée seulement après N clôtures consécutives. Le compteur revient à
// zéro dès que le prix clôture de nouveau du bon côté ou que la séquence cesse.
var int lReclaimCloses = 0
var int sReclaimCloses = 0
bool lReclaimActive = lStage >= 1 and lStage <= 3 and not na(lSweepLevel)
bool sReclaimActive = sStage >= 1 and sStage <= 3 and not na(sSweepLevel)
if confirmed
    lReclaimCloses := lReclaimActive and close < lSweepLevel ? lReclaimCloses + 1 : 0
    sReclaimCloses := sReclaimActive and close > sSweepLevel ? sReclaimCloses + 1 : 0
bool longSweepReclaimed = invalidateOnReclaim and confirmed and lReclaimActive and lReclaimCloses >= reclaimConfirmCloses
bool shortSweepReclaimed = invalidateOnReclaim and confirmed and sReclaimActive and sReclaimCloses >= reclaimConfirmCloses
if longSweepReclaimed
    lastRejectReason := "Sweep Long invalidé · reprise confirmée x" + str.tostring(reclaimConfirmCloses)
    lastSweepDiagnostic := "Repris x" + str.tostring(reclaimConfirmCloses) + " · " + lSweepSource
    lastSweepDiagnosticBar := bar_index
    lStage := 0
    lLimit := na
    lReclaimCloses := 0
if shortSweepReclaimed
    lastRejectReason := "Sweep Short invalidé · reprise confirmée x" + str.tostring(reclaimConfirmCloses)
    lastSweepDiagnostic := "Repris x" + str.tostring(reclaimConfirmCloses) + " · " + sSweepSource
    lastSweepDiagnosticBar := bar_index
    sStage := 0
    sLimit := na
    sReclaimCloses := 0

longCisdAdvanced = false
shortCisdAdvanced = false
bool cisdAnchorOkLong = not cisdAnchorSweep or useLegacyCisd or (not na(cisdBullRunLow) and not na(lSweepExtreme) and cisdBullRunLow <= lSweepExtreme + cisdAnchorTol * atrCore)
bool cisdAnchorOkShort = not cisdAnchorSweep or useLegacyCisd or (not na(cisdBearRunHigh) and not na(sSweepExtreme) and cisdBearRunHigh >= sSweepExtreme - cisdAnchorTol * atrCore)
// Le niveau doit avoir été armé sur la bougie du sweep ou après. Cela empêche
// un vieux CISD, formé avant la liquidité active, d'être attribué au nouveau setup.
bool cisdArmOkLong = lStage == 1 and not na(cisdBullArm) and not na(lSweepBar) and cisdBullArm >= lSweepBar
bool cisdArmOkShort = sStage == 1 and not na(cisdBearArm) and not na(sSweepBar) and cisdBearArm >= sSweepBar
bool cisdTimeOkLong = lStage == 1 and not na(lSweepBar) and (bar_index > lSweepBar or (cisdSameBar and bar_index == lSweepBar))
bool cisdTimeOkShort = sStage == 1 and not na(sSweepBar) and (bar_index > sSweepBar or (cisdSameBar and bar_index == sSweepBar))
if lStage == 1 and inSequence and strictBullCisd and cisdTimeOkLong and cisdArmOkLong and cisdAnchorOkLong
    lStage := 2
    lCisdBar := bar_index
    longCisdAdvanced := true
    if showStageLabels
        f_pushStageLabel(stageLabels, bar_index, low, "2 · CISD +", label.style_label_up, color.new(cisdBullCol, 72), cisdBullCol, size.tiny, false)
if sStage == 1 and inSequence and strictBearCisd and cisdTimeOkShort and cisdArmOkShort and cisdAnchorOkShort
    sStage := 2
    sCisdBar := bar_index
    shortCisdAdvanced := true
    if showStageLabels
        f_pushStageLabel(stageLabels, bar_index, high, "2 · CISD −", label.style_label_down, color.new(cisdBearCol, 72), cisdBearCol, size.tiny, false)

// Seuls les CISD qui ont réellement fait avancer la séquence sont visibles et
// mémorisés. Masquer le module graphique ne change pas l'état du moteur.
if longCisdAdvanced
    cisdBullEvt := true
    lastCisdBar := bar_index
    lastCisdDir := 1
    if showCISD and not na(cisdBullLevel)
        f_pushCISD(cisdBullLevel, nz(cisdBullStart, bar_index), true)
if shortCisdAdvanced
    cisdBearEvt := true
    lastCisdBar := bar_index
    lastCisdDir := -1
    if showCISD and not na(cisdBearLevel)
        f_pushCISD(cisdBearLevel, nz(cisdBearStart, bar_index), false)

plot(longCisdAdvanced ? 1 : shortCisdAdvanced ? -1 : 0, "CISD · Signal accepté après sweep (+1/−1)", display = display.data_window)

bool poiAllowsDirectionalFvg = poiMode == "FVG directionnel ou IFVG" or poiMode == "FVG directionnel, IFVG ou OB"
bool poiAllowsDisplacementOb = poiMode == "IFVG ou OB" or poiMode == "FVG directionnel, IFVG ou OB"

// [R1] Ordre de priorité expérimental : FVG directionnel, puis IFVG, puis OB.
// Le FVG doit naître sur la bougie du CISD accepté ou sur une bougie ultérieure.
if lStage == 2 and inSequence and poiAllowsDirectionalFvg and strictBullDirectionalFvg and not na(lCisdBar) and bar_index >= lCisdBar
    lStage := 3
    lPoiBar := bar_index
    lPoiTop := strictBullDirectionalFvgTop
    lPoiBot := strictBullDirectionalFvgBot
    lPoiName := "FVG haussier directionnel"
    lLimit := na
if sStage == 2 and inSequence and poiAllowsDirectionalFvg and strictBearDirectionalFvg and not na(sCisdBar) and bar_index >= sCisdBar
    sStage := 3
    sPoiBar := bar_index
    sPoiTop := strictBearDirectionalFvgTop
    sPoiBot := strictBearDirectionalFvgBot
    sPoiName := "FVG baissier directionnel"
    sLimit := na
bool ifvgFreshLong = not ifvgAfterSweep or na(lSweepBar) or nz(strictBullIfvgBar, bar_index) >= lSweepBar
bool ifvgFreshShort = not ifvgAfterSweep or na(sSweepBar) or nz(strictBearIfvgBar, bar_index) >= sSweepBar
if lStage == 2 and inSequence and strictBullIfvg and bar_index > lCisdBar and ifvgFreshLong
    lStage := 3
    lPoiBar := bar_index
    lPoiTop := strictBullIfvgTop
    lPoiBot := strictBullIfvgBot
    lPoiName := "IFVG haussier"
    lLimit := na
if sStage == 2 and inSequence and strictBearIfvg and bar_index > sCisdBar and ifvgFreshShort
    sStage := 3
    sPoiBar := bar_index
    sPoiTop := strictBearIfvgTop
    sPoiBot := strictBearIfvgBot
    sPoiName := "IFVG baissier"
    sLimit := na

// Le mode de production « IFVG ou OB » conserve le même comportement :
// l'OB de déplacement est retenu sur la bougie qui fait accepter le CISD.
if lStage == 2 and inSequence and poiAllowsDisplacementOb and displacementCore and longCisdAdvanced
    lStage := 3
    lPoiBar := bar_index
    lPoiTop := cisdBullObHigh
    lPoiBot := cisdBullObLow
    lPoiName := "OB déplacement"
    lLimit := na
if sStage == 2 and inSequence and poiAllowsDisplacementOb and displacementCore and shortCisdAdvanced
    sStage := 3
    sPoiBar := bar_index
    sPoiTop := cisdBearObHigh
    sPoiBot := cisdBearObLow
    sPoiName := "OB déplacement"
    sLimit := na

// =============================================================================
//  ROUTE ADDITIVE : 2/3 SMT + CISD + MSS -> PREMIER POI FRAIS -> RETOUR
//  Cette route ne modifie et ne bloque aucun état du moteur Sweep/CISD existant.
// =============================================================================
if confirmed and altEnabled
    bool altLExpiredConfirm = not na(altLStartBar) and altLStage <= 1 and bar_index - altLStartBar > altConfirmBars
    bool altSExpiredConfirm = not na(altSStartBar) and altSStage <= 1 and bar_index - altSStartBar > altConfirmBars
    bool altLExpiredPoi = altLStage == 2 and not na(altLPoiBar) and bar_index - altLPoiBar > altPoiMaxAge
    bool altSExpiredPoi = altSStage == 2 and not na(altSPoiBar) and bar_index - altSPoiBar > altPoiMaxAge
    if altLExpiredConfirm or altLExpiredPoi or entryWindowEnded
        altLStage := 0
        altLStartBar := na
        altLSmt := false
        altLCisd := false
        altLMss := false
        altLLimit := na
    if altSExpiredConfirm or altSExpiredPoi or entryWindowEnded
        altSStage := 0
        altSStartBar := na
        altSSmt := false
        altSCisd := false
        altSMss := false
        altSLimit := na

    bool altBullConfirmation = smtBullEvt or strictBullCisd or mssBullEvt
    bool altBearConfirmation = smtBearEvt or strictBearCisd or mssBearEvt
    if inSequence and altBullConfirmation and altLStage <= 1
        if na(altLStartBar)
            altLStartBar := bar_index
            altLExtreme := low
            altLSmt := false
            altLCisd := false
            altLMss := false
        altLSmt := altLSmt or smtBullEvt
        altLCisd := altLCisd or strictBullCisd
        altLMss := altLMss or mssBullEvt
        altLExtreme := math.min(nz(altLExtreme, low), low)
        int altLConfirmCount = (altLSmt ? 1 : 0) + (altLCisd ? 1 : 0) + (altLMss ? 1 : 0)
        if altLConfirmCount >= 2 and altLStage == 0
            altLStage := 1
            altLConfirmBar := bar_index
            if altShowLabels and showStageLabels
                f_pushStageLabel(stageLabels, bar_index, low, "ALT 2/3 · " + (altLSmt ? "SMT " : "") + (altLCisd ? "CISD " : "") + (altLMss ? "MSS" : ""), label.style_none, color.new(#7e57c2, 100), #7e57c2, size.tiny, false)
    if inSequence and altBearConfirmation and altSStage <= 1
        if na(altSStartBar)
            altSStartBar := bar_index
            altSExtreme := high
            altSSmt := false
            altSCisd := false
            altSMss := false
        altSSmt := altSSmt or smtBearEvt
        altSCisd := altSCisd or strictBearCisd
        altSMss := altSMss or mssBearEvt
        altSExtreme := math.max(nz(altSExtreme, high), high)
        int altSConfirmCount = (altSSmt ? 1 : 0) + (altSCisd ? 1 : 0) + (altSMss ? 1 : 0)
        if altSConfirmCount >= 2 and altSStage == 0
            altSStage := 1
            altSConfirmBar := bar_index
            if altShowLabels and showStageLabels
                f_pushStageLabel(stageLabels, bar_index, high, "ALT 2/3 · " + (altSSmt ? "SMT " : "") + (altSCisd ? "CISD " : "") + (altSMss ? "MSS" : ""), label.style_none, color.new(#7e57c2, 100), #7e57c2, size.tiny, false)

    if not na(altLStartBar) and altLStage <= 2
        altLExtreme := math.min(nz(altLExtreme, low), low)
    if not na(altSStartBar) and altSStage <= 2
        altSExtreme := math.max(nz(altSExtreme, high), high)

    // Le premier type disponible gagne. Priorité déterministe : FVG, IFVG, OB.
    if altLStage == 1 and bar_index >= altLConfirmBar
        if strictBullDirectionalFvg
            altLPoiTop := strictBullDirectionalFvgTop
            altLPoiBot := strictBullDirectionalFvgBot
            altLPoiName := "FVG"
            altLPoiBar := bar_index
            altLStage := 2
        else if strictBullIfvg
            altLPoiTop := strictBullIfvgTop
            altLPoiBot := strictBullIfvgBot
            altLPoiName := "IFVG"
            altLPoiBar := bar_index
            altLStage := 2
        else if strictBullCisd and displacementCore
            altLPoiTop := cisdBullObHigh
            altLPoiBot := cisdBullObLow
            altLPoiName := "OB"
            altLPoiBar := bar_index
            altLStage := 2
    if altSStage == 1 and bar_index >= altSConfirmBar
        if strictBearDirectionalFvg
            altSPoiTop := strictBearDirectionalFvgTop
            altSPoiBot := strictBearDirectionalFvgBot
            altSPoiName := "FVG"
            altSPoiBar := bar_index
            altSStage := 2
        else if strictBearIfvg
            altSPoiTop := strictBearIfvgTop
            altSPoiBot := strictBearIfvgBot
            altSPoiName := "IFVG"
            altSPoiBar := bar_index
            altSStage := 2
        else if strictBearCisd and displacementCore
            altSPoiTop := cisdBearObHigh
            altSPoiBot := cisdBearObLow
            altSPoiName := "OB"
            altSPoiBar := bar_index
            altSStage := 2

    if altLStage == 2 and na(altLLimit)
        altLLimit := altLPoiTop - (poiEntryPct / 100.0) * (altLPoiTop - altLPoiBot)
        altLStop := math.min(altLExtreme - slBufTicks * syminfo.mintick, altLLimit - minStopAtr * atrCore)
        altLTp1 := altLLimit + tp1R * (altLLimit - altLStop)
        altLTp2 := altLLimit + minRR * (altLLimit - altLStop)
        altLLiquidity := f_closestAbove(altLLimit, altLStop, minRR, pdh, coreAsiaHigh, coreLonHigh, coreOrHigh, m15SwingHigh, pwh, h1RangeHigh)
        altLLiquidity := na(altLLiquidity) ? altLTp2 : altLLiquidity
        bool altLStrongSweep = lStage >= 1 and not na(lSweepBar) and bar_index - lSweepBar <= altConfirmBars and (str.contains(lSweepSource, "PWL") or str.contains(lSweepSource, "PDL"))
        bool altLSessionSweep = lStage >= 1 and not na(lSweepBar) and bar_index - lSweepBar <= altConfirmBars and (str.contains(lSweepSource, "ASIA") or str.contains(lSweepSource, "LON") or str.contains(lSweepSource, "ORL"))
        bool altLMinorSweep = lStage >= 1 and not na(lSweepBar) and bar_index - lSweepBar <= altConfirmBars and not altLStrongSweep and not altLSessionSweep
        altLScore := (altLStrongSweep ? 3 : altLSessionSweep ? 2 : altLMinorSweep ? 1 : 0) + (altLSmt ? 2 : 0) + (altLCisd ? 1 : 0) + (altLMss ? 2 : 0) + (altLPoiName == "FVG" and displacementCore ? 1 : 0) + (not na(h1MidDisplay) and altLLimit <= h1MidDisplay ? 1 : 0) + (bias == 1 ? 1 : 0)
        altLGrade := f_scoreGrade(altLScore)
        if altShowLabels and showStageLabels and not (cleanDisplay and showTrade)
            f_pushStageLabel(stageLabels, bar_index, altLLimit, "ALT " + altLPoiName + " @" + poiEntryMode + " · " + altLGrade + " " + str.tostring(altLScore) + "pt", label.style_none, color.new(#00bcd4, 100), color.aqua, size.tiny, false)
    if altSStage == 2 and na(altSLimit)
        altSLimit := altSPoiBot + (poiEntryPct / 100.0) * (altSPoiTop - altSPoiBot)
        altSStop := math.max(altSExtreme + slBufTicks * syminfo.mintick, altSLimit + minStopAtr * atrCore)
        altSTp1 := altSLimit - tp1R * (altSStop - altSLimit)
        altSTp2 := altSLimit - minRR * (altSStop - altSLimit)
        altSLiquidity := f_closestBelow(altSLimit, altSStop, minRR, pdl, coreAsiaLow, coreLonLow, coreOrLow, m15SwingLow, pwl, h1RangeLow)
        altSLiquidity := na(altSLiquidity) ? altSTp2 : altSLiquidity
        bool altSStrongSweep = sStage >= 1 and not na(sSweepBar) and bar_index - sSweepBar <= altConfirmBars and (str.contains(sSweepSource, "PWH") or str.contains(sSweepSource, "PDH"))
        bool altSSessionSweep = sStage >= 1 and not na(sSweepBar) and bar_index - sSweepBar <= altConfirmBars and (str.contains(sSweepSource, "ASIA") or str.contains(sSweepSource, "LON") or str.contains(sSweepSource, "ORH"))
        bool altSMinorSweep = sStage >= 1 and not na(sSweepBar) and bar_index - sSweepBar <= altConfirmBars and not altSStrongSweep and not altSSessionSweep
        altSScore := (altSStrongSweep ? 3 : altSSessionSweep ? 2 : altSMinorSweep ? 1 : 0) + (altSSmt ? 2 : 0) + (altSCisd ? 1 : 0) + (altSMss ? 2 : 0) + (altSPoiName == "FVG" and displacementCore ? 1 : 0) + (not na(h1MidDisplay) and altSLimit >= h1MidDisplay ? 1 : 0) + (bias == -1 ? 1 : 0)
        altSGrade := f_scoreGrade(altSScore)
        if altShowLabels and showStageLabels and not (cleanDisplay and showTrade)
            f_pushStageLabel(stageLabels, bar_index, altSLimit, "ALT " + altSPoiName + " @" + poiEntryMode + " · " + altSGrade + " " + str.tostring(altSScore) + "pt", label.style_none, color.new(#e040fb, 100), #e040fb, size.tiny, false)

newLongPlan = false
newShortPlan = false
newLongDirectPlan = false
newShortDirectPlan = false
float stopBuffer = slBufTicks * syminfo.mintick
if lStage == 3 and na(lLimit)
    // [V2.5.10] Long : le prix descend dans la zone, le premier contact est le HAUT.
    float candidateLimitLong = lPoiTop - (poiEntryPct / 100.0) * (lPoiTop - lPoiBot)
    float structuralStopLong = lSweepExtreme - stopBuffer
    float volatilityStopLong = candidateLimitLong - minStopAtr * atrCore
    float candidateStopLong = math.min(structuralStopLong, volatilityStopLong)
    float candidateLiquidityLong = f_closestAbove(candidateLimitLong, candidateStopLong, minRR, pdh, coreAsiaHigh, coreLonHigh, coreOrHigh, m15SwingHigh, pwh, h1RangeHigh)
    bool biasRawLong = bias == 1
    bool biasOkLong = (not requireBiasGate or biasRawLong) and allowLongDir
    bool h4OkLong = not useH4Veto or h4Bias != -1
    // [C10] Séparé : « pas de range H1 exploitable » n'est pas « POI hors Discount ».
    bool h1RangeUsableLong = not na(h1Mid)
    bool pdRawLong = h1RangeUsableLong and candidateLimitLong <= h1Mid
    bool pdOkLong = not requirePdGate or pdRawLong
    // [C3-bis] Séparé de la liquidité pour que le diagnostic soit exact : un POI
    // dont le milieu tombe sous le stop n'est pas « un manque de liquidité ».
    bool stopGeometryOkLong = candidateStopLong < candidateLimitLong
    bool liquidityFoundLong = not na(candidateLiquidityLong)
    // [C8] Cible déjà traversée aujourd'hui = liquidité déjà consommée.
    bool targetFreshLong = not requireFreshTarget or (liquidityFoundLong and candidateLiquidityLong > nz(dayHighSoFar, high))
    bool geometryOkLong = stopGeometryOkLong and (not requireRrGate or (liquidityFoundLong and targetFreshLong))
    if biasOkLong and h4OkLong and pdOkLong and geometryOkLong
        lLimit := candidateLimitLong
        lStop := candidateStopLong
        lTp1 := candidateLimitLong + tp1R * (candidateLimitLong - candidateStopLong)
        lTp2 := candidateLimitLong + minRR * (candidateLimitLong - candidateStopLong)
        lLiquidity := na(candidateLiquidityLong) ? lTp2 : candidateLiquidityLong
        newLongPlan := true
        // [V2.5.11] NOTATION. Rien n'est bloqué : le setup est simplement noté.
        //   A+ : sweep pris dans le Discount, puis CISD, puis POI
        //   A  : même séquence, sweep hors Discount
        //   B+ : SMT au sweep ou MSS confirmé pendant la séquence
        //   B  : SMT présent sans MSS
        //   C  : biais H1 contraire ou neutre
        // A+ / A / C sont attribuables ici : la route qui crée ce plan est bien
        // sweep -> CISD -> FVG/OB/IFVG. B+ et B décrivent une route différente,
        // où c'est un MSS qui déclenche l'entrée ; cette route n'existe pas
        // encore dans le moteur, donc SMT et MSS sont reportés en ligne 18
        // comme information, sans forcer une note qui serait fausse.
        lGrade := not biasRawLong ? "C" : lSweepPdAligned ? "A+" : "A"
        lastRejectReason := ""
    else
        lastRejectReason := not biasOkLong ? "Biais H1/Direction" : not h4OkLong ? "Veto H4" : not h1RangeUsableLong ? "Range H1 indisponible" : not pdOkLong ? "POI hors Discount" : not stopGeometryOkLong ? "POI sous le stop" : not liquidityFoundLong ? "Pas de liquidité ≥ RR" : "Liquidité cible déjà prise"
        // [CORRECTIF C3] Le sweep et le CISD restent valides : on retombe en
        // attente d'un nouveau POI au lieu de détruire toute la séquence.
        lStage := keepSeqOnReject ? 2 : 0

    // [Entrée directe] Bloc additif, indépendant des gates ci-dessus (qui
    // décident seulement de lLimit/newLongPlan). Réutilise le stop déjà
    // calculé (extrême du sweep ± ATR) mais ancre l'entrée et la cible sur
    // la clôture de la bougie qui vient de former le POI, au lieu d'attendre
    // le retour à 50 %. N'écrit jamais lLimit/lStop/lTp1/lTp2/lLiquidity.
    bool directSourceOkLong = (directAllowPdSweep and str.contains(lSweepSource, "PD")) or (directAllowAsiaSweep and str.contains(lSweepSource, "ASIA")) or (directAllowLonSweep and str.contains(lSweepSource, "LON")) or (directAllowOrSweep and str.contains(lSweepSource, "OR")) or (directAllowM15Sweep and str.contains(lSweepSource, "M15"))
    if directEntryEnabled and directSourceOkLong
        float directStopLong = candidateStopLong
        if directStopLong < close
            float directRiskLong = close - directStopLong
            float directLiqLong = f_closestAbove(close, directStopLong, minRR, pdh, coreAsiaHigh, coreLonHigh, coreOrHigh, m15SwingHigh, pwh, h1RangeHigh)
            lDirectEntry := close
            lDirectStop := directStopLong
            lDirectTp1 := close + tp1R * directRiskLong
            lDirectTp2 := close + minRR * directRiskLong
            lDirectLiquidity := na(directLiqLong) ? lDirectTp2 : directLiqLong
            lDirectBar := bar_index
            newLongDirectPlan := true

if sStage == 3 and na(sLimit)
    // [V2.5.10] Short : le prix monte dans la zone, le premier contact est le BAS.
    float candidateLimitShort = sPoiBot + (poiEntryPct / 100.0) * (sPoiTop - sPoiBot)
    float structuralStopShort = sSweepExtreme + stopBuffer
    float volatilityStopShort = candidateLimitShort + minStopAtr * atrCore
    float candidateStopShort = math.max(structuralStopShort, volatilityStopShort)
    float candidateLiquidityShort = f_closestBelow(candidateLimitShort, candidateStopShort, minRR, pdl, coreAsiaLow, coreLonLow, coreOrLow, m15SwingLow, pwl, h1RangeLow)
    bool biasRawShort = bias == -1
    bool biasOkShort = (not requireBiasGate or biasRawShort) and allowShortDir
    bool h4OkShort = not useH4Veto or h4Bias != 1
    bool h1RangeUsableShort = not na(h1Mid)
    bool pdRawShort = h1RangeUsableShort and candidateLimitShort >= h1Mid
    bool pdOkShort = not requirePdGate or pdRawShort
    bool stopGeometryOkShort = candidateLimitShort < candidateStopShort
    bool liquidityFoundShort = not na(candidateLiquidityShort)
    bool targetFreshShort = not requireFreshTarget or (liquidityFoundShort and candidateLiquidityShort < nz(dayLowSoFar, low))
    bool geometryOkShort = stopGeometryOkShort and (not requireRrGate or (liquidityFoundShort and targetFreshShort))
    if biasOkShort and h4OkShort and pdOkShort and geometryOkShort
        sLimit := candidateLimitShort
        sStop := candidateStopShort
        sTp1 := candidateLimitShort - tp1R * (candidateStopShort - candidateLimitShort)
        sTp2 := candidateLimitShort - minRR * (candidateStopShort - candidateLimitShort)
        sLiquidity := na(candidateLiquidityShort) ? sTp2 : candidateLiquidityShort
        newShortPlan := true
        sGrade := not biasRawShort ? "C" : sSweepPdAligned ? "A+" : "A"
        lastRejectReason := ""
    else
        lastRejectReason := not biasOkShort ? "Biais H1/Direction" : not h4OkShort ? "Veto H4" : not h1RangeUsableShort ? "Range H1 indisponible" : not pdOkShort ? "POI hors Premium" : not stopGeometryOkShort ? "POI au-dessus du stop" : not liquidityFoundShort ? "Pas de liquidité ≥ RR" : "Liquidité cible déjà prise"
        // [CORRECTIF C3] Idem côté short.
        sStage := keepSeqOnReject ? 2 : 0

    // [Entrée directe] Symétrique du bloc Long : additif, n'écrit jamais
    // sLimit/sStop/sTp1/sTp2/sLiquidity.
    bool directSourceOkShort = (directAllowPdSweep and str.contains(sSweepSource, "PD")) or (directAllowAsiaSweep and str.contains(sSweepSource, "ASIA")) or (directAllowLonSweep and str.contains(sSweepSource, "LON")) or (directAllowOrSweep and str.contains(sSweepSource, "OR")) or (directAllowM15Sweep and str.contains(sSweepSource, "M15"))
    if directEntryEnabled and directSourceOkShort
        float directStopShort = candidateStopShort
        if close < directStopShort
            float directRiskShort = directStopShort - close
            float directLiqShort = f_closestBelow(close, directStopShort, minRR, pdl, coreAsiaLow, coreLonLow, coreOrLow, m15SwingLow, pwl, h1RangeLow)
            sDirectEntry := close
            sDirectStop := directStopShort
            sDirectTp1 := close - tp1R * directRiskShort
            sDirectTp2 := close - minRR * directRiskShort
            sDirectLiquidity := na(directLiqShort) ? sDirectTp2 : directLiqShort
            sDirectBar := bar_index
            newShortDirectPlan := true

// Un plan en attente ne garde pas un ancien feu vert après une nouvelle
// cassure H1 opposée, une sortie de zone P/D ou un changement du veto H4.
// [V2.5.11] Chaque composante du contexte ne bloque que si sa porte est armée.
// [V2.5.11] Un MSS survenu pendant la séquence fait partie de la notation.
if lStage >= 1 and lStage <= 3 and mssBullEvt
    lMssSeen := true
if sStage >= 1 and sStage <= 3 and mssBearEvt
    sMssSeen := true
bool longContextValid = allowLongDir and not na(lLimit) and (not requireBiasGate or (h1RangeAligned and h1DealingDir == 1 and bias == 1)) and (not requirePdGate or lLimit <= h1Mid) and (not useH4Veto or h4Bias != -1)
bool shortContextValid = allowShortDir and not na(sLimit) and (not requireBiasGate or (h1RangeAligned and h1DealingDir == -1 and bias == -1)) and (not requirePdGate or sLimit >= h1Mid) and (not useH4Veto or h4Bias != 1)
if confirmed and lStage == 3 and not na(lLimit) and not longContextValid
    lStage := 0
    lLimit := na
    lastRejectReason := "Plan Long annulé · contexte H1/H4"
if confirmed and sStage == 3 and not na(sLimit) and not shortContextValid
    sStage := 0
    sLimit := na
    lastRejectReason := "Plan Short annulé · contexte H1/H4"

if showStageLabels and newLongPlan and not (cleanDisplay and showTrade)
    f_pushStageLabel(stageLabels, bar_index, lLimit, "3 · " + lPoiName + " @" + poiEntryMode, label.style_label_up, color.new(#00bcd4, 70), color.aqua, size.tiny, false)
if showStageLabels and newShortPlan and not (cleanDisplay and showTrade)
    f_pushStageLabel(stageLabels, bar_index, sLimit, "3 · " + sPoiName + " @" + poiEntryMode, label.style_label_down, color.new(#e040fb, 70), #e040fb, size.tiny, false)

// =============================================================================
//  MOTEUR CONTINUATION H1 → M5
//  0 = attente, 1 = cassure M5 qualifiée / attente FVG,
//  2 = plan FVG prêt / attente 50 %, 3 = GO déjà émis.
//  Ce moteur ne lit aucun état Sweep/CISD/IFVG du moteur Reversal.
// =============================================================================

// --- Microstructure M5 propre au moteur Continuation.
float contPh = ta.pivothigh(contPivotLen, contPivotLen)
float contPl = ta.pivotlow(contPivotLen, contPivotLen)
var float contLastPh = na
var float contLastPl = na
var int contLastPhBar = na
var int contLastPlBar = na
var int contBrokenPhBar = na
var int contBrokenPlBar = na
var int contMicroDir = 0

if confirmed and not na(contPh)
    contLastPh := contPh
    contLastPhBar := bar_index - contPivotLen
if confirmed and not na(contPl)
    contLastPl := contPl
    contLastPlBar := bar_index - contPivotLen

bool contHighUnbroken = not na(contLastPhBar) and (na(contBrokenPhBar) or contLastPhBar != contBrokenPhBar)
bool contLowUnbroken = not na(contLastPlBar) and (na(contBrokenPlBar) or contLastPlBar != contBrokenPlBar)
bool contLongPullbackReady = contHighUnbroken and not na(contLastPlBar) and contLastPlBar > contLastPhBar
bool contShortPullbackReady = contLowUnbroken and not na(contLastPhBar) and contLastPhBar > contLastPlBar
bool contRawBullBreak = confirmed and contLongPullbackReady and not na(close[1]) and close > contLastPh + syminfo.mintick and close[1] <= contLastPh
bool contRawBearBreak = confirmed and contShortPullbackReady and not na(close[1]) and close < contLastPl - syminfo.mintick and close[1] >= contLastPl
string contBullBreakKind = contMicroDir == -1 ? "MSS M5 +" : contMicroDir == 1 ? "BOS M5 +" : "BOS/MSS M5 +"
string contBearBreakKind = contMicroDir == 1 ? "MSS M5 −" : contMicroDir == -1 ? "BOS M5 −" : "BOS/MSS M5 −"

if contRawBullBreak
    contBrokenPhBar := contLastPhBar
    contMicroDir := 1
if contRawBearBreak
    contBrokenPlBar := contLastPlBar
    contMicroDir := -1

// --- Contexte : une ancienne étiquette HH/HL ou LH/LL ne suffit pas.
bool contH4Ready = h4Bias != 0 or _h4RangeSource != 0
bool contH4LongOK = not contUseH4Veto or (contH4Ready and h4Bias != -1 and _h4DealingDir != -1)
bool contH4ShortOK = not contUseH4Veto or (contH4Ready and h4Bias != 1 and _h4DealingDir != 1)
bool contLongContext = contEnabled and tfOK and h1RangeAligned and h1RangeSource == 1 and bias == 1 and h1DealingDir == 1 and allowLongDir and contH4LongOK
bool contShortContext = contEnabled and tfOK and h1RangeAligned and h1RangeSource == 1 and bias == -1 and h1DealingDir == -1 and allowShortDir and contH4ShortOK
bool inContSession = not na(time(timeframe.period, contTradeSess, sessTz)) and not inFlatCore
bool contSessionEnded = inContSession[1] and not inContSession

// --- Liquidités cibles fraîches, indépendantes des options d'affichage.
// Un pivot ou un niveau de session reste disponible jusqu'à ce qu'une bougie
// ultérieure trade réellement au-delà. Désactiver les lignes BSL/SSL ne change
// donc jamais le moteur Continuation.
var float contPdhTarget = na
var float contPdlTarget = na
var int contPdTargetBar = na
var float contAsiaHighTarget = na
var float contAsiaLowTarget = na
var int contAsiaTargetBar = na
var float contLonHighTarget = na
var float contLonLowTarget = na
var int contLonTargetBar = na
var float contOrHighTarget = na
var float contOrLowTarget = na
var int contOrTargetBar = na
var float contM15HighTarget = na
var float contM15LowTarget = na
var int contM15HighTargetBar = na
var int contM15LowTargetBar = na
var float contH1HighTarget = na
var float contH1LowTarget = na
var int contH1HighTargetBar = na
var int contH1LowTargetBar = na
var float contPwhTarget = na
var float contPwlTarget = na
var int contPwTargetBar = na

bool contNewWeek = bar_index == 0 or ta.change(time("W")) != 0
if newCalendarDayCore
    contPdhTarget := pdh
    contPdlTarget := pdl
    contPdTargetBar := bar_index
    contLonHighTarget := na
    contLonLowTarget := na
    contOrHighTarget := na
    contOrLowTarget := na
if asiaStartCore
    contAsiaHighTarget := na
    contAsiaLowTarget := na
if asiaEndCore and coreAsiaReady
    contAsiaHighTarget := coreAsiaHigh
    contAsiaLowTarget := coreAsiaLow
    contAsiaTargetBar := bar_index
if lonStartCore
    contLonHighTarget := na
    contLonLowTarget := na
if lonEndCore and coreLonReady
    contLonHighTarget := coreLonHigh
    contLonLowTarget := coreLonLow
    contLonTargetBar := bar_index
if orStartCore
    contOrHighTarget := na
    contOrLowTarget := na
if orEndCore and coreOrReady
    contOrHighTarget := coreOrHigh
    contOrLowTarget := coreOrLow
    contOrTargetBar := bar_index
if newM15Bsl
    contM15HighTarget := m15SwingHigh
    contM15HighTargetBar := bar_index
if newM15Ssl
    contM15LowTarget := m15SwingLow
    contM15LowTargetBar := bar_index
if newH1Bsl
    contH1HighTarget := h1LiquidityHigh
    contH1HighTargetBar := bar_index
if newH1Ssl
    contH1LowTarget := h1LiquidityLow
    contH1LowTargetBar := bar_index
if contNewWeek
    contPwhTarget := pwh
    contPwlTarget := pwl
    contPwTargetBar := bar_index

// [V2.5.8-FIX] L'invalidation des cibles traversées devient optionnelle.
if confirmed and contRequireFresh
    if not na(contPdhTarget) and bar_index > contPdTargetBar and high > contPdhTarget
        contPdhTarget := na
    if not na(contPdlTarget) and bar_index > contPdTargetBar and low < contPdlTarget
        contPdlTarget := na
    if not na(contAsiaHighTarget) and bar_index > contAsiaTargetBar and high > contAsiaHighTarget
        contAsiaHighTarget := na
    if not na(contAsiaLowTarget) and bar_index > contAsiaTargetBar and low < contAsiaLowTarget
        contAsiaLowTarget := na
    if not na(contLonHighTarget) and bar_index > contLonTargetBar and high > contLonHighTarget
        contLonHighTarget := na
    if not na(contLonLowTarget) and bar_index > contLonTargetBar and low < contLonLowTarget
        contLonLowTarget := na
    if not na(contOrHighTarget) and bar_index > contOrTargetBar and high > contOrHighTarget
        contOrHighTarget := na
    if not na(contOrLowTarget) and bar_index > contOrTargetBar and low < contOrLowTarget
        contOrLowTarget := na
    if not na(contM15HighTarget) and bar_index > contM15HighTargetBar and high > contM15HighTarget
        contM15HighTarget := na
    if not na(contM15LowTarget) and bar_index > contM15LowTargetBar and low < contM15LowTarget
        contM15LowTarget := na
    if not na(contH1HighTarget) and bar_index > contH1HighTargetBar and high > contH1HighTarget
        contH1HighTarget := na
    if not na(contH1LowTarget) and bar_index > contH1LowTargetBar and low < contH1LowTarget
        contH1LowTarget := na
    if not na(contPwhTarget) and bar_index > contPwTargetBar and high > contPwhTarget
        contPwhTarget := na
    if not na(contPwlTarget) and bar_index > contPwTargetBar and low < contPwlTarget
        contPwlTarget := na

// --- Le FVG doit appartenir à la même impulsion que la cassure.
float contMidRange = high[1] - low[1]
float contMidBody = math.abs(close[1] - open[1])
float contMidAtr = nz(atrCore[1], atrCore)
float contMidClosePos = contMidRange > 0 ? (close[1] - low[1]) / contMidRange : 0.5
float contExtremeFrac = contCloseExtreme / 100.0
bool contBullDisplacement = close[1] > open[1] and contMidBody >= contBodyAtrMin * contMidAtr and contMidRange >= contRangeAtrMin * contMidAtr and contMidClosePos >= 1.0 - contExtremeFrac
bool contBearDisplacement = close[1] < open[1] and contMidBody >= contBodyAtrMin * contMidAtr and contMidRange >= contRangeAtrMin * contMidAtr and contMidClosePos <= contExtremeFrac
float contBullGap = bar_index >= 2 ? low - high[2] : na
float contBearGap = bar_index >= 2 ? low[2] - high : na
float contGapMinimum = math.max(2.0 * syminfo.mintick, contFvgMinAtr * contMidAtr)
bool contBullFvg = confirmed and not na(contBullGap) and contBullGap >= contGapMinimum
bool contBearFvg = confirmed and not na(contBearGap) and contBearGap >= contGapMinimum

var int contStage = 0
var int contDir = 0
var int contBreakBar = na
var float contBreakLevel = na
var float contPullbackExtreme = na
var string contBreakKind = ""
var int contPoiBar = na
var float contPoiTop = na
var float contPoiBot = na
var float contEntry = na
var float contStop = na
var float contTp1 = na
var float contTp2 = na
var float contLiquidity = na
var int contSignalsToday = 0
// [V2.5.8-FIX] Combien de setups la zone Premium/Discount a-t-elle écartés
// aujourd'hui. Compté même quand le filtre est désactivé, pour pouvoir mesurer
// ce qu'il coûterait avant de l'activer.
var int contPdBlockedToday = 0
var string contLastReject = ""
var array<label> contStageLabels = array.new<label>()

bool contNewBreak = false
bool contNewPlan = false
bool contPlanCancelled = false

if newCalendarDayCore
    contStage := 0
    contDir := 0
    contEntry := na
    contSignalsToday := 0
    contPdBlockedToday := 0
    contLastReject := ""
    if not keepStageHistory
        f_clearStageLabels(contStageLabels)

// Une cassure opposée invalide un plan en attente. Elle ne devient un nouveau
// setup que si le contexte H1/H4 autorise ensuite cette direction.
if confirmed and contStage >= 1 and contStage <= 2 and ((contDir == 1 and contRawBearBreak) or (contDir == -1 and contRawBullBreak))
    contStage := 0
    contEntry := na
    contLastReject := "Cassure M5 opposée"
    contPlanCancelled := true

bool reversalBusyAtBreak = lStage >= 3 or sStage >= 3
bool contBullBreakEligible = contRawBullBreak and contLongContext and inContSession and contSignalsToday < contMaxTrades and not reversalBusyAtBreak
bool contBearBreakEligible = contRawBearBreak and contShortContext and inContSession and contSignalsToday < contMaxTrades and not reversalBusyAtBreak

if contStage == 0 and contBullBreakEligible and not contBearBreakEligible
    contStage := 1
    contDir := 1
    contBreakBar := bar_index
    contBreakLevel := contLastPh
    contPullbackExtreme := contLastPl
    contBreakKind := contBullBreakKind
    contEntry := na
    contLastReject := ""
    contNewBreak := true
    if contShowLabels
        f_pushStageLabel(contStageLabels, bar_index, low, "C1 · " + contBreakKind, label.style_none, color.new(#00acc1, 100), #00acc1, size.tiny, true)
else if contStage == 0 and contBearBreakEligible and not contBullBreakEligible
    contStage := 1
    contDir := -1
    contBreakBar := bar_index
    contBreakLevel := contLastPl
    contPullbackExtreme := contLastPh
    contBreakKind := contBearBreakKind
    contEntry := na
    contLastReject := ""
    contNewBreak := true
    if contShowLabels
        f_pushStageLabel(contStageLabels, bar_index, high, "C1 · " + contBreakKind, label.style_none, color.new(#ff7043, 100), #ff7043, size.tiny, true)

// V2.5.9 : le délai maximal est configurable. Par défaut, la bougie qui
// confirme le FVG doit être celle qui confirme aussi la cassure du pivot M5.
int contFvgMaxDelay = contFvgBreakOnly ? 0 : 1
bool contBullImpulseFvg = contStage == 1 and contDir == 1 and not na(contBreakBar) and bar_index - contBreakBar >= 0 and bar_index - contBreakBar <= contFvgMaxDelay and contBullFvg and contBullDisplacement
bool contBearImpulseFvg = contStage == 1 and contDir == -1 and not na(contBreakBar) and bar_index - contBreakBar >= 0 and bar_index - contBreakBar <= contFvgMaxDelay and contBearFvg and contBearDisplacement

if contBullImpulseFvg
    float candidateEntry = (low + high[2]) / 2.0
    float candidateStructuralStop = contPullbackExtreme - stopBuffer
    float candidateVolatilityStop = candidateEntry - contMinStopAtr * atrCore
    float candidateStop = math.min(candidateStructuralStop, candidateVolatilityStop)
    float freshPdh = contPdhTarget
    float freshAsia = contAsiaHighTarget
    float freshLon = contLonHighTarget
    float freshOr = contOrHighTarget
    float freshM15 = contM15HighTarget
    float freshPwh = useWeeklySweep ? contPwhTarget : na
    float freshH1 = contH1HighTarget
    float candidateTarget = f_nearestAbove(candidateEntry, freshPdh, freshAsia, freshLon, freshOr, freshM15, freshPwh, freshH1)
    float candidateRisk = candidateEntry - candidateStop
    float candidateRR = candidateRisk > 0 and not na(candidateTarget) ? (candidateTarget - candidateEntry) / candidateRisk : na
    // [V2.5.8-FIX] Filtre Premium/Discount rendu optionnel. Voir le tooltip de
    // « Exiger Discount / Premium » : il rejetait 93 % des setups.
    bool pdRaw = not na(h1Mid) and candidateEntry >= h1RangeLow and candidateEntry <= h1Mid
    bool pdOK = not contRequirePD or pdRaw
    if not pdRaw
        contPdBlockedToday += 1
    bool targetOK = not contRequireLiq or (not na(candidateRR) and candidateRR >= contMinRR)
    if contLongContext and inContSession and pdOK and candidateRisk > 0 and targetOK
        contStage := 2
        contPoiBar := bar_index
        contPoiTop := low
        contPoiBot := high[2]
        contEntry := candidateEntry
        contStop := candidateStop
        contTp1 := candidateEntry + contTp1R * candidateRisk
        contTp2 := candidateEntry + contExitR * candidateRisk
        contLiquidity := candidateTarget
        contNewPlan := true
        contLastReject := ""
    else
        contStage := 0
        contEntry := na
        contLastReject := not contLongContext ? "Contexte H1/H4 Long" : not pdOK ? "FVG hors Discount" : candidateRisk <= 0 ? "Géométrie SL Long" : "Prochaine liquidité < " + str.tostring(contMinRR, "#.#") + "R"

if contBearImpulseFvg
    float candidateEntry = (low[2] + high) / 2.0
    float candidateStructuralStop = contPullbackExtreme + stopBuffer
    float candidateVolatilityStop = candidateEntry + contMinStopAtr * atrCore
    float candidateStop = math.max(candidateStructuralStop, candidateVolatilityStop)
    float freshPdl = contPdlTarget
    float freshAsia = contAsiaLowTarget
    float freshLon = contLonLowTarget
    float freshOr = contOrLowTarget
    float freshM15 = contM15LowTarget
    float freshPwl = useWeeklySweep ? contPwlTarget : na
    float freshH1 = contH1LowTarget
    float candidateTarget = f_nearestBelow(candidateEntry, freshPdl, freshAsia, freshLon, freshOr, freshM15, freshPwl, freshH1)
    float candidateRisk = candidateStop - candidateEntry
    float candidateRR = candidateRisk > 0 and not na(candidateTarget) ? (candidateEntry - candidateTarget) / candidateRisk : na
    bool pdRaw = not na(h1Mid) and candidateEntry <= h1RangeHigh and candidateEntry >= h1Mid
    bool pdOK = not contRequirePD or pdRaw
    if not pdRaw
        contPdBlockedToday += 1
    bool targetOK = not contRequireLiq or (not na(candidateRR) and candidateRR >= contMinRR)
    if contShortContext and inContSession and pdOK and candidateRisk > 0 and targetOK
        contStage := 2
        contPoiBar := bar_index
        contPoiTop := low[2]
        contPoiBot := high
        contEntry := candidateEntry
        contStop := candidateStop
        contTp1 := candidateEntry - contTp1R * candidateRisk
        contTp2 := candidateEntry - contExitR * candidateRisk
        contLiquidity := candidateTarget
        contNewPlan := true
        contLastReject := ""
    else
        contStage := 0
        contEntry := na
        contLastReject := not contShortContext ? "Contexte H1/H4 Short" : not pdOK ? "FVG hors Premium" : candidateRisk <= 0 ? "Géométrie SL Short" : "Prochaine liquidité < " + str.tostring(contMinRR, "#.#") + "R"

// Pas de FVG recyclé : à l'expiration du délai configuré, il faut attendre un
// nouveau pivot et une nouvelle cassure.
if confirmed and contStage == 1 and not na(contBreakBar) and bar_index - contBreakBar > contFvgMaxDelay
    contStage := 0
    contEntry := na
    contLastReject := "Aucun FVG frais après cassure"

bool contPlanExpired = contStage == 2 and not na(contPoiBar) and bar_index - contPoiBar > contPlanMaxAge
if confirmed and contPlanExpired
    contStage := 0
    contEntry := na
    contLastReject := "Retour 50 % expiré"
    contPlanCancelled := true
if confirmed and contSessionEnded and contStage >= 1 and contStage <= 2
    contStage := 0
    contEntry := na
    contLastReject := "Fenêtre Continuation terminée"
    contPlanCancelled := true
if confirmed and not newsOK and contStage == 2
    contStage := 0
    contEntry := na
    contLastReject := "STOP news"
    contPlanCancelled := true

// Si un plan Reversal se forme après un plan Continuation déjà prêt, le premier
// reste actif. En cas d'égalité, priorité au Reversal V2.5.7.
bool reversalPlanWaiting = lStage == 3 or sStage == 3
int reversalPlanBar = lStage == 3 and sStage == 3 ? math.min(lPoiBar, sPoiBar) : lStage == 3 ? lPoiBar : sStage == 3 ? sPoiBar : na
if contStage == 2 and reversalPlanWaiting
    if not na(reversalPlanBar) and reversalPlanBar <= contPoiBar
        contStage := 0
        contEntry := na
        contNewPlan := false
        contLastReject := "Priorité plan Reversal"
        contPlanCancelled := true
    else
        if lStage == 3
            lStage := 0
            lLimit := na
        if sStage == 3
            sStage := 0
            sLimit := na
        if (newLongPlan or newShortPlan) and array.size(stageLabels) > 0
            label.delete(array.pop(stageLabels))
        newLongPlan := false
        newShortPlan := false
        lastRejectReason := "Plan Reversal annulé · Continuation antérieure"

if contShowLabels and contNewPlan and contStage == 2
    f_pushStageLabel(contStageLabels, bar_index, contEntry, "C2 · FVG @50%", label.style_none, color.new(#7e57c2, 100), #7e57c2, size.tiny, false)

// Valeurs d'audit sans nouveaux objets graphiques.
plot(contStage, "Continuation · Étape (0/1/2/3)", display = display.data_window)
plot(contDir, "Continuation · Direction (+1/−1)", display = display.data_window)
plot(contBreakLevel, "Continuation · Niveau cassé M5", display = display.data_window)
plot(contEntry, "Continuation · Entrée FVG 50 %", display = display.data_window)
plot(contStop, "Continuation · Stop", display = display.data_window)
plot(contLiquidity, "Continuation · Prochaine liquidité", display = display.data_window)

// =============================================================================
//  ROUTE ADDITIVE OR 09:30–09:45 → PREMIER FVG M1 → RETEST → CONFIRMATION
// =============================================================================
// Le calcul du FVG utilise les vraies bougies M1 contenues dans chaque bougie
// M3/M5. Le premier gap M1 dont les trois bougies sont formées pendant l'OR
// 09:30–09:45 est seul conservé, indépendamment des routes sweep/breakout.
// Par prudence de backtest, un FVG ne peut être retesté qu'à partir de la
// bougie chart suivante : le chemin intrabar création → retest serait ambigu.
bool orFvgTfOK = timeframe.isminutes and (timeframe.multiplier == 1 or timeframe.multiplier == 3 or timeframe.multiplier == 5)
bool inOrFvgRange = not na(time(timeframe.period, orFvgSession, "America/New_York"))
bool inOrFvgTrade = not na(time(timeframe.period, orFvgTradeSession, "America/New_York"))
bool orFvgRangeStart = inOrFvgRange and not inOrFvgRange[1]
bool orFvgRangeEnd = not inOrFvgRange and inOrFvgRange[1]

var float orFvgOrHigh = na
var float orFvgOrLow = na
var bool orFvgOrReady = false
var int orFvgDir = 0
var int orFvgTriggerBar = na
var int orFvgTriggerTime = na
var float orFvgTriggerExtreme = na
var int orFvgStage = 0       // 0 attente trigger, 1 attente FVG, 2 attente retest, 3 GO donné
var float orFvgTop = na
var float orFvgBottom = na
var bool orFvgCandidateFound = false
var int orFvgCandidateDir = 0
var float orFvgCandidateTop = na
var float orFvgCandidateBottom = na
var int orFvgCandidateTime = na
var float orFvgEntry = na
var float orFvgStop = na
var float orFvgTp1 = na
var float orFvgTp2 = na
var int orFvgZoneBar = na
var box orFvgBox = na
var float orM1High2 = na
var float orM1Low2 = na
var float orM1High1 = na
var float orM1Low1 = na

bool orFvgNewDay = bar_index == 0 or year(time, "America/New_York") != year(time[1], "America/New_York") or month(time, "America/New_York") != month(time[1], "America/New_York") or dayofmonth(time, "America/New_York") != dayofmonth(time[1], "America/New_York")
if orFvgNewDay
    orFvgOrHigh := na
    orFvgOrLow := na
    orFvgOrReady := false
    orFvgDir := 0
    orFvgTriggerBar := na
    orFvgTriggerTime := na
    orFvgTriggerExtreme := na
    orFvgStage := 0
    orFvgTop := na
    orFvgBottom := na
    orFvgCandidateFound := false
    orFvgCandidateDir := 0
    orFvgCandidateTop := na
    orFvgCandidateBottom := na
    orFvgCandidateTime := na
    orFvgEntry := na
    orFvgStop := na
    orFvgTp1 := na
    orFvgTp2 := na
    orFvgZoneBar := na
    if not na(orFvgBox) and not orFvgKeepHistory
        box.delete(orFvgBox)
    orFvgBox := na

if orFvgRangeStart
    orFvgOrHigh := high
    orFvgOrLow := low
    orFvgOrReady := false
    orFvgCandidateFound := false
    orFvgCandidateDir := 0
    orFvgCandidateTop := na
    orFvgCandidateBottom := na
    orFvgCandidateTime := na
else if inOrFvgRange
    orFvgOrHigh := na(orFvgOrHigh) ? high : math.max(orFvgOrHigh, high)
    orFvgOrLow := na(orFvgOrLow) ? low : math.min(orFvgOrLow, low)
if orFvgRangeEnd and not na(orFvgOrHigh)
    orFvgOrReady := true
    if orFvgEnabled and orFvgCandidateFound
        orFvgDir := orFvgCandidateDir
        orFvgTop := orFvgCandidateTop
        orFvgBottom := orFvgCandidateBottom
        orFvgStage := 2
        orFvgTriggerBar := bar_index
        orFvgTriggerTime := time
        orFvgZoneBar := bar_index
        orFvgTriggerExtreme := na

// Route OR-FVG : même règle de fraîcheur, avec son OR 09:30-09:45 distinct
// de l'OR paramétrable du moteur strict. Sweep et breakout partagent l'état
// du niveau : un breakout antérieur interdit un sweep ultérieur de ce prix.
bool freshOrFvgLow = f_firstCrossAvailable(14, orFvgOrReady ? orFvgOrLow : na, false)
bool freshOrFvgHigh = f_firstCrossAvailable(15, orFvgOrReady ? orFvgOrHigh : na, true)
bool orSweepLong = freshOrFvgLow and inOrFvgTrade and low < orFvgOrLow and close > orFvgOrLow and low[1] >= orFvgOrLow
bool orSweepShort = freshOrFvgHigh and inOrFvgTrade and high > orFvgOrHigh and close < orFvgOrHigh and high[1] <= orFvgOrHigh
bool orBreakLong = freshOrFvgHigh and inOrFvgTrade and close > orFvgOrHigh and close[1] <= orFvgOrHigh
bool orBreakShort = freshOrFvgLow and inOrFvgTrade and close < orFvgOrLow and close[1] >= orFvgOrLow
bool orAllowSweep = orFvgTriggerMode != "Après clôture OR" and orFvgTriggerMode != "Breakout OR uniquement"
bool orAllowBreak = orFvgTriggerMode != "Après clôture OR" and orFvgTriggerMode != "Sweep OR uniquement"
bool orLongTrigger = confirmed and orFvgEnabled and orFvgTfOK and ((orAllowSweep and orSweepLong) or (orAllowBreak and orBreakLong))
bool orShortTrigger = confirmed and orFvgEnabled and orFvgTfOK and ((orAllowSweep and orSweepShort) or (orAllowBreak and orBreakShort)) and not orLongTrigger

if confirmed and orFvgTfOK and timeframe.multiplier == 1
    bool orBullGapM1 = low > high[2] and low - high[2] >= orFvgMinTicks * syminfo.mintick
    bool orBearGapM1 = high < low[2] and low[2] - high >= orFvgMinTicks * syminfo.mintick
    bool orBullGapInsideOr = orBullGapM1 and low <= orFvgOrHigh and high[2] >= orFvgOrLow
    bool orBearGapInsideOr = orBearGapM1 and low[2] <= orFvgOrHigh and high >= orFvgOrLow
    int orMinuteNy = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    bool orThreeM1BarsInsideWindow = orMinuteNy >= 9 * 60 + 32 and orMinuteNy < 9 * 60 + 45
    if orFvgEnabled and inOrFvgRange and orThreeM1BarsInsideWindow and not orFvgCandidateFound
        if orBullGapInsideOr
            orFvgCandidateFound := true
            orFvgCandidateDir := 1
            orFvgCandidateTop := low
            orFvgCandidateBottom := high[2]
            orFvgCandidateTime := time
        else if orBearGapInsideOr
            orFvgCandidateFound := true
            orFvgCandidateDir := -1
            orFvgCandidateTop := low[2]
            orFvgCandidateBottom := high
            orFvgCandidateTime := time

if confirmed and orFvgTfOK and timeframe.multiplier > 1
    [orM1OpenArr, orM1HighArr, orM1LowArr, orM1CloseArr, orM1TimeArr] = request.security_lower_tf(syminfo.tickerid, "1", [open, high, low, close, time])
    int orM1Count = array.size(orM1CloseArr)
    if orM1Count > 0
        for orI = 0 to orM1Count - 1
            float orM1H = array.get(orM1HighArr, orI)
            float orM1L = array.get(orM1LowArr, orI)
            int orM1T = array.get(orM1TimeArr, orI)
            bool orBullGap = not na(orM1High2) and orM1L > orM1High2 and orM1L - orM1High2 >= orFvgMinTicks * syminfo.mintick
            bool orBearGap = not na(orM1Low2) and orM1H < orM1Low2 and orM1Low2 - orM1H >= orFvgMinTicks * syminfo.mintick
            bool orBullGapInsideOr = orBullGap and orM1L <= orFvgOrHigh and orM1High2 >= orFvgOrLow
            bool orBearGapInsideOr = orBearGap and orM1Low2 <= orFvgOrHigh and orM1H >= orFvgOrLow
            int orM1MinuteNy = hour(orM1T, "America/New_York") * 60 + minute(orM1T, "America/New_York")
            bool orM1InsideWindow = orM1MinuteNy >= 9 * 60 + 32 and orM1MinuteNy < 9 * 60 + 45
            if orFvgEnabled and orM1InsideWindow and not orFvgCandidateFound
                if orBullGapInsideOr
                    orFvgCandidateFound := true
                    orFvgCandidateDir := 1
                    orFvgCandidateTop := orM1L
                    orFvgCandidateBottom := orM1High2
                    orFvgCandidateTime := orM1T
                else if orBearGapInsideOr
                    orFvgCandidateFound := true
                    orFvgCandidateDir := -1
                    orFvgCandidateTop := orM1Low2
                    orFvgCandidateBottom := orM1H
                    orFvgCandidateTime := orM1T
            orM1High2 := orM1High1
            orM1Low2 := orM1Low1
            orM1High1 := orM1H
            orM1Low1 := orM1L

if confirmed and orFvgStage == 2 and bar_index - orFvgZoneBar > orFvgRetestMaxAge
    orFvgStage := 0
    orFvgDir := 0
    if not na(orFvgBox) and not orFvgKeepHistory
        box.delete(orFvgBox)
    orFvgBox := na

if confirmed and orFvgStage == 2 and na(orFvgBox) and orFvgShow
    orFvgBox := box.new(bar_index, orFvgTop, bar_index + orFvgExtend, orFvgBottom, xloc = xloc.bar_index, bgcolor = orFvgDir == 1 ? orFvgBullCol : orFvgBearCol, border_color = color.new(orFvgDir == 1 ? #00bfa5 : #ff5252, 10), text = "1st FVG M1 formé 09:30–09:45", text_color = orFvgDir == 1 ? #00bfa5 : #ff5252, text_size = size.tiny)
if not na(orFvgBox)
    box.set_right(orFvgBox, bar_index + orFvgExtend)

float orFvgRetestLevel = orFvgDir == 1 ? (orFvgEntryMode == "0 %" ? orFvgTop : (orFvgTop + orFvgBottom) / 2.0) : (orFvgEntryMode == "0 %" ? orFvgBottom : (orFvgTop + orFvgBottom) / 2.0)
bool orFvgTouched = orFvgStage == 2 and bar_index > orFvgZoneBar and low <= orFvgRetestLevel and high >= orFvgRetestLevel
bool orFvgLongConfirm = orFvgConfirmMode == "Aucune (au toucher)" or (orFvgConfirmMode == "Clôture directionnelle" and close > open) or (orFvgConfirmMode == "Clôture au-delà du FVG" and close > orFvgTop)
bool orFvgShortConfirm = orFvgConfirmMode == "Aucune (au toucher)" or (orFvgConfirmMode == "Clôture directionnelle" and close < open) or (orFvgConfirmMode == "Clôture au-delà du FVG" and close < orFvgBottom)
bool orFvgGoLong = confirmed and orFvgEnabled and inOrFvgTrade and orFvgDir == 1 and orFvgTouched and orFvgLongConfirm
bool orFvgGoShort = confirmed and orFvgEnabled and inOrFvgTrade and orFvgDir == -1 and orFvgTouched and orFvgShortConfirm

if orFvgGoLong or orFvgGoShort
    orFvgEntry := orFvgConfirmMode == "Aucune (au toucher)" ? orFvgRetestLevel : close
    float orFvgBuf = orFvgSlBufferTicks * syminfo.mintick
    if orFvgDir == 1
        orFvgStop := orFvgStopMode == "Derrière extrême du déclencheur" ? orFvgTriggerExtreme - orFvgBuf : orFvgStopMode == "Derrière OR" ? orFvgOrLow - orFvgBuf : orFvgBottom - orFvgBuf
        float orFvgRiskL = orFvgEntry - orFvgStop
        orFvgTp1 := orFvgEntry + orFvgTp1R * orFvgRiskL
        orFvgTp2 := orFvgEntry + orFvgTp2R * orFvgRiskL
    else
        orFvgStop := orFvgStopMode == "Derrière extrême du déclencheur" ? orFvgTriggerExtreme + orFvgBuf : orFvgStopMode == "Derrière OR" ? orFvgOrHigh + orFvgBuf : orFvgTop + orFvgBuf
        float orFvgRiskS = orFvgStop - orFvgEntry
        orFvgTp1 := orFvgEntry - orFvgTp1R * orFvgRiskS
        orFvgTp2 := orFvgEntry - orFvgTp2R * orFvgRiskS
    orFvgStage := 3

plot(orFvgShow and orFvgOrReady ? orFvgOrHigh : na, "OR FVG · ORH 09:30–09:45", color = color.new(#ff9800, 0), style = plot.style_linebr)
plot(orFvgShow and orFvgOrReady ? orFvgOrLow : na, "OR FVG · ORL 09:30–09:45", color = color.new(#ff9800, 0), style = plot.style_linebr)
plotshape(orFvgShow and orFvgGoLong, title = "GO LONG OR 1st FVG M1", style = shape.triangleup, location = location.belowbar, color = color.new(#00bfa5, 0), size = size.small, text = "OR-FVG")
plotshape(orFvgShow and orFvgGoShort, title = "GO SHORT OR 1st FVG M1", style = shape.triangledown, location = location.abovebar, color = color.new(#ff5252, 0), size = size.small, text = "OR-FVG")
alertcondition(orFvgGoLong, title = "GO LONG OR + 1st FVG M1", message = "ICT V2.7.0 : GO LONG après OR et retest du premier FVG M1 sur {{ticker}} {{interval}}")
alertcondition(orFvgGoShort, title = "GO SHORT OR + 1st FVG M1", message = "ICT V2.7.0 : GO SHORT après OR et retest du premier FVG M1 sur {{ticker}} {{interval}}")

// =============================================================================
//  CONFLUENCES OPTIONNELLES — ELLES PEUVENT BLOQUER, JAMAIS CRÉER UN GO
// =============================================================================
longSmtOK = smtManual or (smtAuto and smtRecent and lastSmtDir == 1)
shortSmtOK = smtManual or (smtAuto and smtRecent and lastSmtDir == -1)
longOptionalCount = (nearEma ? 1 : 0) + (longSmtOK ? 1 : 0) + (volOK ? 1 : 0) + (htfPoiContext ? 1 : 0)
shortOptionalCount = (nearEma ? 1 : 0) + (shortSmtOK ? 1 : 0) + (volOK ? 1 : 0) + (htfPoiContext ? 1 : 0)
longOptionalOK = not useOptionalGate or longOptionalCount >= minOptionalConf
shortOptionalOK = not useOptionalGate or shortOptionalCount >= minOptionalConf

tradesUsed = autoTradeCount ? strictSignalsToday : tradesToday
tradesOK = tradesUsed < maxTrades
riskLimitsOK = dailyLossPct < dailyLossCap and totalDdPct < totalDdCap
coreBlockersOK = newsOK and tradesOK and riskLimitsOK and tfOK

longTouch50 = lStage == 3 and bar_index > lPoiBar and sessOK and low <= lLimit and high >= lLimit
shortTouch50 = sStage == 3 and bar_index > sPoiBar and sessOK and low <= sLimit and high >= sLimit
bool altLongTouch = altLStage == 2 and bar_index > altLPoiBar and sessOK and low <= altLLimit and high >= altLLimit
bool altShortTouch = altSStage == 2 and bar_index > altSPoiBar and sessOK and low <= altSLimit and high >= altSLimit
bool contEntryTouch = contStage == 2 and bar_index > contPoiBar and inContSession and low <= contEntry and high >= contEntry

// [CORRECTIF C3] Un plan à l'étape 3 restait valable jusqu'à `poiMaxAge` même si
// le prix avait déjà traversé son propre stop. Un GO pouvait donc être émis sur
// un retour au 50 % ALORS QUE le sweep protégeant l'ordre avait été invalidé
// entre-temps — un trade perdant garanti, compté comme signal valide en backtest.
// La géométrie garantit stop < entrée (Long) : si la bougie touche le stop sans
// jamais traiter l'entrée, l'ordre limite n'a pas pu être rempli avant.
bool longStopFirst = cancelOnStopFirst and confirmed and lStage == 3 and not na(lStop) and bar_index > lPoiBar and low <= lStop and not longTouch50
bool shortStopFirst = cancelOnStopFirst and confirmed and sStage == 3 and not na(sStop) and bar_index > sPoiBar and high >= sStop and not shortTouch50
if longStopFirst
    lStage := 0
    lLimit := na
    lastRejectReason := "Plan Long annulé · SL cassé avant l'entrée"
if shortStopFirst
    sStage := 0
    sLimit := na
    lastRejectReason := "Plan Short annulé · SL cassé avant l'entrée"
bool altLongStopFirst = confirmed and altLStage == 2 and bar_index > altLPoiBar and low <= altLStop and not altLongTouch
bool altShortStopFirst = confirmed and altSStage == 2 and bar_index > altSPoiBar and high >= altSStop and not altShortTouch
if altLongStopFirst
    altLStage := 0
    altLStartBar := na
    altLLimit := na
if altShortStopFirst
    altSStage := 0
    altSStartBar := na
    altSLimit := na

// Revérification du plan Continuation juste avant son exécution.
// [V2.5.8-FIX] La revérification avant le GO suit le même interrupteur.
bool contPdStillRaw = contDir == 1 ? not na(h1Mid) and contEntry >= h1RangeLow and contEntry <= h1Mid : contDir == -1 ? not na(h1Mid) and contEntry <= h1RangeHigh and contEntry >= h1Mid : false
bool contPdStillOK = not contRequirePD or contPdStillRaw
bool contContextStillOK = contDir == 1 ? contLongContext : contDir == -1 ? contShortContext : false
bool contPlanContextValid = contStage == 2 and contContextStillOK and contPdStillOK
bool contStopFirst = confirmed and contStage == 2 and bar_index > contPoiBar and not contEntryTouch and not na(contStop) and (contDir == 1 ? low <= contStop : high >= contStop)
// [V2.5.8-FIX] Sans exigence de liquidité, un niveau atteint avant l'entrée
// n'invalide plus le plan : ce n'est plus la cible du trade.
bool contTargetFirst = confirmed and contRequireLiq and contStage == 2 and bar_index > contPoiBar and not contEntryTouch and not na(contLiquidity) and (contDir == 1 ? high >= contLiquidity : low <= contLiquidity)
bool contEntryStopAmbiguous = confirmed and contEntryTouch and not na(contStop) and (contDir == 1 ? low <= contStop : high >= contStop)

if confirmed and contStage == 2 and not contPlanContextValid
    contStage := 0
    contEntry := na
    contLastReject := "Plan annulé · contexte H1/H4/P-D"
    contPlanCancelled := true
if contStopFirst
    contStage := 0
    contEntry := na
    contLastReject := "Plan annulé · SL avant entrée"
    contPlanCancelled := true
if contTargetFirst
    contStage := 0
    contEntry := na
    contLastReject := "Plan annulé · cible prise avant entrée"
    contPlanCancelled := true

bool coreGoLongCandidate = confirmed and longTouch50 and longContextValid and coreBlockersOK and longOptionalOK
bool coreGoShortCandidate = confirmed and shortTouch50 and shortContextValid and coreBlockersOK and shortOptionalOK and not coreGoLongCandidate
bool altGoLongCandidateRaw = confirmed and altLongTouch and allowLongDir and coreBlockersOK
bool altGoShortCandidateRaw = confirmed and altShortTouch and allowShortDir and coreBlockersOK
// La route historique garde la priorité. Une seule route peut produire un GO.
bool altGoLongCandidate = altGoLongCandidateRaw and not coreGoLongCandidate and not coreGoShortCandidate
bool altGoShortCandidate = altGoShortCandidateRaw and not coreGoLongCandidate and not coreGoShortCandidate and not altGoLongCandidate
bool contLimitsOK = coreBlockersOK and contSignalsToday < contMaxTrades
bool contGoLongCandidate = confirmed and contStage == 2 and contDir == 1 and contEntryTouch and contPlanContextValid and contLimitsOK
bool contGoShortCandidate = confirmed and contStage == 2 and contDir == -1 and contEntryTouch and contPlanContextValid and contLimitsOK
bool anyReversalGoCandidate = coreGoLongCandidate or coreGoShortCandidate or altGoLongCandidate or altGoShortCandidate
bool oppositeEngineConflict = ((coreGoLongCandidate or altGoLongCandidate) and contGoShortCandidate) or ((coreGoShortCandidate or altGoShortCandidate) and contGoLongCandidate)
bool anyCoreGoCandidate = anyReversalGoCandidate
bool anyContGoCandidate = contGoLongCandidate or contGoShortCandidate

// Même direction sur la même clôture : priorité au Reversal. Directions
// opposées : aucun ordre n'est autorisé et les deux plans sont invalidés.
goLong = coreGoLongCandidate and not oppositeEngineConflict
goShort = coreGoShortCandidate and not oppositeEngineConflict
altGoLong = altGoLongCandidate and not oppositeEngineConflict
altGoShort = altGoShortCandidate and not oppositeEngineConflict
contGoLong = contGoLongCandidate and not anyCoreGoCandidate and not oppositeEngineConflict
contGoShort = contGoShortCandidate and not anyCoreGoCandidate and not oppositeEngineConflict
// [Entrée directe] Route entièrement indépendante : ne participe pas à
// l'arbitrage Reversal/ALT/Continuation ci-dessus (oppositeEngineConflict,
// anyCoreGoCandidate...), pour ne rien changer au comportement existant.
directGoLong = newLongDirectPlan
directGoShort = newShortDirectPlan
go = goLong or goShort or altGoLong or altGoShort or contGoLong or contGoShort or directGoLong or directGoShort

if oppositeEngineConflict
    lStage := 0
    sStage := 0
    lLimit := na
    sLimit := na
    contStage := 0
    contEntry := na
    if (newLongPlan or newShortPlan) and array.size(stageLabels) > 0
        label.delete(array.pop(stageLabels))
    newLongPlan := false
    newShortPlan := false
    contPlanCancelled := true
    lastRejectReason := "Conflit Reversal / Continuation"
    contLastReject := "Conflit directionnel entre moteurs"
if anyCoreGoCandidate and anyContGoCandidate and not oppositeEngineConflict
    contStage := 0
    contEntry := na
    contPlanCancelled := true
    contLastReject := "Même signal · priorité Reversal"

if goLong
    strictSignalsToday += 1
    lStage := 4
    sStage := 0
    if contStage >= 1 and contStage <= 2
        contStage := 0
        contEntry := na
    if showStageLabels and not showEntryBar
        f_pushStageLabel(stageLabels, bar_index, low, "GO LONG", label.style_label_up, color.new(#26a69a, 0), color.white, size.small, false)
    altLStage := 0
    altLStartBar := na
    altLLimit := na
if goShort
    strictSignalsToday += 1
    sStage := 4
    lStage := 0
    if contStage >= 1 and contStage <= 2
        contStage := 0
        contEntry := na
    if showStageLabels and not showEntryBar
        f_pushStageLabel(stageLabels, bar_index, high, "GO SHORT", label.style_label_down, color.new(#ef5350, 0), color.white, size.small, false)
    altSStage := 0
    altSStartBar := na
    altSLimit := na
if altGoLong
    strictSignalsToday += 1
    altLStage := 3
    lStage := 0
    sStage := 0
    lLimit := na
    sLimit := na
    if contStage >= 1 and contStage <= 2
        contStage := 0
        contEntry := na
    if showStageLabels and not showEntryBar
        f_pushStageLabel(stageLabels, bar_index, low, "GO ALT LONG · " + altLGrade + " " + str.tostring(altLScore) + "pt", label.style_label_up, color.new(#7e57c2, 0), color.white, size.small, false)
if altGoShort
    strictSignalsToday += 1
    altSStage := 3
    lStage := 0
    sStage := 0
    lLimit := na
    sLimit := na
    if contStage >= 1 and contStage <= 2
        contStage := 0
        contEntry := na
    if showStageLabels and not showEntryBar
        f_pushStageLabel(stageLabels, bar_index, high, "GO ALT SHORT · " + altSGrade + " " + str.tostring(altSScore) + "pt", label.style_label_down, color.new(#7e57c2, 0), color.white, size.small, false)
if contGoLong
    strictSignalsToday += 1
    contSignalsToday += 1
    contStage := 3
    lStage := 0
    sStage := 0
    lLimit := na
    sLimit := na
    if contShowLabels and not showEntryBar
        f_pushStageLabel(contStageLabels, bar_index, low, "GO CONT LONG", label.style_none, color.new(#26a69a, 100), #26a69a, size.small, false)
if contGoShort
    strictSignalsToday += 1
    contSignalsToday += 1
    contStage := 3
    lStage := 0
    sStage := 0
    lLimit := na
    sLimit := na
    if contShowLabels and not showEntryBar
        f_pushStageLabel(contStageLabels, bar_index, high, "GO CONT SHORT", label.style_none, color.new(#ef5350, 100), #ef5350, size.small, false)

// L'entrée est dessinée sur la bougie exacte qui a validé le retour/toucher.
// Une seule route peut gagner pour REV/ALT/CONT ; la route OR reste indépendante.
if showEntryBar
    if goLong and not na(lLimit)
        f_markEntry(lLimit, true, "REV")
    if goShort and not na(sLimit)
        f_markEntry(sLimit, false, "REV")
    if altGoLong and not na(altLLimit)
        f_markEntry(altLLimit, true, "ALT " + altLGrade)
    if altGoShort and not na(altSLimit)
        f_markEntry(altSLimit, false, "ALT " + altSGrade)
    if contGoLong and not na(contEntry)
        f_markEntry(contEntry, true, "CONT")
    if contGoShort and not na(contEntry)
        f_markEntry(contEntry, false, "CONT")
    if orFvgGoLong and not na(orFvgEntry)
        f_markEntry(orFvgEntry, true, "OR-FVG")
    if orFvgGoShort and not na(orFvgEntry)
        f_markEntry(orFvgEntry, false, "OR-FVG")

// =============================================================================
//  PLAN, RISQUE ET NIVEAUX VISUELS
// =============================================================================
hasLongPlan = lStage >= 3 and not na(lLimit)
hasShortPlan = sStage >= 3 and not na(sLimit)
hasContPlan = contStage >= 2 and not na(contEntry)
reversalActivePlanDir = hasLongPlan and (not hasShortPlan or bias == 1) ? 1 : hasShortPlan ? -1 : 0
int reversalActivePlanBar = reversalActivePlanDir == 1 ? lPoiBar : reversalActivePlanDir == -1 ? sPoiBar : na
activeIsContinuation = hasContPlan and (reversalActivePlanDir == 0 or nz(contPoiBar, -1) >= nz(reversalActivePlanBar, -1))
activePlanDir = activeIsContinuation ? contDir : reversalActivePlanDir
autoEntryPx = activeIsContinuation ? contEntry : reversalActivePlanDir == 1 ? lLimit : reversalActivePlanDir == -1 ? sLimit : na
autoSlPx = activeIsContinuation ? contStop : reversalActivePlanDir == 1 ? lStop : reversalActivePlanDir == -1 ? sStop : na
autoTp1Px = activeIsContinuation ? contTp1 : reversalActivePlanDir == 1 ? lTp1 : reversalActivePlanDir == -1 ? sTp1 : na
autoTp2Px = activeIsContinuation ? contTp2 : reversalActivePlanDir == 1 ? lTp2 : reversalActivePlanDir == -1 ? sTp2 : na
autoTp3Px = activeIsContinuation ? contLiquidity : reversalActivePlanDir == 1 ? lLiquidity : reversalActivePlanDir == -1 ? sLiquidity : na
activeEngineStr = activeIsContinuation ? "CONT" : reversalActivePlanDir != 0 ? "REV" : "–"

activeEntryPx = useAutoPlan ? autoEntryPx : entryPx
activeSlPx = useAutoPlan ? autoSlPx : slPx
activeTp1Px = useAutoPlan ? autoTp1Px : tp1Px
activeTp2Px = useAutoPlan ? autoTp2Px : tp2Px
activeTp3Px = useAutoPlan ? autoTp3Px : tp3Px
riskDist = (not na(activeEntryPx) and not na(activeSlPx) and activeEntryPx > 0 and activeSlPx > 0) ? math.abs(activeEntryPx - activeSlPx) : na
riskTicks = not na(riskDist) ? riskDist / syminfo.mintick : na
riskAmt = capital * riskPct / 100.0
posSize = (not na(riskTicks) and riskTicks > 0 and tickValue > 0) ? riskAmt / (riskTicks * tickValue) : na
rr1 = (not na(riskDist) and riskDist > 0 and not na(activeTp1Px) and activeTp1Px > 0) ? math.abs(activeTp1Px - activeEntryPx) / riskDist : na
rr2 = (not na(riskDist) and riskDist > 0 and not na(activeTp2Px) and activeTp2Px > 0) ? math.abs(activeTp2Px - activeEntryPx) / riskDist : na
rrEff = not na(rr2) ? rr2 : rr1
activeRequiredRR = activeIsContinuation ? contMinRR : minRR
rrOK = not na(rrEff) and rrEff >= activeRequiredRR
setupDefined = not na(activeEntryPx) and not na(activeSlPx) and not na(activeTp1Px)

// Les routes ALT peuvent préparer simultanément deux plans et un plan REV.
// Une seule série de niveaux est lisible à la fois : priorité au plan REV/CONT,
// sinon au plan ALT le plus récent. L'arbitrage des entrées reste inchangé.
bool altOnlyDisplay = not hasLongPlan and not hasShortPlan and not hasContPlan and useAutoPlan
bool altLongPlanVisible = altOnlyDisplay and altLStage == 2 and not na(altLLimit) and (altSStage != 2 or nz(altLPoiBar, -1) >= nz(altSPoiBar, -1))
bool altShortPlanVisible = altOnlyDisplay and altSStage == 2 and not na(altSLimit) and not altLongPlanVisible
string activeGrade = reversalActivePlanDir == 1 ? lGrade : reversalActivePlanDir == -1 ? sGrade : ""
string activeEntryTxt = activeIsContinuation ? "CONT ENTRY" : "REV ENTRY " + poiEntryMode + (activeGrade == "" or activeGrade == "–" ? "" : " · " + activeGrade)

// Tous les libellés partent à droite de la dernière bougie, restent au prix
// réel du niveau et s'espacent horizontalement, même si ENTRY/SL/TP sont proches.
bool useAltLongLevels = showTrade and altLongPlanVisible
bool useAltShortLevels = showTrade and altShortPlanVisible
bool useMainLevels = showTrade and not (altLongPlanVisible or altShortPlanVisible)
f_hline(useAltLongLevels, altLLimit, color.new(#7e57c2, 0), "ALT L ENTRY · " + altLGrade, line.style_solid, 0)
f_hline(useAltLongLevels, altLStop, color.new(#ef5350, 0), "ALT L SL", line.style_solid, 1)
f_hline(useAltLongLevels, altLTp1, color.new(#ff9800, 0), "ALT L TP1", line.style_dashed, 2)
f_hline(useAltLongLevels, altLTp2, color.new(#26a69a, 0), "ALT L TP2", line.style_dashed, 3)
f_hline(useAltShortLevels, altSLimit, color.new(#7e57c2, 0), "ALT S ENTRY · " + altSGrade, line.style_solid, 0)
f_hline(useAltShortLevels, altSStop, color.new(#ef5350, 0), "ALT S SL", line.style_solid, 1)
f_hline(useAltShortLevels, altSTp1, color.new(#ff9800, 0), "ALT S TP1", line.style_dashed, 2)
f_hline(useAltShortLevels, altSTp2, color.new(#26a69a, 0), "ALT S TP2", line.style_dashed, 3)

f_hline(useMainLevels, activeEntryPx, color.new(#2962ff, 0), activeEntryTxt, line.style_solid, 0)
f_hline(useMainLevels, activeSlPx,    color.new(#ef5350, 0), activeIsContinuation ? "CONT SL" : "REV SL", line.style_solid, 1)
f_hline(useMainLevels, activeTp1Px,   color.new(#ff9800, 0), "TP1", line.style_dashed, 2)
f_hline(useMainLevels, activeTp2Px,   color.new(#26a69a, 0), "TP2", line.style_dashed, 3)
f_hline(useMainLevels, activeTp3Px,   color.new(#ab47bc, 0), "LIQ", line.style_dotted, 4)

// [Entrée directe] Bloc additif : affichage des niveaux de la route directe,
// indépendant des groupes REV/ALT ci-dessus (slots 5-8 / 9-12 pour ne
// jamais partager la position horizontale des textes avec useMainLevels /
// useAltLongLevels / useAltShortLevels). Reste visible pendant `lineExt`
// bougies après le déclenchement (même réglage que l'extension des autres
// lignes), puis disparaît de lui-même.
bool useDirectLongLevels = showTrade and not na(lDirectEntry) and (bar_index - lDirectBar <= lineExt)
bool useDirectShortLevels = showTrade and not na(sDirectEntry) and (bar_index - sDirectBar <= lineExt)
f_hline(useDirectLongLevels, lDirectEntry, color.new(#00bfa5, 0), "DIRECT L ENTRY", line.style_solid, 5)
f_hline(useDirectLongLevels, lDirectStop, color.new(#ef5350, 0), "DIRECT L SL", line.style_solid, 6)
f_hline(useDirectLongLevels, lDirectTp1, color.new(#ff9800, 0), "DIRECT L TP1", line.style_dashed, 7)
f_hline(useDirectLongLevels, lDirectTp2, color.new(#26a69a, 0), "DIRECT L TP2", line.style_dashed, 8)
f_hline(useDirectShortLevels, sDirectEntry, color.new(#d500f9, 0), "DIRECT S ENTRY", line.style_solid, 9)
f_hline(useDirectShortLevels, sDirectStop, color.new(#ef5350, 0), "DIRECT S SL", line.style_solid, 10)
f_hline(useDirectShortLevels, sDirectTp1, color.new(#ff9800, 0), "DIRECT S TP1", line.style_dashed, 11)
f_hline(useDirectShortLevels, sDirectTp2, color.new(#26a69a, 0), "DIRECT S TP2", line.style_dashed, 12)

bgcolor(sessOK ? color.new(#2962ff, 93) : inFlatCore ? color.new(#ef5350, 94) : na, title = "Fenêtre d'entrée / clôture")
plotshape(goLong, title = "GO LONG strict", style = shape.triangleup, location = location.belowbar, color = color.new(#26a69a, 0), size = size.small, text = "GO")
plotshape(goShort, title = "GO SHORT strict", style = shape.triangledown, location = location.abovebar, color = color.new(#ef5350, 0), size = size.small, text = "GO")
plotshape(directGoLong, title = "GO LONG direct", style = shape.triangleup, location = location.belowbar, color = color.new(#00bfa5, 0), size = size.small, text = "GO-D")
plotshape(directGoShort, title = "GO SHORT direct", style = shape.triangledown, location = location.abovebar, color = color.new(#d500f9, 0), size = size.small, text = "GO-D")
plotshape(altGoLong and (showAltMarkers or not showEntryBar), title = "GO LONG route additive", style = shape.triangleup, location = location.belowbar, color = color.new(#7e57c2, 0), size = size.small, text = "ALT")
plotshape(altGoShort and (showAltMarkers or not showEntryBar), title = "GO SHORT route additive", style = shape.triangledown, location = location.abovebar, color = color.new(#7e57c2, 0), size = size.small, text = "ALT")
plotshape(contGoLong, title = "GO LONG Continuation", style = shape.triangleup, location = location.belowbar, color = color.new(#00acc1, 0), size = size.small, text = "CONT")
plotshape(contGoShort, title = "GO SHORT Continuation", style = shape.triangledown, location = location.abovebar, color = color.new(#ff7043, 0), size = size.small, text = "CONT")

// =============================================================================
//  ÉTAT PROFESSIONNEL DE LA SÉQUENCE
// =============================================================================
activeStage = reversalActivePlanDir == 1 ? lStage : reversalActivePlanDir == -1 ? sStage : bias == 1 ? lStage : bias == -1 ? sStage : math.max(lStage, sStage)
activeSweepSource = reversalActivePlanDir == 1 ? lSweepSource : reversalActivePlanDir == -1 ? sSweepSource : bias == 1 ? lSweepSource : bias == -1 ? sSweepSource : lStage >= sStage ? lSweepSource : sSweepSource
activePoiName = reversalActivePlanDir == 1 ? lPoiName : reversalActivePlanDir == -1 ? sPoiName : "–"
coreDisplayDir = reversalActivePlanDir != 0 ? reversalActivePlanDir : bias
optionalCount = reversalActivePlanDir == 1 ? longOptionalCount : reversalActivePlanDir == -1 ? shortOptionalCount : bias == 1 ? longOptionalCount : shortOptionalCount
optionalOK = reversalActivePlanDir == 1 ? longOptionalOK : reversalActivePlanDir == -1 ? shortOptionalOK : bias == 1 ? longOptionalOK : shortOptionalOK
sweepCoreOK = activeStage >= 1
cisdCoreOK = activeStage >= 2
poiCoreOK = activeStage >= 3
returnCoreOK = activeStage == 4
pdPlanOK = activePlanDir == 1 ? autoEntryPx <= h1Mid : activePlanDir == -1 ? autoEntryPx >= h1Mid : false
liquidityOK = activePlanDir != 0 and not na(autoTp3Px)
stageStr = activeStage == 4 ? "Déclenché" : activeStage == 3 ? "Plan prêt · attente 50%" : activeStage == 2 ? "Attente POI" : activeStage == 1 ? "Attente CISD" : "Attente sweep"
bool contContextAny = bias == 1 ? contLongContext : bias == -1 ? contShortContext : false
bool contDirectionH4OK = bias == 1 ? contH4LongOK : bias == -1 ? contH4ShortOK : false
string contDirStr = contDir == 1 ? "Long" : contDir == -1 ? "Short" : bias == 1 ? "Long" : bias == -1 ? "Short" : "–"
string contStageStr = not contEnabled ? "Désactivé" : contStage == 3 ? "Signal déjà donné" : contStage == 2 ? "Plan prêt · attente 50%" : contStage == 1 ? "Attente FVG frais" : contContextAny ? "Attente cassure M5" : "Contexte bloqué"
string altStageStr = altLStage == 3 ? "GO Long donné" : altSStage == 3 ? "GO Short donné" : altLStage == 2 ? "Plan Long prêt" : altSStage == 2 ? "Plan Short prêt" : altLStage == 1 ? "Long attente POI" : altSStage == 1 ? "Short attente POI" : not na(altLStartBar) or not na(altSStartBar) ? "Collecte 2/3" : "Attente"
string verdictStr = contGoLong ? "GO CONT LONG" : contGoShort ? "GO CONT SHORT" : goLong ? "GO REV LONG" : goShort ? "GO REV SHORT" : altGoLong ? "GO ALT LONG · " + altLGrade : altGoShort ? "GO ALT SHORT · " + altSGrade : contStage == 3 ? "SIGNAL CONT DÉJÀ DONNÉ" : activeStage == 4 ? "SIGNAL REV DÉJÀ DONNÉ" : altLStage == 3 or altSStage == 3 ? "SIGNAL ALT DÉJÀ DONNÉ" : contStage == 2 ? "PLAN CONT PRÊT" : activeStage == 3 ? "PLAN REV PRÊT" : altLStage == 2 or altSStage == 2 ? "PLAN ALT PRÊT" : contStage == 1 ? "CONT · ATTENTE FVG" : activeStage == 2 ? "REV · ATTENTE POI" : activeStage == 1 ? "REV · ATTENTE CISD" : altLStage == 1 or altSStage == 1 ? "ALT · ATTENTE POI" : contContextAny ? "CONT · ATTENTE CASSURE M5" : "NO SETUP"
string sweepWaitingDetail = sweepDiagnosticRecent ? lastSweepDiagnostic : enabledSweepSources
string nyClockStr = f_two(hour(time, sessTz)) + ":" + f_two(minute(time, sessTz))
string sessionPhaseStr = inFlatCore ? "Clôture" : sessOK ? "Entrée active" : inSequence ? "Séq. active" : inSweepCapture ? "Capture sweep" : "Hors capture"
string sessionDetailStr = "NY " + nyClockStr + " · " + sessionPhaseStr
bool h1ContextOK = h1RangeAligned and bias != 0 and bias == h1DealingDir
blockersOK = coreBlockersOK and optionalOK and sessOK and h1ContextOK and h4VetoOK
string blockersStr = ""
blockersStr += tfOK ? "" : "TF≠M5 "
blockersStr += sessOK ? "" : "Session "
blockersStr += not h1RangeReady ? "Range H1 absente " : not h1BosRangeReady ? "BOS H1 non confirmé " : not h1ContextOK ? "Biais/cassure H1 non alignés " : ""
blockersStr += h4VetoOK ? "" : "Veto H4 "
blockersStr += newsOK ? "" : "News "
blockersStr += tradesOK ? "" : "MaxTrades "
blockersStr += riskLimitsOK ? "" : "Drawdown "
blockersStr += optionalOK ? "" : "Confluences "
blockersStr := blockersStr == "" ? "Aucun" : blockersStr
// Les blocages actuels ont priorité sur un ancien rejet ou diagnostic de sweep.
string dashboardBlockers = not blockersOK ? blockersStr : lastRejectReason != "" and activeStage == 0 ? "Dernier rejet · " + lastRejectReason : activeStage == 0 and sweepDiagnosticRecent ? lastSweepDiagnostic : blockersStr
bool contBlockersOK = contEnabled and tfOK and inContSession and contContextAny and contDirectionH4OK and newsOK and tradesOK and riskLimitsOK and contSignalsToday < contMaxTrades
string contBlockersStr = ""
contBlockersStr += contEnabled ? "" : "Désactivé "
contBlockersStr += tfOK ? "" : "TF≠M5 "
contBlockersStr += inContSession ? "" : "Hors session CONT "
contBlockersStr += h1RangeAligned and bias != 0 and bias == h1DealingDir ? "" : "H1 non aligné "
contBlockersStr += contDirectionH4OK ? "" : "H4 opposé/absent "
contBlockersStr += newsOK ? "" : "News "
contBlockersStr += tradesOK and contSignalsToday < contMaxTrades ? "" : "MaxTrades "
contBlockersStr += riskLimitsOK ? "" : "Drawdown "
contBlockersStr := contBlockersStr == "" ? "Aucun" : contBlockersStr
string overallBlockers = contStage == 3 ? "Continuation · signal donné" : activeIsContinuation or contStage > 0 ? (contBlockersOK ? (contLastReject == "" ? "Aucun" : "Dernier rejet · " + contLastReject) : contBlockersStr) : activeStage > 0 ? dashboardBlockers : "REV · " + dashboardBlockers + " | CONT · " + (contLastReject != "" ? contLastReject : contBlockersStr)
bool overallProgress = activeStage > 0 or contStage > 0 or contContextAny
bool dashboardContFocus = activeIsContinuation or contStage > 0 or (activeStage == 0 and contContextAny)
float dashboardRequiredRR = dashboardContFocus ? contMinRR : minRR

// =============================================================================
//  TABLEAU DE BORD
// =============================================================================
okC   = color.new(#26a69a, 0)
failC = color.new(#ef5350, 0)
waitC = color.new(#ff9800, 0)
infoC = color.new(#9e9e9e, 0)
bgC   = dashBg

f_row(_t, _r, _name, _state, _detail) =>
    txtSz = f_size(dashSize)
    stCol = _state == 1 ? okC : _state == 0 ? failC : infoC
    stSym = _state == 1 ? "✓" : _state == 0 ? "✗" : "•"
    table.cell(_t, 0, _r, _name, text_color = dashTxt, text_size = txtSz, text_halign = text.align_left, bgcolor = bgC)
    table.cell(_t, 1, _r, stSym, text_color = stCol, text_size = txtSz, bgcolor = bgC)
    table.cell(_t, 2, _r, _detail, text_color = dashTxt, text_size = txtSz, text_halign = text.align_left, bgcolor = bgC)

var table dash = na
if showDash and barstate.islast
    if na(dash)
        dash := table.new(f_pos(dashPos), 3, 23, border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
    txtSz = f_size(dashSize)
    table.cell(dash, 0, 0, "ICT · V2.7.8 CLEAR PLAN", text_color = dashTxt, text_size = txtSz, text_halign = text.align_left, bgcolor = dashHdr)
    table.cell(dash, 1, 0, "St", text_color = dashTxt, text_size = txtSz, bgcolor = dashHdr)
    table.cell(dash, 2, 0, str.tostring(optionalCount) + "/4 opt.", text_color = dashTxt, text_size = txtSz, text_halign = text.align_left, bgcolor = dashHdr)
    f_row(dash, 1,  "1· Marché / TF",       tfOK ? 1 : 0, syminfo.ticker + " " + timeframe.period)
    f_row(dash, 2,  "2· Biais structure H1", bias != 0 ? 1 : 0, biasStr)
    f_row(dash, 3,  "3· Contexte H4",       (h4VetoOK and (not contEnabled or contDirectionH4OK)) ? 1 : 0, "REV " + (useH4Veto ? (h4Bias == 1 ? "Bull" : h4Bias == -1 ? "Bear" : "Neutre") : "off") + " · CONT " + (not contEnabled ? "off" : contDirectionH4OK ? (h4Bias == 1 ? "Bull" : h4Bias == -1 ? "Bear" : "Neutre") : "bloqué"))
    f_row(dash, 4,  "4· Range structure H1", h1RangeAligned ? 1 : h1RangeReady ? -1 : 0, h1RangeReady ? f_px(h1RangeLow) + " – " + f_px(h1RangeHigh) + " · " + h1RangeSourceStr + (h1RangeSource == 1 and not h1RangeAligned ? " · attente alignement" : "") : "En attente des pivots H1")
    f_row(dash, 5,  "5· Premium/Discount",  activePlanDir == 0 ? -1 : pdPlanOK ? 1 : 0, activePlanDir == 0 ? zoneStr : activePlanDir == 1 ? "Entrée en Discount" : "Entrée en Premium")
    f_row(dash, 6,  "6· Moteurs",            (activeStage > 0 or contStage > 0 or altLStage > 0 or altSStage > 0) ? 1 : -1, "REV " + stageStr + " · ALT " + altStageStr + " · CONT " + contStageStr)
    f_row(dash, 7,  dashboardContFocus ? "7· CONT contexte" : "7· REV sweep", dashboardContFocus ? (contContextAny ? 1 : 0) : (sweepCoreOK ? 1 : 0), dashboardContFocus ? contDirStr + " · " + (contDirectionH4OK ? "H1/H4 OK" : "H4 bloquant") : sweepCoreOK ? activeSweepSource : sweepWaitingDetail)
    f_row(dash, 8,  dashboardContFocus ? "8· CONT cassure" : "8· REV CISD", dashboardContFocus ? (contStage >= 1 ? 1 : -1) : (cisdCoreOK ? 1 : 0), dashboardContFocus ? (contStage >= 1 ? contBreakKind + " · " + f_px(contBreakLevel) : "Attente pivot + clôture") : cisdCoreOK ? (coreDisplayDir == 1 ? "Haussier après sweep" : coreDisplayDir == -1 ? "Baissier après sweep" : "Direction non validée") : "En attente")
    f_row(dash, 9,  dashboardContFocus ? "9· CONT FVG frais" : "9· REV POI", dashboardContFocus ? (contStage >= 2 ? 1 : contStage == 1 ? -1 : 0) : (poiCoreOK ? 1 : 0), dashboardContFocus ? (contStage >= 2 ? "FVG @50% · " + f_px(contEntry) : contStage == 1 ? "Attente FVG frais" : "Pas de plan") : poiCoreOK ? activePoiName : poiMode)
    f_row(dash, 10, dashboardContFocus ? "10· CONT retour 50%" : "10· REV retour 50%", dashboardContFocus ? (contStage == 3 ? 1 : contStage == 2 ? -1 : 0) : (returnCoreOK ? 1 : poiCoreOK ? -1 : 0), dashboardContFocus ? (contStage == 3 ? "Touché" : contStage == 2 ? "Ordre limite en attente" : "Pas de plan") : returnCoreOK ? "Touché" : poiCoreOK ? "Ordre limite en attente" : "Pas de plan")
    f_row(dash, 11, "11· Liquidité ≥ " + str.tostring(dashboardRequiredRR, "#.#") + "R", liquidityOK ? 1 : activePlanDir == 0 ? -1 : 0, liquidityOK ? f_px(autoTp3Px) : "–")
    f_row(dash, 12, "12· EMA200 (option)",  dashboardContFocus ? -1 : nearEma ? 1 : -1, dashboardContFocus ? "Non requise CONT" : nearEma ? "Proche" : "Non requise")
    f_row(dash, 13, "13· SMT (option)",     dashboardContFocus ? -1 : (coreDisplayDir == 1 ? longSmtOK : shortSmtOK) ? 1 : -1, dashboardContFocus ? "Non requis CONT" : smtManual ? "Manuel OK" : smtStatus)
    f_row(dash, 14, "14· Vol/HTF (option)", dashboardContFocus ? -1 : (volOK or htfPoiContext) ? 1 : -1, dashboardContFocus ? "Non requis CONT" : (volOK ? "Volume " : "") + (htfPoiContext ? "HTF POI" : volOK ? "" : "Non requis"))
    f_row(dash, 15, "15· Session",          (sessOK or inContSession) ? 1 : inSweepCapture ? -1 : 0, sessionDetailStr + (contEnabled ? (inContSession ? " · CONT active" : " · CONT fermée") : ""))
    f_row(dash, 16, "16· News / limites",   (newsOK and riskLimitsOK) ? 1 : 0, (newsOK ? "News OK" : "STOP news") + " · J " + str.tostring(dailyLossPct, "#.#") + "% / DD " + str.tostring(totalDdPct, "#.#") + "%")
    // [V2.5.11] Entrée, SL et TP ne sont plus dans le tableau : ils restent
    // tracés sur le graphique. Les trois lignes servent maintenant à la notation.
    string activeGrade = hasLongPlan and activePlanDir == 1 ? lGrade : hasShortPlan and activePlanDir == -1 ? sGrade : "–"
    int gradeState = activeGrade == "A+" ? 1 : activeGrade == "–" ? -1 : 0
    f_row(dash, 17, "17· NOTE DU SETUP",    gradeState, activeGrade + (activeGrade == "A+" ? " · sweep en zone" : activeGrade == "A" ? " · sweep hors zone" : activeGrade == "C" ? " · biais H1 contraire" : "aucun plan"))
    f_row(dash, 18, "18· Composition",      setupDefined ? 1 : -1, (activePlanDir == 1 ? (lSweepPdAligned ? "PD✓ " : "PD✗ ") + (lSmtAtSweep ? "SMT✓ " : "") + (lMssSeen ? "MSS✓ " : "") : activePlanDir == -1 ? (sSweepPdAligned ? "PD✓ " : "PD✗ ") + (sSmtAtSweep ? "SMT✓ " : "") + (sMssSeen ? "MSS✓ " : "") : "–") + (setupDefined ? "· " + (na(posSize) ? "" : str.tostring(posSize, "#.##") + " lots") : ""))
    f_row(dash, 19, "19· RR / moteur",      setupDefined ? 1 : -1, (na(rrEff) ? "–" : str.tostring(rrEff, "#.##") + " R") + " · " + activeEngineStr + " · total " + str.tostring(tradesUsed) + "/" + str.tostring(maxTrades))
    vBg = go ? color.new(#26a69a, 0) : (activeStage == 3 or contStage == 2) ? color.new(#2962ff, 10) : overallProgress ? color.new(#ff9800, 10) : color.new(#ef5350, 0)
    table.cell(dash, 0, 20, "20· VERDICT", text_color = color.white, text_size = txtSz, text_halign = text.align_left, bgcolor = vBg)
    table.cell(dash, 1, 20, go ? "✓" : overallProgress ? "…" : "✗", text_color = color.white, text_size = txtSz, bgcolor = vBg)
    table.cell(dash, 2, 20, verdictStr, text_color = color.white, text_size = txtSz, text_halign = text.align_left, bgcolor = vBg)
    table.cell(dash, 0, 21, "Blocages actuels", text_color = dashTxt, text_size = txtSz, text_halign = text.align_left, bgcolor = bgC)
    table.cell(dash, 1, 21, (blockersOK or contBlockersOK) ? "✓" : "✗", text_color = (blockersOK or contBlockersOK) ? okC : failC, text_size = txtSz, bgcolor = bgC)
    table.cell(dash, 2, 21, overallBlockers, text_color = dashTxt, text_size = txtSz, text_halign = text.align_left, bgcolor = bgC)
    // [V2.5.8-FIX] Diagnostic du filtre Premium/Discount de la Continuation.
    // Il compte les setups que la zone aurait écartés aujourd'hui, que le filtre
    // soit actif ou non : c'est la seule façon de savoir ce qu'il coûte avant
    // de l'activer.
    color pdBg = contRequirePD ? (contPdBlockedToday > 0 ? color.new(#ef5350, 55) : bgC) : bgC
    table.cell(dash, 0, 22, "P/D Continuation", text_color = dashTxt, text_size = txtSz, text_halign = text.align_left, bgcolor = pdBg)
    table.cell(dash, 1, 22, contRequirePD ? "ON" : "off", text_color = contRequirePD ? failC : dashTxt, text_size = txtSz, bgcolor = pdBg)
    table.cell(dash, 2, 22, str.tostring(contPdBlockedToday) + " setup(s) hors zone aujourd'hui" + (contRequirePD ? " · REJETÉS" : " · acceptés (filtre off)"), text_color = dashTxt, text_size = txtSz, text_halign = text.align_left, bgcolor = pdBg)

// =============================================================================
//  ALERTES
// =============================================================================
alertcondition(sweepBuyEvt,  title = "Sweep pivot visuel buy-side",  message = "ICT : sweep pivot visuel buy-side sur {{ticker}} {{interval}}")
alertcondition(sweepSellEvt, title = "Sweep pivot visuel sell-side", message = "ICT : sweep pivot visuel sell-side sur {{ticker}} {{interval}}")
alertcondition(strictBuySideSweep, title = "Sweep externe buy-side", message = "ICT V2.5.10 : sweep externe haut Standard NY sur {{ticker}} {{interval}}")
alertcondition(strictSellSideSweep, title = "Sweep externe sell-side", message = "ICT V2.5.10 : sweep externe bas Standard NY sur {{ticker}} {{interval}}")
alertcondition(ifvgEvt, title = "Inversion FVG visuelle", message = "ICT : IFVG visuel sur {{ticker}} {{interval}}")
alertcondition(longCisdAdvanced, title = "CISD strict haussier après sweep", message = "ICT V2.5.10 : CISD haussier accepté après sweep sur {{ticker}} {{interval}}")
alertcondition(shortCisdAdvanced, title = "CISD strict baissier après sweep", message = "ICT V2.5.10 : CISD baissier accepté après sweep sur {{ticker}} {{interval}}")
alertcondition(newLongPlan, title = "Plan LONG prêt", message = "ICT strict : plan LONG prêt, attente du retour 50% sur {{ticker}} {{interval}}")
alertcondition(newShortPlan, title = "Plan SHORT prêt", message = "ICT strict : plan SHORT prêt, attente du retour 50% sur {{ticker}} {{interval}}")
alertcondition(bosBullEvt, title = "BOS H1 haussier", message = "ICT : BOS H1 haussier sur {{ticker}} {{interval}}")
alertcondition(bosBearEvt, title = "BOS H1 baissier", message = "ICT : BOS H1 baissier sur {{ticker}} {{interval}}")
alertcondition(mssBullEvt, title = "MSS visuel haussier", message = "ICT : MSS/CHOCH visuel haussier sur {{ticker}} {{interval}}")
alertcondition(mssBearEvt, title = "MSS visuel baissier", message = "ICT : MSS/CHOCH visuel baissier sur {{ticker}} {{interval}}")
alertcondition(goLong, title = "GO LONG Reversal", message = "Checklist V2.5.10 : GO LONG Reversal sur {{ticker}} {{interval}}")
alertcondition(goShort, title = "GO SHORT Reversal", message = "Checklist V2.5.10 : GO SHORT Reversal sur {{ticker}} {{interval}}")
alertcondition(directGoLong, title = "GO LONG direct (sweep+CISD+FVG/IFVG)", message = "Entrée directe LONG (sweep+CISD+FVG/IFVG, sans retracement) sur {{ticker}} {{interval}}")
alertcondition(directGoShort, title = "GO SHORT direct (sweep+CISD+FVG/IFVG)", message = "Entrée directe SHORT (sweep+CISD+FVG/IFVG, sans retracement) sur {{ticker}} {{interval}}")
alertcondition(altGoLong, title = "GO LONG Route additive", message = "ICT V2.6.0 : GO LONG route SMT/CISD/MSS sur {{ticker}} {{interval}}")
alertcondition(altGoShort, title = "GO SHORT Route additive", message = "ICT V2.6.0 : GO SHORT route SMT/CISD/MSS sur {{ticker}} {{interval}}")
alertcondition(contNewBreak, title = "Continuation · cassure M5", message = "Checklist V2.5.10 : cassure M5 de continuation, attente FVG frais sur {{ticker}} {{interval}}")
alertcondition(contNewPlan, title = "Continuation · plan prêt", message = "Checklist V2.5.10 : plan Continuation prêt, attente retour 50 % FVG sur {{ticker}} {{interval}}")
alertcondition(contGoLong, title = "GO LONG Continuation", message = "Checklist V2.5.10 : GO LONG Continuation sur {{ticker}} {{interval}}")
alertcondition(contGoShort, title = "GO SHORT Continuation", message = "Checklist V2.5.10 : GO SHORT Continuation sur {{ticker}} {{interval}}")
alertcondition(contPlanCancelled, title = "Continuation · plan annulé", message = "Checklist V2.5.10 : plan Continuation annulé sur {{ticker}} {{interval}}")
alertcondition(contEntryStopAmbiguous, title = "Continuation · entrée/SL même M5", message = "Checklist V2.5.10 : entrée et SL touchés sur la même bougie M5 ; vérifier le chemin M1 sur {{ticker}}")
alertcondition(inFlatCore and not inFlatCore[1], title = "Clôture forcée NY", message = "Checklist V2.5.10 : annuler les plans et clôturer à 15:55 NY sur {{ticker}}")
alertcondition(not sessOK, title = "Hors fenêtre d'entrée", message = "Checklist V2.5.10 : hors fenêtre d'entrée sur {{ticker}}")
