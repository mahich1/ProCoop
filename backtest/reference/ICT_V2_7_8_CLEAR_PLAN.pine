altShowLabels = input.bool(false, "Afficher les étapes ALT sur le graphique", group = gAlt, tooltip = "Les confirmations intermédiaires ALT restent visibles dans le tableau. Activez cette option pour afficher aussi leurs textes sur les bougies.")
